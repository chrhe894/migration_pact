' ============================================================================
' Diagram: Ansvarsbedömning — begreppsöversikt
'
' Syfte: Förklarande bild som visar roller, tidsfrister och konsekvenser
'        vid ansvarsbestämning. Inte bara processen utan även vad som
'        händer om saker går fel.
'
' Källa: AMMR artiklarna 24, 38–46
'
' Relaterade regler:
'   RULE-AMMR-024-001, RULE-AMMR-024-002, RULE-AMMR-038-001,
'   RULE-AMMR-040-001, RULE-AMMR-043-001, RULE-AMMR-045-001,
'   RULE-AMMR-046-001
'
' Status: Draft
' ============================================================================

@startuml responsibility-overview

title Ansvarsbedömning — roller, tidsfrister och konsekvenser

skinparam shadowing false
skinparam HyperlinkColor Black
skinparam HyperlinkUnderline true
skinparam defaultFontName Arial
skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #333333
}
skinparam note {
  BackgroundColor #FFF7D6
  BorderColor #7A6A2A
}

start

partition "Fastställande stat" {
  :Ansökan registreras;
  note right
    [[../rules/rule-ammr-024-002.md RULE-AMMR-024-002]]
    Situationen vid registrering
    avgör ansvar (fryspunkt).
    Senare förändringar spelar
    normalt ingen roll.
  end note

  :[[../rules/rule-ammr-024-001.md Tillämpa kriterierna i rangordning]];
  note right
    [[../rules/rule-ammr-024-001.md RULE-AMMR-024-001]]
    Kriterierna tillämpas i den
    ordning de anges
  end note

  if (Ansvarig stat = fastställande stat?) then (Ja)
    :Prövar ansökan själv;
    stop
  else (Nej)
    :Identifierar annan stat som ansvarig;
  endif
}

partition "Framställan om övertagande" {
  :[[../rules/rule-ammr-038-001.md Skicka framställan]];
  note right
    [[../rules/rule-ammr-038-001.md RULE-AMMR-038-001]]
    **2 månader** från registrering
    **1 månad** vid Eurodac-träff
    ([[../articles/ammr-038.md ART-AMMR-038]])
    ---
    Missad frist = fastställande
    stat blir ansvarig
  end note
}

partition "Anmodad stat" {
  :[[../rules/rule-ammr-040-001.md Svarar på framställan]];
  note right
    [[../rules/rule-ammr-040-001.md RULE-AMMR-040-001]]
    **1 månad** (2 veckor vid Eurodac)
    ([[../articles/ammr-040.md ART-AMMR-040]])
    ---
    Inget svar = tyst godkännande
    (skyldighet att överta)
  end note

  if (Godtar?) then (Ja)
    :Bekräftar ansvar;
  else (Nej — med underbyggda skäl)
    :Avvisad framställan;
    :Fastställande stat omprövar
    eller blir ansvarig;
    stop
  endif
}

partition "Överföringsbeslut" {
  :Fastställande stat fattar
  överföringsbeslut (2 veckor);

  :Sökanden underrättas;
  note right
    [[../rules/rule-ammr-043-001.md RULE-AMMR-043-001]]
    Rätt till överklagande
    ---
    Kan begära suspensiv verkan.
    Om beviljad: överföringsfristen
    fryser.
  end note
}

partition "Överföring" {
  :[[../rules/rule-ammr-045-001.md Verkställ överföring]];
  note right
    [[../rules/rule-ammr-045-001.md RULE-AMMR-045-001]]
    Normalt: **6 månader**
    Förvar: **4 veckor** (5 veckor art. 45)
    Avvikande: **18 månader**
    ([[../articles/ammr-045.md ART-AMMR-045]])
  end note

  if (Överföring genomförd i tid?) then (Ja)
    :Person överförs till ansvarig stat;
    :Ansvarig stat prövar ansökan;
  else (Nej)
    :Ansvaret övergår till
    den fastställande/överförande staten;
    note right
      [[../rules/rule-ammr-046-001.md RULE-AMMR-046-001]]
      Systemets "sanktion" — om man
      inte överför i tid
      får man ansvaret själv.
    end note
  endif
}

stop

@enduml
