' ============================================================================
' Diagram: Ansvarets livscykel
'
' Syfte: Visar hela livscykeln för en stats ansvar — från fastställande
'        till upphörande — med alla vägar som leder till att ansvar
'        uppstår, övergår eller upphör.
'
' Källa: AMMR artiklarna 24, 33, 35, 36, 37, 46
'
' Relaterade regler:
'   RULE-AMMR-024-001, RULE-AMMR-035-001, RULE-AMMR-036-001,
'   RULE-AMMR-046-001
'
' Status: Draft
' ============================================================================

@startuml responsibility-lifecycle

title Ansvarets livscykel

skinparam shadowing false
skinparam HyperlinkColor Black
skinparam HyperlinkUnderline true
skinparam defaultFontName Arial
skinparam note {
  BackgroundColor #FFF7D6
  BorderColor #7A6A2A
}

start

partition "**Ansvar uppstår** — en av följande vägar" {
  :Ansvar fastställs;
  note right
    == Vägar till ansvar ==
    **1. Kriterierna** →
    ([[../rules/rule-ammr-024-001.md RULE-AMMR-024-001]])
    ---
    **2. Tidsfrist missad** →
    Framställan ej skickad i tid (2 mån)
    = fastställande stat blir ansvarig
    ([[../articles/ammr-038.md ART-AMMR-038]])
    ---
    **3. Tyst godkännande** →
    Anmodad stat svarade ej i tid (1 mån)
    ([[../articles/ammr-040.md ART-AMMR-040]])
    ---
    **4. Diskretionär** →
    Stat väljer att överta
    ([[../rules/rule-ammr-035-001.md RULE-AMMR-035-001]])
    ---
    **5. Ej överförd i tid** →
    6-månadersfristen missad
    ([[../rules/rule-ammr-046-001.md RULE-AMMR-046-001]])
  end note
}

:Stat är ansvarig;

partition "**Ansvar pågår**" {
  :[[../rules/rule-ammr-036-001.md Skyldig att pröva / slutföra\nprövning]];
  note right
    [[../rules/rule-ammr-036-001.md RULE-AMMR-036-001]]
    Skyldig att återta person
    som dyker upp i annan stat
    ([[../articles/ammr-036.md ART-AMMR-036]])
  end note
}

partition "**Ansvar upphör** — en av följande vägar" {
  :Ansvar upphör;
  note right
    == Vägar till upphörande ==
    **1. Uppehållshandling** →
    Annan stat utfärdar uppehållshandling
    ([[../articles/ammr-037.md ART-AMMR-037]])
    ---
    **2. Lämnat EU 9 mån** →
    Personen bevisligen utanför EU
    ---
    **3. Avlägsnande verkställt** →
    Personen lämnat EU efter avslag
    ---
    **4. 15 mån efter gränsförfarande** →
    Slutligt avslagsbeslut i gränsförfarande
    ---
    **5. Ej överförd** →
    Överförande stat missade frist →
    ansvaret övergick dit
    ([[../rules/rule-ammr-046-001.md RULE-AMMR-046-001]])
    ---
    **6. Ny ansökan** →
    Ny ansökan efter upphörandeperiod →
    nytt förfarande inleds
  end note
}

stop

@enduml
