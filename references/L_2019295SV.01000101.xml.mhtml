" cellpadding=3D"0">
                           <colgroup><col width=3D"4%">
                           <col width=3D"96%">
                           </colgroup><tbody>
                              <tr>
                                 <td valign=3D"top">
                                    <p class=3D"oj-normal">f)</p>
                                 </td>
                                 <td valign=3D"top">
                                    <p class=3D"oj-normal">Delegera sina be=
fogenheter till andra medlemmar ur den ordinarie personalen enligt best=C3=
=A4mmelser som ska antas i enlighet med artikel 100.2 o.</p>
                                 </td>
                              </tr>
                           </tbody>
                        </table>
