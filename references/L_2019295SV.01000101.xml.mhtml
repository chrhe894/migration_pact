" cellpadding=3D"0">
                           <colgroup><col width=3D"4%">
                           <col width=3D"96%">
                           </colgroup><tbody>
                              <tr>
                                 <td valign=3D"top">
                                    <p class=3D"oj-normal">q)</p>
                                 </td>
                                 <td valign=3D"top">
                                    <p class=3D"oj-normal">Utse chefer f=C3=
=B6r lokalkontoren i enlighet med artikel 60.4.</p>
                                 </td>
                              </tr>
                           </tbody>
                        </table>
                        <table width=3D"100%" border=3D"0" cellspacing=3D"0=
" cellpadding=3D"0">
                           <colgroup><col width=3D"4%">
                           <col width=3D"96%">
                           </colgroup><tbody>
                              <tr>
                                 <td valign=3D"top">
                                    <p class=3D"oj-normal">r)</p>
                                 </td>
                                 <td valign=3D"top">
                                    <p class=3D"oj-normal">Utarbeta en =C3=
=A5tg=C3=A4rdsplan p=C3=A5 grundval av slutsatserna fr=C3=A5n interna eller=
 externa revisionsrapporter och utv=C3=A4rderingar, liksom unders=C3=B6knin=
gar utf=C3=B6rda av Olaf, samt ge en l=C3=A4gesrapport till kommissionen tv=
=C3=A5 g=C3=A5nger om =C3=A5ret och till styrelsen regelbundet.</p>
                                 </td>
                              </tr>
                           </tbody>
                        </table>
