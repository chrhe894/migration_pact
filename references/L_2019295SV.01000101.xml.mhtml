               <p id=3D"d1e1245-1-1" class=3D"oj-ti-section-1">KAPITEL I</p=
>
               <div class=3D"eli-title" id=3D"cpt_I.tit_1">
                  <p id=3D"L_2019295SV.01000101-d-001" class=3D"oj-ti-secti=
on-2">
                     <span class=3D"oj-bold">DEN EUROPEISKA GR=C3=84NS- OCH=
 KUSTBEVAKNINGEN</span>
                  </p>
