                                    <p class=3D"oj-normal">c)</p>
                                 </td>
                                 <td valign=3D"top">
                                    <p class=3D"oj-normal">N=C3=A4r det =C3=
=A4r n=C3=B6dv=C3=A4ndigt f=C3=B6r att utarbeta riskanalyser.</p>
                                 </td>
                              </tr>
                           </tbody>
                        </table>
