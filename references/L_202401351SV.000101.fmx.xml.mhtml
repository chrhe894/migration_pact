                                 <td valign=3D"top">
                                    <p class=3D"oj-normal">a)</p>
                                 </td>
                                 <td valign=3D"top">
                                    <p class=3D"oj-normal">syftena med denn=
a f=C3=B6rordning,</p>
                                 </td>
