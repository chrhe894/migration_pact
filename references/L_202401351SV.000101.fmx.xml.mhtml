padding=3D"0">
                     <colgroup><col width=3D"4%">
                     <col width=3D"96%">
                     </colgroup><tbody>
                        <tr>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">20.</p>
                           </td>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">
                                 <span class=3D"oj-italic">bidragande medle=
msstat</span>: en medlemsstat som l=C3=A4mnar eller =C3=A4r skyldig att l=
=C3=A4mna solidaritetsbidrag till en gynnad medlemsstat enligt del&nbsp;IV =
i&nbsp;denna f=C3=B6rordning.</p>
                           </td>
                        </tr>
                     </tbody>
                  </table>
                  <table width=3D"100%" border=3D"0" cellspacing=3D"0" cell=
padding=3D"0">
                     <colgroup><col width=3D"4%">
                     <col width=3D"96%">
                     </colgroup><tbody>
                        <tr>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">21.</p>
                           </td>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">
                                 <span class=3D"oj-italic">=C3=B6verf=C3=B6=
ring</span>: genomf=C3=B6rande av ett beslut som fattats enligt artikel&nbs=
p;42.</p>
                           </td>
                        </tr>
                     </tbody>
                  </table>
                  <table width=3D"100%" border=3D"0" cellspacing=3D"0" cell=
padding=3D"0">
                     <colgroup><col width=3D"4%">
                     <col width=3D"96%">
                     </colgroup><tbody>
                        <tr>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">22.</p>
                           </td>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">
                                 <span class=3D"oj-italic">omf=C3=B6rdelnin=
g</span>: =C3=B6verf=C3=B6ring av en s=C3=B6kande eller en person som bevil=
jats internationellt skydd fr=C3=A5n en gynnad medlemsstats territorium til=
l en bidragande medlemsstats territorium.</p>
                           </td>
                        </tr>
                     </tbody>
                  </table>
                  <table width=3D"100%" border=3D"0" cellspacing=3D"0" cell=
padding=3D"0">
                     <colgroup><col width=3D"4%">
                     <col width=3D"96%">
                     </colgroup><tbody>
                        <tr>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">23.</p>
                           </td>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">
                                 <span class=3D"oj-italic">s=C3=B6k- och r=
=C3=A4ddningsinsatser</span>: s=C3=B6k- och r=C3=A4ddningsinsatser i&nbsp;d=
en mening som avses i&nbsp;1979 =C3=A5rs internationella sj=C3=B6r=C3=A4ddn=
ingskonvention, som antogs i&nbsp;Hamburg den 27&nbsp;april 1979.</p>
                           </td>
                        </tr>
                     </tbody>
                  </table>
                  <table width=3D"100%" border=3D"0" cellspacing=3D"0" cell=
padding=3D"0">
                     <colgroup><col width=3D"4%">
                     <col width=3D"96%">
                     </colgroup><tbody>
                        <tr>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">24.</p>
                           </td>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">
                                 <span class=3D"oj-italic">migrationstryck<=
/span>: en situation som uppst=C3=A5r till f=C3=B6ljd av att tredjelandsmed=
borgare eller statsl=C3=B6sa personer anl=C3=A4nder landv=C3=A4gen, sj=C3=
=B6v=C3=A4gen eller luftv=C3=A4gen, eller l=C3=A4mnar in ans=C3=B6kningar, =
i&nbsp;en s=C3=A5dan omfattning att det ger upphov till oproportionerliga s=
kyldigheter f=C3=B6r en medlemsstat, med beaktande av den =C3=B6vergripande=
 situationen i&nbsp;unionen, =C3=A4ven f=C3=B6r ett v=C3=A4l f=C3=B6rberett=
 asyl-, mottagnings- och migrationssystem, och kr=C3=A4ver omedelbara =C3=
=A5tg=C3=A4rder, i&nbsp;synnerhet solidaritetsbidrag enligt del&nbsp;IV i&n=
bsp;denna f=C3=B6rordning; med beaktande av s=C3=A4rdragen f=C3=B6r en medl=
emsstats geografiska l=C3=A4ge omfattar migrationstryck situationer med ett=
 stort antal anl=C3=A4ndande tredjelandsmedborgare eller statsl=C3=B6sa per=
soner eller med en risk f=C3=B6r s=C3=A5dana ankomster =C3=A4ven n=C3=A4r s=
=C3=A5dana ankomster beror p=C3=A5 =C3=A5terkommande lands=C3=A4ttningar ef=
ter s=C3=B6k- och r=C3=A4ddningsinsatser eller p=C3=A5 tredjelandsmedborgar=
es eller statsl=C3=B6sa personers otill=C3=A5tna f=C3=B6rflyttningar mellan=
 medlemsstaterna.</p>
                           </td>
                        </tr>
                     </tbody>
                  </table>
                  <table width=3D"100%" border=3D"0" cellspacing=3D"0" cell=
padding=3D"0">
                     <colgroup><col width=3D"4%">
                     <col width=3D"96%">
                     </colgroup><tbody>
                        <tr>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">25.</p>
                           </td>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">
                                 <span class=3D"oj-italic">betydande migrat=
ionssituation</span>: en situation som skiljer sig fr=C3=A5n migrationstryc=
k och d=C3=A4r den kumulativa effekten av tredjelandsmedborgares eller stat=
sl=C3=B6sa personers aktuella och tidigare =C3=A5rliga ankomster leder till=
 att ett v=C3=A4l f=C3=B6rberett asyl-, mottagnings- och migrationssystem n=
=C3=A5r gr=C3=A4nsen f=C3=B6r sin kapacitet.</p>
                           </td>
                        </tr>
                     </tbody>
                  </table>
                  <table width=3D"100%" border=3D"0" cellspacing=3D"0" cell=
padding=3D"0">
                     <colgroup><col width=3D"4%">
                     <col width=3D"96%">
                     </colgroup><tbody>
                        <tr>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">26.</p>
                           </td>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">
                                 <span class=3D"oj-italic">mottagningsvillk=
or</span>: mottagningsvillkor enligt definitionen i&nbsp;artikel&nbsp;2.6 i=
&nbsp;direktiv (EU) 2024/1346.</p>
                           </td>
                        </tr>
                     </tbody>
                  </table>
                  <table width=3D"100%" border=3D"0" cellspacing=3D"0" cell=
padding=3D"0">
                     <colgroup><col width=3D"4%">
                     <col width=3D"96%">
                     </colgroup><tbody>
                        <tr>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">27.</p>
                           </td>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">
                                 <span class=3D"oj-italic">person som bevil=
jats inresa</span>: en person vars inresa och vistelse har godtagits av en =
medlemsstat enligt f=C3=B6rordning (EU) 2024/1350 eller enligt ett nationel=
lt vidarebos=C3=A4ttningsprogram utanf=C3=B6r ramen f=C3=B6r den f=C3=B6ror=
dningen.</p>
                           </td>
                        </tr>
                     </tbody>
                  </table>
