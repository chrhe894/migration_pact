                              <tr>
                                 <td valign=3D"top">
                                    <p class=3D"oj-normal">k)</p>
                                 </td>
                                 <td valign=3D"top">
                                    <p class=3D"oj-normal">Omfattningen av =
och trenderna f=C3=B6r tredjelandsmedborgares eller statsl=C3=B6sa personer=
s otill=C3=A5tna f=C3=B6rflyttningar mellan medlemsstaterna p=C3=A5 grundva=
l av tillg=C3=A4nglig information fr=C3=A5n ber=C3=B6rda unionsorgan och un=
ionsbyr=C3=A5er och dataanalyser fr=C3=A5n relevanta informationssystem.</p=
>
                                 </td>
                              </tr>
