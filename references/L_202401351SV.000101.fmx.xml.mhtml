" cellpadding=3D"0">
                           <colgroup><col width=3D"4%">
                           <col width=3D"96%">
                           </colgroup><tbody>
                              <tr>
                                 <td valign=3D"top">
                                    <p class=3D"oj-normal">d)</p>
                                 </td>
                                 <td valign=3D"top">
                                    <p class=3D"oj-normal">minska den utsat=
thet som orsakas av smuggling av migranter och m=C3=A4nniskohandel och fr=
=C3=A4mja program f=C3=B6r bek=C3=A4mpning av m=C3=A4nniskosmuggling och m=
=C3=A4nniskohandel,</p>
                                 </td>
                              </tr>
                           </tbody>
