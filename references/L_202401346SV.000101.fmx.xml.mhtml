ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(5)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Mottagningsvillkoren fort=
s=C3=A4tter att variera avsev=C3=A4rt mellan medlemsstaterna, s=C3=A4rskilt=
 med avseende p=C3=A5 den mottagningsstandard som tillhandah=C3=A5lls s=C3=
=B6kande. Mer harmoniserade mottagningsvillkor som fastst=C3=A4lls p=C3=A5 =
l=C3=A4mplig niv=C3=A5 i&nbsp;alla medlemsstater kommer att bidra till en m=
er likv=C3=A4rdig behandling och en mer r=C3=A4ttvis f=C3=B6rdelning av s=
=C3=B6kande i&nbsp;unionen.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_6">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(6)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">De medel som avdelas f=C3=
=B6r Asyl-, migrations- och integrationsfonden, som inr=C3=A4ttats genom Eu=
ropaparlamentets och r=C3=A5dets f=C3=B6rordning (EU) 2021/1147&nbsp;<a id=
=3D"ntc6-L_202401346SV.000101-E0006" href=3D"https://eur-lex.europa.eu/lega=
l-content/SV/TXT/HTML/?uri=3DOJ:L_202401346#ntr6-L_202401346SV.000101-E0006=
">(<span class=3D"oj-super oj-note-tag">6</span>)</a>, samt f=C3=B6r asylby=
r=C3=A5n b=C3=B6r anv=C3=A4ndas som adekvat st=C3=B6d f=C3=B6r medlemsstate=
rna n=C3=A4r de genomf=C3=B6r de mottagningsvillkor som fastst=C3=A4lls i&n=
bsp;detta direktiv, inbegripet f=C3=B6r medlemsstater vars asylsystem uts=
=C3=A4tts f=C3=B6r ett s=C3=A4rskilt och oproportionellt h=C3=A5rt tryck, f=
r=C3=A4mst p=C3=A5 grund av deras geografiska l=C3=A4ge eller demografiska =
situation.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_7">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(7)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">F=C3=B6r att s=C3=A4kerst=
=C3=A4lla att s=C3=B6kande behandlas lika i&nbsp;hela unionen b=C3=B6r dett=
a direktiv vara till=C3=A4mpligt under alla stadier och p=C3=A5 alla typer =
av f=C3=B6rfaranden f=C3=B6r internationellt skydd, p=C3=A5 alla platser oc=
h anl=C3=A4ggningar d=C3=A4r s=C3=B6kande inkvarteras och s=C3=A5 l=C3=A4ng=
e som de f=C3=A5r uppeh=C3=A5lla sig p=C3=A5 medlemsstaternas territorium i=
&nbsp;egenskap av s=C3=B6kande. Det =C3=A4r n=C3=B6dv=C3=A4ndigt att klarg=
=C3=B6ra att materiella mottagningsvillkor b=C3=B6r finnas tillg=C3=A4nglig=
a f=C3=B6r s=C3=B6kande fr=C3=A5n det att de uttrycker sin vilja att ans=C3=
=B6ka om internationellt skydd till tj=C3=A4nstem=C3=A4n vid de beh=C3=B6ri=
ga myndigheterna i&nbsp;enlighet med Europaparlamentets och r=C3=A5dets f=
=C3=B6rordning (EU) 2024/1348&nbsp;<a id=3D"ntc7-L_202401346SV.000101-E0007=
" href=3D"https://eur-lex.europa.eu/legal-content/SV/TXT/HTML/?uri=3DOJ:L_2=
02401346#ntr7-L_202401346SV.000101-E0007">(<span class=3D"oj-super oj-note-=
tag">7</span>)</a>.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_8">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(8)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">En dagers=C3=A4ttning b=
=C3=B6r tillhandah=C3=A5llas s=C3=B6kande som en del av de materiella motta=
gningsvillkoren, s=C3=A5 att s=C3=B6kandena kan =C3=A5tnjuta ett minimum av=
 sj=C3=A4lvst=C3=A4ndighet i&nbsp;sina dagliga liv. Det b=C3=B6r vara m=C3=
=B6jligt att tillhandah=C3=A5lla dagers=C3=A4ttningen som ett penningbelopp=
, i&nbsp;form av kuponger, in natura, t.ex. i&nbsp;form av produkter, eller=
 som en kombination av dessa, f=C3=B6rutsatt att s=C3=A5dan ers=C3=A4ttning=
 inbegriper ett penningbelopp.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_9">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(9)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Om en s=C3=B6kande befinn=
er sig i&nbsp;en annan medlemsstat =C3=A4n den d=C3=A4r han eller hon =C3=
=A4r skyldig att uppeh=C3=A5lla sig i&nbsp;enlighet med Europaparlamentets =
och r=C3=A5dets f=C3=B6rordning (EU) 2024/1351&nbsp;<a id=3D"ntc8-L_2024013=
46SV.000101-E0008" href=3D"https://eur-lex.europa.eu/legal-content/SV/TXT/H=
TML/?uri=3DOJ:L_202401346#ntr8-L_202401346SV.000101-E0008">(<span class=3D"=
oj-super oj-note-tag">8</span>)</a>, b=C3=B6r s=C3=B6kanden inte vara ber=
=C3=A4ttigad till materiella mottagningsvillkor, tilltr=C3=A4de till arbets=
marknaden, spr=C3=A5kkurser eller yrkesutbildning i&nbsp;enlighet med detta=
 direktiv, fr=C3=A5n den tidpunkt d=C3=A5 s=C3=B6kanden underr=C3=A4ttas om=
 ett beslut att =C3=B6verf=C3=B6ra honom eller henne till den ansvariga med=
lemsstaten. S=C3=A5vida inte ett separat beslut med denna inneb=C3=B6rd har=
 utf=C3=A4rdats b=C3=B6r det i&nbsp;=C3=B6verf=C3=B6ringsbeslutet framg=C3=
=A5 att de relevanta mottagningsvillkoren har dragits in. Medlemsstaterna b=
=C3=B6r dock under alla omst=C3=A4ndigheter s=C3=A4kerst=C3=A4lla tilltr=C3=
=A4de f=C3=B6r s=C3=B6kande till h=C3=A4lso- och sjukv=C3=A5rd och en levna=
dsstandard som =C3=B6verensst=C3=A4mmer med unionsr=C3=A4tten, inbegripet E=
uropeiska unionens stadga om de grundl=C3=A4ggande r=C3=A4ttigheterna (<spa=
n class=3D"oj-italic">stadgan</span>), och andra internationella skyldighet=
er.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_10">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(10)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">N=C3=A4r det g=C3=A4ller =
behandlingen av personer som omfattas av till=C3=A4mpningsomr=C3=A5det f=C3=
=B6r detta direktiv =C3=A4r medlemsstaterna bundna av sina f=C3=B6rpliktels=
er enligt de internationella r=C3=A4ttsliga instrument som de =C3=A4r parte=
r i.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_11">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(11)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Det b=C3=B6r fastst=C3=A4=
llas standardvillkor f=C3=B6r mottagande av s=C3=B6kande som =C3=A4r tillr=
=C3=A4ckliga f=C3=B6r att ge dem en tillr=C3=A4cklig levnadsstandard och j=
=C3=A4mf=C3=B6rbara levnadsvillkor i&nbsp;alla medlemsstater. En harmoniser=
ing av mottagningsvillkoren f=C3=B6r s=C3=B6kande b=C3=B6r bidra till att b=
egr=C3=A4nsa s=C3=B6kandes sekund=C3=A4ra f=C3=B6rflyttningar p=C3=A5 grund=
 av att mottagningsvillkoren skiljer sig =C3=A5t.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_12">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(12)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">F=C3=B6r att s=C3=A4kerst=
=C3=A4lla att s=C3=B6kande =C3=A4r inf=C3=B6rst=C3=A5dda med sina r=C3=A4tt=
igheter och skyldigheter b=C3=B6r medlemsstaterna ge dem information skrift=
ligen, eller, n=C3=A4r s=C3=A5 =C3=A4r l=C3=A4mpligt, muntligen, eller, n=
=C3=A4r s=C3=A5 =C3=A4r l=C3=A4mpligt i&nbsp;visuell form, om mottagningsvi=
llkoren enligt detta direktiv. S=C3=A5dan information b=C3=B6r ges s=C3=A5 =
snart som m=C3=B6jligt och i&nbsp;god tid, och b=C3=B6r omfatta de mottagni=
ngsvillkor som s=C3=B6kande, inbegripet s=C3=B6kande med s=C3=A4rskilda mot=
tagandebehov, har r=C3=A4tt till, r=C3=A4ttigheter och skyldigheter i&nbsp;=
fr=C3=A5ga om anst=C3=A4llning, under vilka f=C3=B6rh=C3=A5llanden som bevi=
ljandet av materiella mottagningsvillkor kan komma att inskr=C3=A4nkas till=
 ett geografiskt omr=C3=A5de eller begr=C3=A4nsas till en specifik plats sa=
mt f=C3=B6ljderna av att inte r=C3=A4tta sig efter s=C3=A5dana inskr=C3=A4n=
kningar eller begr=C3=A4nsningar och av att avvika, liksom situationer d=C3=
=A4r det =C3=A4r m=C3=B6jligt att besluta om f=C3=B6rvar, m=C3=B6jligheter =
till =C3=B6verklagande och pr=C3=B6vning och m=C3=B6jligheter till tillhand=
ah=C3=A5llande av r=C3=A4ttsligt bist=C3=A5nd och bitr=C3=A4de. Medlemsstat=
erna b=C3=B6r i&nbsp;synnerhet informera s=C3=B6kande om de mottagningsvill=
kor som de inte har r=C3=A4tt till i&nbsp;en annan medlemsstat =C3=A4n den =
d=C3=A4r de =C3=A4r skyldiga att befinna sig. En medlemsstat b=C3=B6r inte =
l=C3=A4ngre vara skyldig att tillhandah=C3=A5lla den informationen om den i=
nte l=C3=A4ngre =C3=A4r n=C3=B6dv=C3=A4ndig f=C3=B6r att i&nbsp;praktiken g=
=C3=B6ra det m=C3=B6jligt f=C3=B6r s=C3=B6kanden att =C3=A5tnjuta de r=C3=
=A4ttigheter och fullg=C3=B6ra de skyldigheter som anges i&nbsp;detta direk=
tiv, eller om s=C3=B6kanden inte =C3=A4r tillg=C3=A4nglig f=C3=B6r de beh=
=C3=B6riga myndigheterna eller har avvikit fr=C3=A5n den medlemsstatens ter=
ritorium. Asylbyr=C3=A5n b=C3=B6r utarbeta en mall med standardinformation =
om mottagningsvillkor som medlemsstaterna ska tillhandah=C3=A5lla s=C3=B6ka=
nde s=C3=A5 snart som m=C3=B6jligt, dock senast tre dagar efter det att ans=
=C3=B6kan gjordes eller inom tidsfristen f=C3=B6r dess registrering.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_13">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(13)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Harmoniserade unionsregle=
r om handlingar som ska utf=C3=A4rdas till s=C3=B6kande b=C3=B6r bidra till=
 att g=C3=B6ra det sv=C3=A5rare f=C3=B6r s=C3=B6kande att p=C3=A5 ett otill=
=C3=A5tet s=C3=A4tt f=C3=B6rflytta sig inom unionen. Medlemsstaterna b=C3=
=B6r f=C3=A5 f=C3=B6rse s=C3=B6kande med en resehandling endast om det uppk=
ommer vederb=C3=B6rligen motiverade allvarliga humanit=C3=A4ra sk=C3=A4l el=
ler andra tvingande sk=C3=A4l. Resehandlingars giltighet b=C3=B6r vara begr=
=C3=A4nsad till det =C3=A4ndam=C3=A5l och den varaktighet som =C3=A4r n=C3=
=B6dv=C3=A4ndig med h=C3=A4nsyn till sk=C3=A4let till att de utf=C3=A4rdas.=
 Allvarliga humanit=C3=A4ra sk=C3=A4l skulle kunna anses uppst=C3=A5 till e=
xempel om en s=C3=B6kande beh=C3=B6ver resa till en annan medlemsstat f=C3=
=B6r n=C3=B6dv=C3=A4ndig medicinsk behandling som inte =C3=A4r tillg=C3=A4n=
glig i&nbsp;den medlemsstat d=C3=A4r s=C3=B6kanden =C3=A4r skyldig att befi=
nna sig, f=C3=B6r att bes=C3=B6ka sl=C3=A4ktingar i&nbsp;vissa fall, exempe=
lvis n=C3=A4r n=C3=A4ra sl=C3=A4ktingar =C3=A4r sv=C3=A5rt sjuka eller f=C3=
=B6r att n=C3=A4rvara vid n=C3=A4ra sl=C3=A4ktingars begravningar. Andra tv=
ingande sk=C3=A4l skulle kunna vara situationer d=C3=A4r s=C3=B6kande exemp=
elvis n=C3=A4rvarar vid n=C3=A4ra sl=C3=A4ktingars br=C3=B6llop eller reser=
 f=C3=B6r att f=C3=B6lja en studieg=C3=A5ng eller med fosterfamiljer. Utf=
=C3=A4rdandet och anv=C3=A4ndningen av en s=C3=A5dan resehandling p=C3=A5ve=
rkar inte medlemsstaternas skyldigheter enligt f=C3=B6rordning (EU) 2024/13=
51. Medlemsstaterna beh=C3=A5ller r=C3=A4tten att bed=C3=B6ma s=C3=B6kandes=
 r=C3=A4tt att vistas p=C3=A5 deras territorium.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_14">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(14)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">S=C3=B6kande har inte r=
=C3=A4tt att v=C3=A4lja i&nbsp;vilken medlemsstat de ska l=C3=A4mna in ans=
=C3=B6kan. En s=C3=B6kande ska ans=C3=B6ka om internationellt skydd i&nbsp;=
enlighet med f=C3=B6rordning (EU) 2024/1351.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_15">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(15)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">S=C3=B6kande =C3=A4r skyl=
diga att finnas tillg=C3=A4ngliga f=C3=B6r medlemsstaternas beh=C3=B6riga m=
yndigheter. L=C3=A4mpliga =C3=A5tg=C3=A4rder b=C3=B6r vidtas f=C3=B6r att f=
=C3=B6rhindra att s=C3=B6kande avviker. Om en s=C3=B6kande har avvikit och =
rest till en annan medlemsstat utan tillst=C3=A5nd, =C3=A4r det av st=C3=B6=
rsta vikt f=C3=B6r att s=C3=A4kerst=C3=A4lla ett v=C3=A4l fungerande gemens=
amt europeiskt asylsystem att s=C3=B6kanden snabbt =C3=B6verf=C3=B6rs till =
den medlemsstat i&nbsp;vilken han eller hon =C3=A4r skyldig att befinna sig=
. Fram till dess att en s=C3=A5dan =C3=B6verf=C3=B6ring har =C3=A4gt rum fi=
nns det en risk f=C3=B6r att s=C3=B6kanden avviker, och d=C3=A4rf=C3=B6r b=
=C3=B6r det noggrant =C3=B6vervakas var han eller hon befinner sig.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_16">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(16)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Det faktum att en s=C3=B6=
kande tidigare har avvikit till en annan medlemsstat =C3=A4r en viktig fakt=
or f=C3=B6r bed=C3=B6mningen av risken f=C3=B6r att s=C3=B6kanden kan avvik=
a. Medlemsstaterna b=C3=B6r vidta l=C3=A4mpliga =C3=A5tg=C3=A4rder f=C3=B6r=
 att f=C3=B6rhindra att s=C3=B6kanden avviker igen och f=C3=B6r att s=C3=A4=
kerst=C3=A4lla att han eller hon f=C3=B6rblir tillg=C3=A4nglig f=C3=B6r de =
beh=C3=B6riga myndigheterna efter det att s=C3=B6kanden har =C3=B6verf=C3=
=B6rts till den medlemsstat d=C3=A4r han eller hon =C3=A4r skyldig att befi=
nna sig. Det b=C3=B6r d=C3=A4rf=C3=B6r fortsatt noggrant =C3=B6vervakas var=
 han eller hon befinner sig.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_17">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(17)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Medlemsstaterna b=C3=B6r =
ha r=C3=A4tt att fritt organisera sina mottagningssystem. Som en del av den=
na organisation b=C3=B6r medlemsstaterna kunna anvisa s=C3=B6kande till f=
=C3=B6rl=C3=A4ggningar inom sitt territorium i&nbsp;syfte att hantera sina =
asyl- och mottagningssystem. Medlemsstaterna b=C3=B6r ocks=C3=A5 kunna inf=
=C3=B6ra mekanismer f=C3=B6r att bed=C3=B6ma och tillgodose sina mottagning=
ssystems behov, inbegripet mekanismer f=C3=B6r kontroll av s=C3=B6kandenas =
faktiska n=C3=A4rvaro p=C3=A5 f=C3=B6rl=C3=A4ggningarna. S=C3=A5dana mekani=
smer b=C3=B6r inte inskr=C3=A4nka s=C3=B6kandenas r=C3=B6relsefrihet inom d=
en ber=C3=B6rda medlemsstatens territorium. Medlemsstaterna b=C3=B6r inte v=
ara skyldiga att fatta ett administrativt beslut f=C3=B6r det =C3=A4ndam=C3=
=A5let.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_18">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(18)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Om s=C3=B6kande kan r=C3=
=B6ra sig fritt endast inom ett begr=C3=A4nsat geografiskt omr=C3=A5de p=C3=
=A5 medlemsstaternas territorium, b=C3=B6r medlemsstaterna garantera att s=
=C3=B6kande har faktisk tillg=C3=A5ng till sina r=C3=A4ttigheter enligt det=
ta direktiv och till f=C3=B6rfarandegarantierna i&nbsp;f=C3=B6rfarandet f=
=C3=B6r internationellt skydd inom det geografiska omr=C3=A5det. M=C3=B6jli=
gheten att tillf=C3=A4lligt l=C3=A4mna det geografiska omr=C3=A5det b=C3=B6=
r bed=C3=B6mas individuellt, objektivt och opartiskt. Om s=C3=B6kande inte =
har beviljats faktisk tillg=C3=A5ng till dessa r=C3=A4ttigheter och f=C3=B6=
rfarandegarantier i&nbsp;det geografiska omr=C3=A5det b=C3=B6r anvisningen =
till det omr=C3=A5det inte l=C3=A4ngre till=C3=A4mpas.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_19">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(19)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Av h=C3=A4nsyn till allm=
=C3=A4n ordning eller f=C3=B6r att effektivt hindra s=C3=B6kanden fr=C3=A5n=
 att avvika b=C3=B6r medlemsstaterna kunna besluta att s=C3=B6kanden f=C3=
=A5r bo endast p=C3=A5 en best=C3=A4md plats, s=C3=A5som en f=C3=B6rl=C3=A4=
ggning, ett privat hus, en l=C3=A4genhet, ett hotell eller n=C3=A5gon annan=
 lokal som anpassats f=C3=B6r att inkvartera s=C3=B6kande. Ett s=C3=A5dant =
beslut b=C3=B6r inte leda till att s=C3=B6kanden h=C3=A5lls i&nbsp;f=C3=B6r=
var. Ett s=C3=A5dant beslut kan vara n=C3=B6dv=C3=A4ndigt i&nbsp;fall d=C3=
=A4r s=C3=B6kanden inte har efterlevt skyldigheten att stanna i&nbsp;den me=
dlemsstat d=C3=A4r han eller hon =C3=A4r skyldig att befinna sig, eller i&n=
bsp;fall d=C3=A4r s=C3=B6kanden har =C3=B6verf=C3=B6rts till den medlemssta=
t d=C3=A4r han eller hon =C3=A4r skyldig att befinna sig efter att ha avvik=
it till en annan medlemsstat. Om s=C3=B6kanden har r=C3=A4tt till materiell=
a mottagningsvillkor, b=C3=B6r dessa tillhandah=C3=A5llas p=C3=A5 villkor a=
tt s=C3=B6kanden =C3=A4r bosatt p=C3=A5 denna specifika plats.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_20">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(20)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Om det finns en risk f=C3=
=B6r att en s=C3=B6kande avviker, eller om det =C3=A4r n=C3=B6dv=C3=A4ndigt=
 att s=C3=A4kerst=C3=A4lla att inskr=C3=A4nkningarna av en s=C3=B6kandes r=
=C3=B6relsefrihet iakttas, kan medlemsstaterna st=C3=A4lla som krav att s=
=C3=B6kande anm=C3=A4ler sig till den beh=C3=B6riga myndigheten vid en angi=
ven tidpunkt eller med rimliga mellanrum, utan att s=C3=B6kandenas r=C3=A4t=
tigheter enligt detta direktiv p=C3=A5verkas p=C3=A5 ett oproportionerligt =
s=C3=A4tt.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_21">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(21)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Alla beslut som begr=C3=
=A4nsar s=C3=B6kandens r=C3=B6relsefrihet b=C3=B6r beakta relevanta aspekte=
r av s=C3=B6kandens individuella situation, inbegripet s=C3=A4rskilda motta=
gandebehov hos den s=C3=B6kanden samt n=C3=B6dv=C3=A4ndighets- och proporti=
onalitetsprinciperna. S=C3=B6kande b=C3=B6r vederb=C3=B6rligen informeras o=
m s=C3=A5dana beslut, om f=C3=B6rfarandena f=C3=B6r =C3=B6verklagande av de=
m och om f=C3=B6ljderna av bristande efterlevnad.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_22">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(22)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Alla best=C3=A4mmelser i&=
nbsp;detta direktiv om f=C3=B6rvar, bos=C3=A4ttning och anm=C3=A4lningsskyl=
digheter samt inskr=C3=A4nkning och indragning av r=C3=A4ttigheter eller f=
=C3=B6rm=C3=A5ner b=C3=B6r till=C3=A4mpas med vederb=C3=B6rlig h=C3=A4nsyn =
till proportionalitetsprincipen, s=C3=A5 att faktisk tillg=C3=A5ng till de =
till=C3=A4mpliga mottagningsvillkoren i&nbsp;enlighet med detta direktiv al=
ltid s=C3=A4kerst=C3=A4lls, s=C3=A4rskilt i&nbsp;fr=C3=A5ga om h=C3=A4lso- =
och sjukv=C3=A5rd, utbildning, sammanh=C3=A5llning av familjer och tilltr=
=C3=A4de till arbetsmarknaden. S=C3=A4rskild uppm=C3=A4rksamhet ska =C3=A4g=
nas =C3=A5t eventuella kumulativa effekter av =C3=A5tg=C3=A4rder.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_23">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(23)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Med h=C3=A4nsyn till de a=
llvarliga f=C3=B6ljderna f=C3=B6r s=C3=B6kande som har avvikit eller som an=
ses kunna komma att avvika, b=C3=B6r inneb=C3=B6rden av avvikande definiera=
s p=C3=A5 ett s=C3=A4tt som omfattar s=C3=A5v=C3=A4l en upps=C3=A5tlig hand=
ling som den faktiska omst=C3=A4ndighet, som inte =C3=A4r utom s=C3=B6kande=
ns kontroll, att s=C3=B6kanden inte f=C3=B6rblir tillg=C3=A4nglig f=C3=B6r =
de beh=C3=B6riga administrativa eller r=C3=A4ttsliga myndigheterna, till ex=
empel genom att l=C3=A4mna det territorium p=C3=A5 vilket s=C3=B6kanden =C3=
=A4r skyldig att befinna sig. Medlemsstaterna b=C3=B6r kunna anse att en s=
=C3=B6kande har avvikit =C3=A4ven om det tidigare inte har ansetts finnas n=
=C3=A5gon risk f=C3=B6r att s=C3=B6kanden ska avvika.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_24">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(24)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Om medlemsstaterna i&nbsp=
;sin nationella r=C3=A4tt definierar de objektiva kriterier som =C3=A4r rel=
evanta f=C3=B6r att fastst=C3=A4lla en risk f=C3=B6r avvikande enligt detta=
 direktiv, kan de beakta s=C3=A5dana faktorer som s=C3=B6kandens samarbete =
med beh=C3=B6riga myndigheter eller efterlevnad av f=C3=B6rfarandekrav, s=
=C3=B6kandens anknytning till medlemsstaten, och huruvida ans=C3=B6kan om i=
nternationellt skydd har avvisats som icke pr=C3=B6vningsbar eller avslagit=
s som uppenbart ogrundad. I&nbsp;den =C3=B6vergripande bed=C3=B6mningen av =
en s=C3=B6kandes individuella situation =C3=A4r det ofta en kombination av =
flera faktorer som ger anledning att dra slutsatsen att det finns en risk f=
=C3=B6r avvikande.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_25">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(25)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Det b=C3=B6r anses att en=
 s=C3=B6kande inte l=C3=A4ngre =C3=A4r tillg=C3=A4nglig f=C3=B6r de beh=C3=
=B6riga myndigheterna, om s=C3=B6kanden underl=C3=A5ter att besvara en beg=
=C3=A4ran som r=C3=B6r f=C3=B6rfarandena enligt f=C3=B6rordning (EU) 2024/1=
348 eller f=C3=B6rfarandet enligt f=C3=B6rordning (EU) 2024/1351, s=C3=A5vi=
da inte s=C3=B6kanden l=C3=A4mnar tillr=C3=A4ckliga sk=C3=A4l till varf=C3=
=B6r han eller hon inte kunde besvara beg=C3=A4ran, till exempel medicinska=
 eller andra ov=C3=A4ntade sk=C3=A4l som ligger utom hans eller hennes kont=
roll.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_26">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(26)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">F=C3=B6rvar av s=C3=B6kan=
de b=C3=B6r f=C3=B6lja den grundl=C3=A4ggande principen att en person inte =
f=C3=A5r h=C3=A5llas i&nbsp;f=C3=B6rvar av enbart det sk=C3=A4let att han e=
ller hon ans=C3=B6ker om internationellt skydd, s=C3=A4rskilt i&nbsp;enligh=
et med medlemsstaternas internationella r=C3=A4ttsliga skyldigheter och i&n=
bsp;synnerhet med artikel&nbsp;31 i&nbsp;Gen=C3=A8vekonventionen. Det b=C3=
=B6r vara m=C3=B6jligt att h=C3=A5lla s=C3=B6kande i&nbsp;f=C3=B6rvar endas=
t under de mycket klart definierade exceptionella omst=C3=A4ndigheter som f=
astst=C3=A4lls i&nbsp;detta direktiv och med beaktande av principerna om n=
=C3=B6dv=C3=A4ndighet och proportionalitet avseende s=C3=A5v=C3=A4l formern=
a f=C3=B6r som syftet med ett s=C3=A5dant f=C3=B6rvar. F=C3=B6rvar av s=C3=
=B6kande enligt detta direktiv b=C3=B6r endast beslutas skriftligt av r=C3=
=A4ttsliga eller administrativa myndigheter med uppgivande av de sk=C3=A4l =
som beslutet grundar sig p=C3=A5, inbegripet i&nbsp;fall d=C3=A4r den ber=
=C3=B6rda personen befinner sig i&nbsp;f=C3=B6rvar n=C3=A4r han eller hon g=
=C3=B6r en ans=C3=B6kan om internationellt skydd. En s=C3=B6kande som h=C3=
=A5lls i&nbsp;f=C3=B6rvar b=C3=B6r ha faktisk tillg=C3=A5ng till de n=C3=B6=
dv=C3=A4ndiga f=C3=B6rfarandegarantierna, s=C3=A5som r=C3=A4ttslig pr=C3=B6=
vning och r=C3=A4tt till kostnadsfritt r=C3=A4ttsligt bist=C3=A5nd och bitr=
=C3=A4de, n=C3=A4r det =C3=A4r till=C3=A4mpligt enligt detta direktiv.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_27">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(27)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">En godtagbar maximal tids=
ram f=C3=B6r r=C3=A4ttslig pr=C3=B6vning av f=C3=B6rvar b=C3=B6r fastst=C3=
=A4llas mot bakgrund av omst=C3=A4ndigheterna i&nbsp;varje enskilt fall, me=
d beaktande av f=C3=B6rfarandets komplexitet och den skyndsamhet och noggra=
nnhet som de beh=C3=B6riga myndigheterna visar, eventuella f=C3=B6rseningar=
 orsakade av den person som tagits i&nbsp;f=C3=B6rvar och alla andra faktor=
er som orsakar f=C3=B6rseningar som medlemsstaten inte kan h=C3=A5llas ansv=
arig f=C3=B6r.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_28">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(28)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Om en s=C3=B6kande har ti=
ll=C3=A5tits bo endast p=C3=A5 en best=C3=A4md plats men inte har efterlevt=
 den skyldigheten, beh=C3=B6ver det fortfarande f=C3=B6religga en risk f=C3=
=B6r att s=C3=B6kanden kan komma att avvika f=C3=B6r att denne ska kunna ta=
s i&nbsp;f=C3=B6rvar. Under alla omst=C3=A4ndigheter b=C3=B6r s=C3=A4rskild=
 omsorg =C3=A4gnas =C3=A5t att se till att l=C3=A4ngden p=C3=A5 f=C3=B6rvar=
stagandet =C3=A4r proportionellt och att =C3=A5tg=C3=A4rden upph=C3=B6r s=
=C3=A5 snart som s=C3=B6kandens skyldighet har fullgjorts eller det inte l=
=C3=A4ngre finns n=C3=A5gra sk=C3=A4l att anta att s=C3=B6kanden inte komme=
r att fullg=C3=B6ra sin skyldighet. S=C3=B6kanden b=C3=B6r ocks=C3=A5 ha gj=
orts medveten om skyldigheten i&nbsp;fr=C3=A5ga och om f=C3=B6ljderna av at=
t inte efterleva denna.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_29">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(29)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">N=C3=A4r det g=C3=A4ller =
de administrativa f=C3=B6rfaranden som avser sk=C3=A4len f=C3=B6r f=C3=B6rv=
ar inneb=C3=A4r begreppet tillb=C3=B6rlig skyndsamhet och noggrannhet =C3=
=A5tminstone en skyldighet f=C3=B6r medlemsstaterna att vidta konkreta och =
meningsfulla =C3=A5tg=C3=A4rder f=C3=B6r att se till att den tid som beh=C3=
=B6vs f=C3=B6r att kontrollera sk=C3=A4len f=C3=B6r f=C3=B6rvar blir s=C3=
=A5 kort som m=C3=B6jligt samt att det finns verkliga utsikter till att den=
na kontroll kan genomf=C3=B6ras framg=C3=A5ngsrikt p=C3=A5 kortast m=C3=B6j=
liga tid. F=C3=B6rvar b=C3=B6r inte p=C3=A5g=C3=A5 l=C3=A4ngre =C3=A4n den =
tid som rimligen beh=C3=B6vs f=C3=B6r att fullf=C3=B6lja de relevanta admin=
istrativa f=C3=B6rfarandena.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_30">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(30)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">De sk=C3=A4l f=C3=B6r f=
=C3=B6rvar som anges i&nbsp;detta direktiv p=C3=A5verkar inte andra sk=C3=
=A4l f=C3=B6r f=C3=B6rvar, d=C3=A4ribland sk=C3=A4l f=C3=B6r f=C3=B6rvar in=
om ramen f=C3=B6r straffr=C3=A4ttsliga f=C3=B6rfaranden, som =C3=A4r till=
=C3=A4mpliga enligt nationell r=C3=A4tt och som saknar samband med tredjela=
ndsmedborgarens eller den statsl=C3=B6sa personens ans=C3=B6kan om internat=
ionellt skydd.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_31">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(31)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">S=C3=B6kande som h=C3=A5l=
ls i&nbsp;f=C3=B6rvar b=C3=B6r behandlas med full respekt f=C3=B6r den m=C3=
=A4nskliga v=C3=A4rdigheten och deras mottagande b=C3=B6r utformas s=C3=A4r=
skilt f=C3=B6r att m=C3=B6ta deras behov i&nbsp;denna situation. Medlemssta=
terna b=C3=B6r s=C3=A4rskilt se till att artikel&nbsp;24 i&nbsp;stadgan och=
 artikel&nbsp;37 i&nbsp;F=C3=B6renta nationernas konvention fr=C3=A5n 1989 =
om barnets r=C3=A4ttigheter till=C3=A4mpas.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_32">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(32)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">I vissa fall kan det i&nb=
sp;praktiken vara om=C3=B6jligt att omedelbart s=C3=A4kerst=C3=A4lla vissa =
garantier i&nbsp;fr=C3=A5ga om mottagandet i&nbsp;f=C3=B6rvar, t.ex. p=C3=
=A5 grund av f=C3=B6rvarsanl=C3=A4ggningens geografiska l=C3=A4ge eller spe=
cifika struktur. Alla undantag fr=C3=A5n dessa garantier b=C3=B6r vara till=
f=C3=A4lliga och endast till=C3=A4mpas under de omst=C3=A4ndigheter som ang=
es i&nbsp;detta direktiv. Undantagen b=C3=B6r endast till=C3=A4mpas under e=
xceptionella omst=C3=A4ndigheter och b=C3=B6r vederb=C3=B6rligen motiveras =
med h=C3=A4nsyn till omst=C3=A4ndigheterna i&nbsp;det enskilda fallet, d=C3=
=A4ribland hur mycket det till=C3=A4mpade undantaget avviker fr=C3=A5n norm=
en, dess varaktighet och hur det p=C3=A5verkar s=C3=B6kanden i&nbsp;fr=C3=
=A5ga.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_33">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(33)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">F=C3=B6r att p=C3=A5 ett =
b=C3=A4ttre s=C3=A4tt s=C3=A4kerst=C3=A4lla s=C3=B6kandes fysiska och psyki=
ska integritet b=C3=B6r f=C3=B6rvar tillgripas som en sista utv=C3=A4g och =
det b=C3=B6r endast vara m=C3=B6jligt att ta s=C3=B6kande i&nbsp;f=C3=B6rva=
r efter att alla icke-frihetsber=C3=B6vande alternativa =C3=A5tg=C3=A4rder =
till f=C3=B6rvar vederb=C3=B6rligen pr=C3=B6vats. Skyldigheten att pr=C3=B6=
va dessa alternativa =C3=A5tg=C3=A4rder b=C3=B6r inte p=C3=A5verka anv=C3=
=A4ndandet av f=C3=B6rvar om s=C3=A5dana alternativa =C3=A5tg=C3=A4rder, in=
klusive bos=C3=A4ttnings- och anm=C3=A4lningsskyldigheter, inte kan till=C3=
=A4mpas i&nbsp;praktiken. I&nbsp;varje beslut om f=C3=B6rvar b=C3=B6r sk=C3=
=A4len anges till varf=C3=B6r andra, mindre ingripande alternativa =C3=A5tg=
=C3=A4rder inte kunde till=C3=A4mpas i&nbsp;praktiken. Alla alternativa =C3=
=A5tg=C3=A4rder till f=C3=B6rvar b=C3=B6r respektera s=C3=B6kandes grundl=
=C3=A4ggande m=C3=A4nskliga r=C3=A4ttigheter.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_34">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(34)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">F=C3=B6r att s=C3=A4kerst=
=C3=A4lla =C3=B6verensst=C3=A4mmelse med den f=C3=B6rfarandegaranti som g=
=C3=A4ller m=C3=B6jligheten att kontakta organisationer eller grupper av pe=
rsoner som tillhandah=C3=A5ller r=C3=A4ttsligt bist=C3=A5nd, b=C3=B6r infor=
mation ges om s=C3=A5dana organisationer och grupper av personer.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_35">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(35)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Vid beslut om inkvarterin=
g b=C3=B6r medlemsstaterna ta h=C3=A4nsyn till barnets b=C3=A4sta, liksom t=
ill s=C3=B6kandens s=C3=A4rskilda omst=C3=A4ndigheter, n=C3=A4r denne st=C3=
=A5r i&nbsp;beroendest=C3=A4llning till familjemedlemmar eller n=C3=A4ra sl=
=C3=A4ktingar, t.ex. ogifta under=C3=A5riga syskon som redan befinner sig i=
&nbsp;medlemsstaten.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_36">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(36)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Medlemsstaterna b=C3=B6r =
kunna anv=C3=A4nda sig av tillf=C3=A4lliga inkvarteringsl=C3=B6sningar av l=
=C3=A4gre standard, om de normalt tillg=C3=A4ngliga inkvarteringsm=C3=B6jli=
gheterna tillf=C3=A4lligtvis =C3=A4r utt=C3=B6mda. Medlemsstaterna b=C3=B6r=
 kunna anv=C3=A4nda sig av dessa tillf=C3=A4lliga inkvarteringsl=C3=B6sning=
ar om de normalt tillg=C3=A4ngliga inkvarteringsm=C3=B6jligheterna tillf=C3=
=A4lligtvis inte =C3=A4r tillg=C3=A4ngliga p=C3=A5 grund av ett oproportion=
erligt stort antal personer som ska inkvarteras eller p=C3=A5 grund av en k=
atastrof som orsakats av m=C3=A4nniskan eller en naturkatastrof. Medlemssta=
terna b=C3=B6r =C3=B6verv=C3=A4ga att i&nbsp;m=C3=B6jligaste m=C3=A5n tillh=
andah=C3=A5lla s=C3=A5dana tillf=C3=A4lliga inkvarteringsl=C3=B6sningar i&n=
bsp;fasta byggnadsstrukturer.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_37">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(37)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Mottagandet av personer m=
ed s=C3=A4rskilda mottagandebehov b=C3=B6r vara en fr=C3=A5ga av st=C3=B6rs=
ta vikt f=C3=B6r nationella myndigheter i&nbsp;syfte att s=C3=A4kerst=C3=A4=
lla att detta mottagande specifikt utformas f=C3=B6r att m=C3=B6ta deras s=
=C3=A4rskilda mottagandebehov. Medlemsstaterna b=C3=B6r ocks=C3=A5 i&nbsp;s=
t=C3=B6rsta m=C3=B6jliga utstr=C3=A4ckning f=C3=B6rhindra misshandel och v=
=C3=A5ld, inbegripet v=C3=A5ld med sexuella, k=C3=B6nsrelaterade, rasistisk=
a eller religi=C3=B6sa motiv, n=C3=A4r de tillhandah=C3=A5ller inkvartering=
. V=C3=A5ld med religi=C3=B6st motiv omfattar ocks=C3=A5 v=C3=A5ld riktat m=
ot personer som inte har n=C3=A5gon religi=C3=B6s =C3=B6vertygelse eller so=
m har avsagt sig sin religi=C3=B6sa tro.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_38">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(38)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Vid till=C3=A4mpningen av=
 detta direktiv b=C3=B6r medlemsstaterna str=C3=A4va efter att s=C3=A4kerst=
=C3=A4lla att principerna om barnets b=C3=A4sta och familjesammanh=C3=A5lln=
ing f=C3=B6ljs fullt ut, i&nbsp;enlighet med stadgan, 1989 =C3=A5rs FN-konv=
ention om barnets r=C3=A4ttigheter, den europeiska konventionen om skydd f=
=C3=B6r de m=C3=A4nskliga r=C3=A4ttigheterna och de grundl=C3=A4ggande frih=
eterna samt, i&nbsp;till=C3=A4mpliga fall, Europar=C3=A5dets konvention om =
f=C3=B6rebyggande och bek=C3=A4mpning av v=C3=A5ld mot kvinnor och av v=C3=
=A5ld i&nbsp;hemmet.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_39">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(39)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Mottagningsvillkoren beh=
=C3=B6ver anpassas till den s=C3=A4rskilda situationen f=C3=B6r under=C3=A5=
riga och deras s=C3=A4rskilda mottagandebehov, oavsett om de =C3=A4r ensamk=
ommande eller har anl=C3=A4nt tillsammans med sina familjer, med vederb=C3=
=B6rlig h=C3=A4nsyn till deras s=C3=A4kerhet, inbegripet s=C3=A4kerhet mot =
sexuellt och k=C3=B6nsrelaterat v=C3=A5ld, och fysiska och emotionella omv=
=C3=A5rdnad, och tillhandah=C3=A5llas p=C3=A5 ett s=C3=A4tt som fr=C3=A4mja=
r deras utveckling i&nbsp;allm=C3=A4nhet.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_40">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(40)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Under=C3=A5riga b=C3=B6r =
som regel inte h=C3=A5llas i&nbsp;f=C3=B6rvar. De b=C3=B6r placeras i&nbsp;=
l=C3=A4mplig inkvartering som utformats s=C3=A4rskilt f=C3=B6r under=C3=A5r=
iga, i&nbsp;l=C3=A4mpliga fall ocks=C3=A5 i&nbsp;icke frihetsber=C3=B6vande=
 lokalsamh=C3=A4llesbaserade boenden. Med tanke p=C3=A5 de negativa konsekv=
enserna av f=C3=B6rvar f=C3=B6r under=C3=A5riga b=C3=B6r s=C3=A5dant f=C3=
=B6rvar, i&nbsp;enlighet med unionsr=C3=A4tten, endast anv=C3=A4ndas under =
exceptionella omst=C3=A4ndigheter, n=C3=A4r det =C3=A4r absolut n=C3=B6dv=
=C3=A4ndigt, som en sista utv=C3=A4g och under kortast m=C3=B6jliga tidsper=
iod, efter det att det har fastst=C3=A4llts att andra, mindre ingripande al=
ternativa =C3=A5tg=C3=A4rder inte kan till=C3=A4mpas effektivt, och efter d=
et att f=C3=B6rvar har bed=C3=B6mts vara f=C3=B6r deras b=C3=A4sta. Under=
=C3=A5riga b=C3=B6r aldrig h=C3=A5llas i&nbsp;f=C3=B6rvar i&nbsp;f=C3=A4nge=
lse eller n=C3=A5gon annan anl=C3=A4ggning som anv=C3=A4nds f=C3=B6r brotts=
bek=C3=A4mpande =C3=A4ndam=C3=A5l. Under=C3=A5riga b=C3=B6r inte skiljas fr=
=C3=A5n sina f=C3=B6r=C3=A4ldrar eller omsorgspersoner, och principen om fa=
miljesammanh=C3=A5llning b=C3=B6r i&nbsp;allm=C3=A4nhet leda till att l=C3=
=A4mpliga alternativ till f=C3=B6rvar anv=C3=A4nds f=C3=B6r familjer med un=
der=C3=A5riga, i&nbsp;inkvartering som l=C3=A4mpar sig f=C3=B6r dem. Vidare=
 b=C3=B6r allt g=C3=B6ras f=C3=B6r att se till att ett tillr=C3=A4ckligt ur=
val av fungerande, l=C3=A4mpliga alternativ till f=C3=B6rvar av under=C3=A5=
riga st=C3=A5r till f=C3=B6rfogande och =C3=A4r tillg=C3=A4ngliga. I&nbsp;d=
etta sammanhang b=C3=B6r medlemsstaterna beakta New York-deklarationen om f=
lyktingar och migranter av den 19&nbsp;september 2016, relevant auktoritati=
v v=C3=A4gledning fr=C3=A5n FN:s konventionsorgan om 1989 =C3=A5rs FN-konve=
ntion om barnets r=C3=A4ttigheter och relevant r=C3=A4ttspraxis.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_41">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(41)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">I sitt meddelande av den =
12&nbsp;april 2017<span class=3D"oj-italic">Att skydda migrerande barn</spa=
n> understr=C3=B6k kommissionen att medlemsstaterna m=C3=A5ste inf=C3=B6ra =
l=C3=A4mpliga skydds=C3=A5tg=C3=A4rder f=C3=B6r att skydda alla migrerande =
barn som befinner sig p=C3=A5 deras territorium, inbegripet genom att anta =
=C3=A5tg=C3=A4rder f=C3=B6r att se till att barn inkvarteras i&nbsp;s=C3=A4=
kra och l=C3=A4mpliga boenden och erbjuds alla st=C3=B6dtj=C3=A4nster som b=
eh=C3=B6vs f=C3=B6r att trygga barnets b=C3=A4sta och v=C3=A4lbefinnande, i=
&nbsp;enlighet med medlemsstaternas skyldigheter enligt nationell r=C3=A4tt=
, unionsr=C3=A4tten och internationell r=C3=A4tt.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_42">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(42)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">F=C3=B6retr=C3=A4dare spe=
lar en avg=C3=B6rande roll f=C3=B6r att garantera alla ensamkommande barns =
r=C3=A4ttigheter enligt detta direktiv och f=C3=B6r att v=C3=A4rna deras in=
tressen. Det =C3=A4r viktigt att tidigt utse f=C3=B6retr=C3=A4dare f=C3=B6r=
 att hantera situationer d=C3=A4r migrerande barn f=C3=B6rsvinner i&nbsp;un=
ionen.&nbsp;Medlemsstaterna b=C3=B6r se till att f=C3=B6retr=C3=A4dare utse=
s s=C3=A5 tidigt som m=C3=B6jligt, i&nbsp;enlighet med 1989 =C3=A5rs FN-kon=
vention om barnets r=C3=A4ttigheter, f=C3=B6r att se till att ensamkommande=
 barn till fullo =C3=A5tnjuter sina r=C3=A4ttigheter enligt detta direktiv =
i&nbsp;egenskap av personer som ans=C3=B6ker om internationellt skydd.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_43">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(43)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Den huvudsakliga rollen f=
=C3=B6r en f=C3=B6retr=C3=A4dare b=C3=B6r vara att garantera barnets b=C3=
=A4sta och f=C3=B6retr=C3=A4da, bist=C3=A5 eller agera till f=C3=B6rm=C3=A5=
n f=C3=B6r ett ensamkommande barn. F=C3=B6retr=C3=A4daren b=C3=B6r vara i&n=
bsp;st=C3=A5nd att f=C3=B6rklara den information som l=C3=A4mnas till det e=
nsamkommande barnet, h=C3=A5lla i&nbsp;kontakterna med beh=C3=B6riga myndig=
heter f=C3=B6r att se till att det ensamkommande barnet f=C3=A5r omedelbar =
tillg=C3=A5ng till materiella mottagningsvillkor och h=C3=A4lso- och sjukv=
=C3=A5rd samt f=C3=B6retr=C3=A4da, bist=C3=A5 eller, i&nbsp;enlighet med na=
tionell r=C3=A4tt, agera till f=C3=B6rm=C3=A5n f=C3=B6r ett ensamkommande b=
arn f=C3=B6r att se till att barnet kan =C3=A5tnjuta r=C3=A4ttigheterna och=
 fullg=C3=B6ra skyldigheterna enligt detta direktiv. F=C3=B6retr=C3=A4dare =
b=C3=B6r utses i&nbsp;enlighet med det f=C3=B6rfarande som fastst=C3=A4lls =
i&nbsp;nationell r=C3=A4tt.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_44">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(44)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Medlemsstaterna b=C3=B6r =
utse en f=C3=B6retr=C3=A4dare, om en ans=C3=B6kan g=C3=B6rs av en person so=
m p=C3=A5st=C3=A5r sig vara under=C3=A5rig och som kommer ensam. En f=C3=B6=
retr=C3=A4dare b=C3=B6r ocks=C3=A5 utses n=C3=A4r de beh=C3=B6riga myndighe=
terna har objektiva sk=C3=A4l att anta att personen =C3=A4r under=C3=A5rig =
p=C3=A5 grund av relevanta synliga tecken, utsagor eller beteenden som tyde=
r p=C3=A5 detta. Om en medlemsstat har bed=C3=B6mt att en person som g=C3=
=B6r anspr=C3=A5k p=C3=A5 att vara under=C3=A5rig utan n=C3=A5gon som helst=
 tvekan =C3=A4r =C3=B6ver 18 =C3=A5r, beh=C3=B6ver den inte utse en f=C3=B6=
retr=C3=A4dare.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_45">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(45)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Fram till dess att en f=
=C3=B6retr=C3=A4dare har utsetts b=C3=B6r medlemsstaterna utse en person so=
m =C3=A4r l=C3=A4mpad att tillf=C3=A4lligt agera som f=C3=B6retr=C3=A4dare =
enligt detta direktiv. Den personen kan till exempel vara en anst=C3=A4lld =
vid en f=C3=B6rl=C3=A4ggning, en institution f=C3=B6r barnomsorg, socialtj=
=C3=A4nsten eller vid en annan relevant organisation som utses f=C3=B6r att=
 utf=C3=B6ra f=C3=B6retr=C3=A4darens uppgifter. Personer vars intressen st=
=C3=A5r i&nbsp;strid med, eller skulle kunna komma att st=C3=A5 i&nbsp;stri=
d med, det ensamkommande barnets intressen, b=C3=B6r inte utses som en l=C3=
=A4mplig person att tillf=C3=A4lligt agera som f=C3=B6retr=C3=A4dare. Det =
=C3=A4r ocks=C3=A5 viktigt att en s=C3=A5dan person omedelbart underr=C3=A4=
ttas n=C3=A4r en ans=C3=B6kan om internationellt skydd g=C3=B6rs av ett ens=
amkommande barn.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_46">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(46)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Medlemsstaterna b=C3=B6r =
s=C3=A4kerst=C3=A4lla att s=C3=B6kande f=C3=A5r n=C3=B6dv=C3=A4ndig h=C3=A4=
lso- och sjukv=C3=A5rd, oavsett om den tillhandah=C3=A5lls av allm=C3=A4nl=
=C3=A4kare eller, vid behov, av specialistl=C3=A4kare. Denna n=C3=B6dv=C3=
=A4ndiga h=C3=A4lso- och sjukv=C3=A5rd b=C3=B6r vara av tillfredsst=C3=A4ll=
ande kvalitet och innefatta =C3=A5tminstone akutsjukv=C3=A5rd och n=C3=B6dv=
=C3=A4ndig behandling av sjukdomar, inklusive allvarliga psykiatriska tills=
t=C3=A5nd, samt sexuell och reproduktiv h=C3=A4lso- och sjukv=C3=A5rd som =
=C3=A4r n=C3=B6dv=C3=A4ndig f=C3=B6r att behandla ett allvarligt fysiskt h=
=C3=A4lsotillst=C3=A5nd. F=C3=B6r att hantera s=C3=A5dana aspekter av folkh=
=C3=A4lsa som r=C3=B6r sjukdomsprevention och skydd av s=C3=B6kandes h=C3=
=A4lsa, b=C3=B6r s=C3=B6kandes tillg=C3=A5ng till h=C3=A4lso- och sjukv=C3=
=A5rd =C3=A4ven inbegripa preventiv medicinsk behandling, s=C3=A5som vaccin=
ationer. Medlemsstaterna b=C3=B6r ocks=C3=A5 kunna beg=C3=A4ra h=C3=A4lsoun=
ders=C3=B6kningar av s=C3=B6kande med h=C3=A4nvisning till folkh=C3=A4lsan.=
 Resultaten av s=C3=A5dana h=C3=A4lsounders=C3=B6kningar b=C3=B6r inte p=C3=
=A5verka bed=C3=B6mningen av ans=C3=B6kningar om internationellt skydd, som=
 alltid b=C3=B6r utf=C3=B6ras objektivt, opartiskt och p=C3=A5 individuell =
grund i&nbsp;enlighet med f=C3=B6rordning (EU) 2024/1348.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_47">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(47)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Det b=C3=B6r vara m=C3=B6=
jligt att inskr=C3=A4nka en s=C3=B6kandes r=C3=A4tt till materiella mottagn=
ingsvillkor enligt detta direktiv under vissa f=C3=B6rh=C3=A5llanden, till =
exempel om en s=C3=B6kande har avvikit till en annan medlemsstat fr=C3=A5n =
den medlemsstat d=C3=A4r s=C3=B6kanden =C3=A4r skyldig att befinna sig. Eme=
llertid b=C3=B6r medlemsstaterna under alla omst=C3=A4ndigheter s=C3=A4kers=
t=C3=A4lla tillg=C3=A5ng till h=C3=A4lso- och sjukv=C3=A5rd och till en lev=
nadsstandard f=C3=B6r s=C3=B6kande som =C3=A4r i&nbsp;enlighet med unionsr=
=C3=A4tten, inbegripet stadgan, och andra internationella skyldigheter, inb=
egripet 1989 =C3=A5rs FN-konvention om barnets r=C3=A4ttigheter. Medlemssta=
terna b=C3=B6r i&nbsp;synnerhet tillgodose s=C3=B6kandens uppeh=C3=A4lle oc=
h grundl=C3=A4ggande behov, s=C3=A5v=C3=A4l n=C3=A4r det g=C3=A4ller fysisk=
 s=C3=A4kerhet och v=C3=A4rdighet som betr=C3=A4ffande relationer med andra=
 m=C3=A4nniskor, med vederb=C3=B6rlig h=C3=A4nsyn till den inneboende s=C3=
=A5rbarheten hos den person som ans=C3=B6ker om internationellt skydd och h=
os hans eller hennes familj eller omsorgsperson. Vederb=C3=B6rlig h=C3=A4ns=
yn b=C3=B6r ocks=C3=A5 tas till s=C3=B6kande med s=C3=A4rskilda mottagandeb=
ehov. H=C3=A4nsyn b=C3=B6r ocks=C3=A5 tas till de s=C3=A4rskilda behoven f=
=C3=B6r s=C3=B6kande som har upplevt sexuellt eller k=C3=B6nsrelaterat v=C3=
=A5ld, i&nbsp;synnerhet kvinnor, inbegripet genom att i&nbsp;olika skeden a=
v f=C3=B6rfarandet f=C3=B6r internationellt skydd s=C3=A4kerst=C3=A4lla til=
lg=C3=A5ng till h=C3=A4lso- och sjukv=C3=A5rd, r=C3=A4ttsligt bist=C3=A5nd =
samt l=C3=A4mplig traumar=C3=A5dgivning och psykosocial omsorg.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_48">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(48)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">De s=C3=A4rskilda behoven=
 f=C3=B6r under=C3=A5riga, i&nbsp;synnerhet med avseende p=C3=A5 respekten =
f=C3=B6r barnets r=C3=A4tt till utbildning och tillg=C3=A5ng till h=C3=A4ls=
o- och sjukv=C3=A5rd b=C3=B6r beaktas. Under=C3=A5riga barn till s=C3=B6kan=
de och under=C3=A5riga s=C3=B6kande b=C3=B6r beviljas samma tilltr=C3=A4de =
till utbildning som medlemsstaternas egna medborgare och p=C3=A5 liknande v=
illkor. Detta tilltr=C3=A4de beh=C3=B6ver inte ges under skolloven. Deras u=
tbildning b=C3=B6r som regel vara integrerad med utbildningen f=C3=B6r medl=
emsstaternas egna medborgare och vara av samma kvalitet. Medlemsstaterna b=
=C3=B6r ocks=C3=A5 s=C3=A4kerst=C3=A4lla kontinuiteten i&nbsp;utbildningen =
av under=C3=A5riga s=C3=A5 l=C3=A4nge som en utvisnings=C3=A5tg=C3=A4rd mot=
 dem eller deras f=C3=B6r=C3=A4ldrar inte har verkst=C3=A4llts.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_49">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(49)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Mot bakgrund av stadgan, =
den europeiska konventionen om skydd f=C3=B6r de m=C3=A4nskliga r=C3=A4ttig=
heterna och de grundl=C3=A4ggande friheterna och relevant r=C3=A4ttspraxis,=
 och f=C3=B6r att inte diskriminera familjemedlemmar p=C3=A5 grundval av de=
n plats d=C3=A4r familjen bildades, b=C3=B6r begreppet familj =C3=A4ven inb=
egripa familjer som har bildats utanf=C3=B6r s=C3=B6kandenas ursprungsland,=
 men innan de anl=C3=A4nde till medlemsstaternas territorium.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_50">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(50)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">F=C3=B6r att hj=C3=A4lpa =
s=C3=B6kande att bli sj=C3=A4lvf=C3=B6rs=C3=B6rjande och minska de stora sk=
illnaderna mellan medlemsstaterna =C3=A4r det viktigt att fastst=C3=A4lla t=
ydliga regler f=C3=B6r s=C3=B6kandes tilltr=C3=A4de till arbetsmarknaden oc=
h se till att detta tilltr=C3=A4de faktiskt ges, genom att inte uppst=C3=A4=
lla villkor som i&nbsp;praktiken hindrar en s=C3=B6kande fr=C3=A5n att s=C3=
=B6ka anst=C3=A4llning, inte p=C3=A5 ett otillb=C3=B6rligt s=C3=A4tt inskr=
=C3=A4nka en s=C3=B6kandes tilltr=C3=A4de till specifika sektorer av arbets=
marknaden eller arbetstid och inte inf=C3=B6ra orimliga administrativa form=
aliteter. S=C3=B6kande som har faktiskt tilltr=C3=A4de till arbetsmarknaden=
 och som har till=C3=A5tits bo endast p=C3=A5 en best=C3=A4md plats b=C3=B6=
r f=C3=A5 s=C3=B6ka arbete inom rimligt avst=C3=A5nd fr=C3=A5n den platsen.=
 N=C3=A4r s=C3=A5 kr=C3=A4vs enligt en s=C3=B6kandes anst=C3=A4llningsavtal=
 b=C3=B6r medlemsstaterna kunna bevilja s=C3=B6kanden tillst=C3=A5nd att l=
=C3=A4mna deras territorium f=C3=B6r att utf=C3=B6ra specifika arbetsuppgif=
ter i&nbsp;en annan medlemsstat i&nbsp;enlighet med nationell r=C3=A4tt. Ar=
betsmarknadstester som anv=C3=A4nds f=C3=B6r att ge f=C3=B6rtur f=C3=B6r eg=
na medborgare eller andra unionsmedborgare eller till tredjelandsmedborgare=
 och statsl=C3=B6sa personer som =C3=A4r lagligt bosatta i&nbsp;den ber=C3=
=B6rda medlemsstaten b=C3=B6r inte hindra ett faktiskt tilltr=C3=A4de till =
arbetsmarknaden f=C3=B6r s=C3=B6kande och b=C3=B6r genomf=C3=B6ras utan att=
 det p=C3=A5verkar principen om f=C3=B6retr=C3=A4de f=C3=B6r unionsmedborga=
re s=C3=A5som den uttrycks i&nbsp;de relevanta best=C3=A4mmelserna i&nbsp;t=
ill=C3=A4mpliga anslutningsakter.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_51">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(51)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Tilltr=C3=A4de till arbet=
smarknaden b=C3=B6r ge s=C3=B6kanden r=C3=A4tt att s=C3=B6ka anst=C3=A4llni=
ng. Medlemsstaterna kan ocks=C3=A5 till=C3=A5ta s=C3=B6kande att vara egenf=
=C3=B6retagare.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_52">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(52)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">F=C3=B6r att st=C3=A4rka =
s=C3=B6kandes utsikter till integration och sj=C3=A4lvf=C3=B6rs=C3=B6rjning=
 uppmuntras ett tidigarelagt tilltr=C3=A4de till arbetsmarknaden om ans=C3=
=B6kan kan f=C3=B6rv=C3=A4ntas vara v=C3=A4lgrundad, inbegripet n=C3=A4r de=
n har blivit f=C3=B6rem=C3=A5l f=C3=B6r prioriterad pr=C3=B6vning i&nbsp;en=
lighet med f=C3=B6rordning (EU) 2024/1348. Medlemsstaterna b=C3=B6r d=C3=A4=
rf=C3=B6r =C3=B6verv=C3=A4ga att korta ner den tidsperioden s=C3=A5 mycket =
som m=C3=B6jligt i&nbsp;fall d=C3=A4r ans=C3=B6kan kan f=C3=B6rv=C3=A4ntas =
vara v=C3=A4lgrundad. Tilltr=C3=A4de till arbetsmarknaden b=C3=B6r inte bev=
iljas, eller b=C3=B6r, om det redan har beviljats, =C3=A5terkallas, om en s=
=C3=B6kandes ans=C3=B6kan om internationellt skydd sannolikt =C3=A4r ogrund=
ad och f=C3=B6r vilken en p=C3=A5skyndad pr=C3=B6vning d=C3=A4rf=C3=B6r til=
l=C3=A4mpas, inbegripet n=C3=A4r s=C3=B6kanden undanh=C3=A5ller relevanta u=
ppgifter eller handlingar som r=C3=B6r s=C3=B6kandes identitet.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_53">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(53)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">N=C3=A4r s=C3=B6kande v=
=C3=A4l beviljats tilltr=C3=A4de till arbetsmarknaden b=C3=B6r de vara ber=
=C3=A4ttigade till en gemensam upps=C3=A4ttning r=C3=A4ttigheter baserade p=
=C3=A5 likabehandling i&nbsp;f=C3=B6rh=C3=A5llande till medborgarna i&nbsp;=
den ber=C3=B6rda medlemsstaten. Arbetsvillkoren b=C3=B6r omfatta =C3=A5tmin=
stone l=C3=B6n och upps=C3=A4gning, h=C3=A4lso- och s=C3=A4kerhetskrav p=C3=
=A5 arbetsplatsen, arbetstider, ledighet och allm=C3=A4nna helgdagar, med b=
eaktande av g=C3=A4llande kollektivavtal. S=C3=A5dana s=C3=B6kande b=C3=B6r=
 ocks=C3=A5 =C3=A5tnjuta likabehandling n=C3=A4r det g=C3=A4ller f=C3=B6ren=
ingsfrihet och frihet att tillh=C3=B6ra en arbetstagar- eller arbetsgivaror=
ganisation eller liknande, utbildning och yrkesutbildning, erk=C3=A4nnande =
av yrkeskvalifikationer och, i&nbsp;fr=C3=A5ga om anst=C3=A4llda s=C3=B6kan=
de, social trygghet. Det =C3=A4r m=C3=B6jligt f=C3=B6r medlemsstaterna att =
bevilja likabehandling ocks=C3=A5 f=C3=B6r s=C3=B6kande som =C3=A4r egenf=
=C3=B6retagare. Medlemsstaterna ska g=C3=B6ra sitt yttersta f=C3=B6r att f=
=C3=B6rhindra exploatering av s=C3=B6kande eller n=C3=A5gon form av diskrim=
inering mot dem p=C3=A5 arbetsplatsen i&nbsp;form av svartarbete och andra =
former av allvarlig arbetskraftsexploatering.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_54">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(54)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">N=C3=A4r s=C3=B6kande v=
=C3=A4l beviljats tilltr=C3=A4de till arbetsmarknaden b=C3=B6r en medlemsst=
at erk=C3=A4nna yrkeskvalifikationer som en s=C3=B6kande har f=C3=B6rv=C3=
=A4rvat i&nbsp;en annan medlemsstat p=C3=A5 samma s=C3=A4tt som g=C3=A4ller=
 f=C3=B6r unionsmedborgare och b=C3=B6r beakta kvalifikationer som f=C3=B6r=
v=C3=A4rvats i&nbsp;ett tredjeland, i&nbsp;enlighet med Europaparlamentets =
och r=C3=A5dets direktiv 2005/36/EG&nbsp;<a id=3D"ntc9-L_202401346SV.000101=
-E0009" href=3D"https://eur-lex.europa.eu/legal-content/SV/TXT/HTML/?uri=3D=
OJ:L_202401346#ntr9-L_202401346SV.000101-E0009">(<span class=3D"oj-super oj=
-note-tag">9</span>)</a>. =C3=85tg=C3=A4rder b=C3=B6r ocks=C3=A5 =C3=B6verv=
=C3=A4gas i&nbsp;syfte att p=C3=A5 ett effektivt s=C3=A4tt hantera de prakt=
iska sv=C3=A5righeter som s=C3=B6kande st=C3=B6ter p=C3=A5 i&nbsp;samband m=
ed bestyrkande av sina utl=C3=A4ndska examens-, utbildnings- och andra beh=
=C3=B6righetsbevis, s=C3=A4rskilt om s=C3=B6kandena inte kan tillhandah=C3=
=A5lla dokumentation och inte kan st=C3=A5 f=C3=B6r de kostnader som =C3=A4=
r f=C3=B6rknippade med erk=C3=A4nnandef=C3=B6rfarandena.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_55">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(55)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Degrenar av social tryggh=
et som avses i&nbsp;artikel&nbsp;3.1 och 3.2 i&nbsp;Europarlamentets och r=
=C3=A5dets f=C3=B6rordning (EG) nr&nbsp;883/2004&nbsp;<a id=3D"ntc10-L_2024=
01346SV.000101-E0010" href=3D"https://eur-lex.europa.eu/legal-content/SV/TX=
T/HTML/?uri=3DOJ:L_202401346#ntr10-L_202401346SV.000101-E0010">(<span class=
=3D"oj-super oj-note-tag">10</span>)</a> till=C3=A4mpas p=C3=A5 anst=C3=A4l=
lda s=C3=B6kande.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_56">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(56)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">P=C3=A5 grund av att s=C3=
=B6kandes vistelse kan vara av tillf=C3=A4llig natur b=C3=B6r medlemsstater=
na, utan att det p=C3=A5verkar till=C3=A4mpningen av Europaparlamentets och=
 r=C3=A5dets f=C3=B6rordning (EU) nr&nbsp;1231/2010&nbsp;<a id=3D"ntc11-L_2=
02401346SV.000101-E0011" href=3D"https://eur-lex.europa.eu/legal-content/SV=
/TXT/HTML/?uri=3DOJ:L_202401346#ntr11-L_202401346SV.000101-E0011">(<span cl=
ass=3D"oj-super oj-note-tag">11</span>)</a>, ha m=C3=B6jlighet att undanta =
sociala trygghetsf=C3=B6rm=C3=A5ner som inte =C3=A4r beroende av anst=C3=A4=
llningsperioder eller av avgifter fr=C3=A5n likabehandling av s=C3=B6kande =
och sina egna medborgare. Medlemsstaterna b=C3=B6r ocks=C3=A5 kunna inskr=
=C3=A4nka likabehandlingen n=C3=A4r det g=C3=A4ller utbildning och yrkesutb=
ildning samt erk=C3=A4nnandet av formella kvalifikationer. Dessutom b=C3=B6=
r medlemsstaterna ocks=C3=A5 ha m=C3=B6jlighet att begr=C3=A4nsa f=C3=B6ren=
ingsfriheten och friheten att tillh=C3=B6ra vissa andra organisationer geno=
m att utesluta s=C3=B6kande fr=C3=A5n deltagande i&nbsp;f=C3=B6rvaltningen =
av vissa organ och fr=C3=A5n att inneha offentliga =C3=A4mbeten.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_57">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(57)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Unionsr=C3=A4tten begr=C3=
=A4nsar inte medlemsstaternas befogenhet att organisera sina sociala tryggh=
etssystem. I&nbsp;avsaknad av harmonisering p=C3=A5 unionsniv=C3=A5, ankomm=
er det f=C3=B6ljaktligen p=C3=A5 varje medlemsstat att best=C3=A4mma villko=
ren f=C3=B6r beviljande av sociala trygghetsf=C3=B6rm=C3=A5ner, f=C3=B6rm=
=C3=A5nernas storlek och under hur l=C3=A5ng tid som de ska utg=C3=A5. I&nb=
sp;samband med att medlemsstaterna ut=C3=B6var denna befogenhet b=C3=B6r de=
 emellertid f=C3=B6lja unionsr=C3=A4tten.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_58">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(58)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Spr=C3=A5kkunskaper =C3=
=A4r viktiga f=C3=B6r att s=C3=A4kerst=C3=A4lla att s=C3=B6kande har en til=
lr=C3=A4cklig levnadsstandard. Dessa kunskaper avskr=C3=A4cker ocks=C3=A5 f=
r=C3=A5n sekund=C3=A4ra f=C3=B6rflyttningar. Medlemsstaterna b=C3=B6r d=C3=
=A4rf=C3=B6r s=C3=A4kerst=C3=A4lla eller underl=C3=A4tta tilltr=C3=A4de til=
l spr=C3=A5kkurser i&nbsp;den utstr=C3=A4ckning de anser s=C3=A5dana kurser=
 vara l=C3=A4mpliga f=C3=B6r att bidra till att =C3=B6ka en s=C3=B6kandes f=
=C3=B6rm=C3=A5ga att agera sj=C3=A4lvst=C3=A4ndigt och interagera med beh=
=C3=B6riga myndigheter.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_59">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(59)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">R=C3=A4tten till likabeha=
ndling b=C3=B6r inte ge upphov till r=C3=A4ttigheter i&nbsp;situationer som=
 inte omfattas av unionsr=C3=A4tten.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_60">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(60)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">F=C3=B6r att s=C3=A4kerst=
=C3=A4lla att de materiella mottagningsvillkoren till s=C3=B6kande f=C3=B6l=
jer principerna i&nbsp;detta direktiv =C3=A4r det n=C3=B6dv=C3=A4ndigt att =
f=C3=B6rtydliga dessa villkors natur, som b=C3=B6r omfatta inte bara inkvar=
tering, mat och kl=C3=A4der, utan ocks=C3=A5 hygienprodukter. Det =C3=A4r o=
cks=C3=A5 n=C3=B6dv=C3=A4ndigt att medlemsstaterna fastst=C3=A4ller en niv=
=C3=A5 f=C3=B6r materiella mottagningsvillkor som tillhandah=C3=A5lls i&nbs=
p;form av ekonomiska bidrag eller kuponger p=C3=A5 grundval av relevanta re=
ferenser som till=C3=A4mpas f=C3=B6r s=C3=A4kerst=C3=A4llande av tillr=C3=
=A4cklig levnadsstandard f=C3=B6r egna medborgare, s=C3=A5som&nbsp;=E2=80=
=93 beroende p=C3=A5 de nationella f=C3=B6rh=C3=A5llandena&nbsp;=E2=80=93 m=
inimiinkomstf=C3=B6rm=C3=A5ner, minimil=C3=B6n, minimipension, arbetsl=C3=
=B6shetsers=C3=A4ttning och socialt st=C3=B6d. Detta =C3=A4r emellertid int=
e n=C3=B6dv=C3=A4ndigt att det belopp som beviljas s=C3=B6kande =C3=A4r det=
samma som f=C3=B6r de egna medborgarna. Medlemsstaterna b=C3=B6r kunna beha=
ndla s=C3=B6kande mindre gynnsamt =C3=A4n de egna medborgarna enligt detta =
direktiv. Medlemsstaterna b=C3=B6r ocks=C3=A5 ha m=C3=B6jlighet att anpassa=
 niv=C3=A5n p=C3=A5 de ekonomiska bidragen eller de kuponger som beviljas s=
=C3=B6kande i&nbsp;de regioner som avses i&nbsp;artikel&nbsp;349 i&nbsp;f=
=C3=B6rdraget om Europeiska unionens funktionss=C3=A4tt (EUF-f=C3=B6rdraget=
), under f=C3=B6ruts=C3=A4ttning att standarden p=C3=A5 de mottagningsvillk=
or som f=C3=B6reskrivs i&nbsp;detta direktiv s=C3=A4kerst=C3=A4lls.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_61">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(61)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">F=C3=B6r att begr=C3=A4ns=
a m=C3=B6jligheterna till missbruk av mottagningssystemet b=C3=B6r medlemss=
taterna ha r=C3=A4tt att bevilja materiella mottagningsvillkor endast till =
s=C3=B6kande som saknar tillr=C3=A4ckliga tillg=C3=A5ngar f=C3=B6r att f=C3=
=B6rs=C3=B6rja sig. Medlemsstaterna b=C3=B6r ha r=C3=A4tt att kr=C3=A4va at=
t s=C3=B6kande med tillr=C3=A4ckliga tillg=C3=A5ngar ska t=C3=A4cka, bidra =
till eller =C3=A5terbetala kostnaderna f=C3=B6r de materiella mottagningsvi=
llkoren eller h=C3=A4lso- och sjukv=C3=A5rd som erh=C3=A5llits, inbegripet =
genom finansiella s=C3=A4kerheter. S=C3=B6kande kan anses ha tillr=C3=A4ckl=
iga tillg=C3=A5ngar f=C3=B6r att f=C3=B6rs=C3=B6rja sig till exempel om de =
har arbetat under en rimlig tidsperiod. Vid bed=C3=B6mning av en s=C3=B6kan=
des tillg=C3=A5ngar och uppst=C3=A4llande av krav p=C3=A5 att en s=C3=B6kan=
de t=C3=A4cker eller bidrar till kostnaderna f=C3=B6r de materiella mottagn=
ingsvillkoren eller h=C3=A4lso- och sjukv=C3=A5rd som erh=C3=A5llits, b=C3=
=B6r medlemsstaterna respektera proportionalitetsprincipen och beakta s=C3=
=B6kandens individuella omst=C3=A4ndigheter och behovet av att respektera h=
ans eller hennes v=C3=A4rdighet eller personliga integritet, inbegripet s=
=C3=B6kandens s=C3=A4rskilda mottagandebehov. S=C3=B6kande b=C3=B6r inte va=
ra skyldiga att t=C3=A4cka eller bidra till kostnaderna f=C3=B6r n=C3=B6dv=
=C3=A4ndig h=C3=A4lso- och sjukv=C3=A5rd, om s=C3=A5dan h=C3=A4lso- och sju=
kv=C3=A5rd erbjuds medlemsstaternas medborgare kostnadsfritt. S=C3=B6kande =
b=C3=B6r inte vara skyldiga att ta l=C3=A5n f=C3=B6r att betala f=C3=B6r mo=
ttagningsvillkor.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_62">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(62)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Eventuellt missbruk av mo=
ttagningssystemet b=C3=B6r f=C3=B6rhindras ocks=C3=A5 genom att det precise=
ras under vilka omst=C3=A4ndigheter de materiella mottagningsvillkoren kan =
inskr=C3=A4nkas eller dras in. Medlemsstaterna b=C3=B6r kunna inskr=C3=A4nk=
a eller dra in dagers=C3=A4ttningen eller, d=C3=A4r det =C3=A4r motiverat o=
ch proportionellt, inskr=C3=A4nka andra materiella mottagningsvillkor om vi=
ssa villkor =C3=A4r uppfyllda, inbegripet n=C3=A4r s=C3=B6kanden inte samar=
betar med de beh=C3=B6riga myndigheterna eller inte fullg=C3=B6r de f=C3=B6=
rfarandekrav som dessa fastst=C3=A4llt. Bristande samarbete eller bristande=
 efterlevnad kan anses f=C3=B6rekomma i&nbsp;synnerhet om s=C3=B6kande inte=
 infinner sig till avtalade m=C3=B6ten eller underl=C3=A5ter att fullg=C3=
=B6ra sin anm=C3=A4lningsskyldighet av sk=C3=A4l som inte ligger utom deras=
 kontroll, s=C3=B6kande inte l=C3=A4mnar in sin ans=C3=B6kan om internation=
ellt skydd i&nbsp;enlighet med kraven i&nbsp;f=C3=B6rordning (EU) 2024/1348=
, trots att de haft faktisk m=C3=B6jlighet att g=C3=B6ra detta, eller s=C3=
=B6kande ignorerar beg=C3=A4randen om information som kan underl=C3=A4tta p=
rocessen f=C3=B6r identifiering av dem, inbegripet genom att v=C3=A4gra att=
 tillhandah=C3=A5lla biometriska uppgifter eller n=C3=B6dv=C3=A4ndiga konta=
ktuppgifter eller genom att v=C3=A4gra att samarbeta i&nbsp;samband med h=
=C3=A4lsounders=C3=B6kningar. Medlemsstaterna b=C3=B6r ocks=C3=A5, n=C3=A4r=
 det =C3=A4r vederb=C3=B6rligen motiverat och proportionellt, ha r=C3=A4tt =
att dra in andra materiella mottagningsvillkor n=C3=A4r s=C3=B6kanden allva=
rligt eller vid upprepade tillf=C3=A4llen har brutit mot f=C3=B6rl=C3=A4ggn=
ingens regler eller har upptr=C3=A4tt p=C3=A5 ett v=C3=A5ldsamt eller hotfu=
llt s=C3=A4tt p=C3=A5 f=C3=B6rl=C3=A4ggningen. Medlemsstaterna b=C3=B6r f=
=C3=B6r alla s=C3=B6kande alltid s=C3=A4kerst=C3=A4lla en levnadsstandard i=
&nbsp;enlighet med unionsr=C3=A4tten, inbegripet stadgan, och internationel=
la skyldigheter, med h=C3=A4nsyn till s=C3=B6kande med s=C3=A4rskilda motta=
gandebehov och barnets b=C3=A4sta.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_63">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(63)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Det =C3=A4r m=C3=B6jligt =
f=C3=B6r medlemsstaterna att till=C3=A4mpa andra sanktioner, inbegripet dis=
ciplin=C3=A4ra =C3=A5tg=C3=A4rder i&nbsp;enlighet med f=C3=B6rl=C3=A4ggning=
ens regler, i&nbsp;den m=C3=A5n dessa sanktioner inte strider mot detta dir=
ektiv.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_64">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(64)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Medlemsstaterna b=C3=B6r =
uppr=C3=A4tta l=C3=A4mplig v=C3=A4gledning, =C3=B6vervakning och kontroll a=
v sina mottagningsvillkor. F=C3=B6r att s=C3=A4kerst=C3=A4lla likv=C3=A4rdi=
ga mottagningsvillkor b=C3=B6r medlemsstaterna vara skyldiga att i&nbsp;sin=
a =C3=B6vervaknings- och kontrollsystem ta h=C3=A4nsyn till tillg=C3=A4ngli=
ga icke-bindande operativa normer, indikatorer, riktlinjer och b=C3=A4sta m=
etoder f=C3=B6r mottagningsvillkor som utarbetats av asylbyr=C3=A5n. Under =
f=C3=B6ruts=C3=A4ttning att de materiella mottagningsvillkoren ger en tillr=
=C3=A4cklig levnadsstandard kan villkoren i&nbsp;lokaler f=C3=B6r inkvarter=
ing av s=C3=B6kande anses vara l=C3=A4mpliga, trots att de skiljer sig =C3=
=A5t fr=C3=A5n en anl=C3=A4ggning till en annan. Det b=C3=B6r s=C3=A4kerst=
=C3=A4llas att de nationella mottagningssystemen och samarbetet mellan medl=
emsstaterna n=C3=A4r det g=C3=A4ller mottagning av s=C3=B6kande fungerar ef=
fektivt, inbegripet genom asylbyr=C3=A5ns n=C3=A4tverk f=C3=B6r mottagande =
myndigheter.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_65">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(65)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">L=C3=A4mplig samordning b=
=C3=B6r fr=C3=A4mjas mellan beh=C3=B6riga myndigheter vad g=C3=A4ller motta=
gande av s=C3=B6kande, och harmoniska f=C3=B6rbindelser mellan lokalsamh=C3=
=A4llen och f=C3=B6rl=C3=A4ggningar b=C3=B6r d=C3=A4rf=C3=B6r fr=C3=A4mjas.=
</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_66">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(66)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Erfarenheten visar att de=
t beh=C3=B6vs beredskapsplanering f=C3=B6r att i&nbsp;m=C3=B6jligaste m=C3=
=A5n s=C3=A4kerst=C3=A4lla ett adekvat mottagande av s=C3=B6kande i&nbsp;fa=
ll d=C3=A4r flera medlemsstater st=C3=A4lls inf=C3=B6r en situation med ett=
 oproportionerligt stort antal personer som ans=C3=B6ker om internationellt=
 skydd. Huruvida de =C3=A5tg=C3=A4rder som f=C3=B6rutses i&nbsp;medlemsstat=
ernas beredskapsplaner =C3=A4r tillr=C3=A4ckliga b=C3=B6r =C3=B6vervakas oc=
h bed=C3=B6mas. Beredskapsplanering =C3=A4r en integrerad del av medlemssta=
ternas planeringsprocesser och kan inte betraktas som exceptionell verksamh=
et.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_67">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(67)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Asylbyr=C3=A5n b=C3=B6r h=
j=C3=A4lpa medlemsstaterna att utarbeta och se =C3=B6ver sina beredskapspla=
ner, med den ber=C3=B6rda medlemsstatens samtycke. En beredskapsplan b=C3=
=B6r best=C3=A5 av en omfattande upps=C3=A4ttning =C3=A5tg=C3=A4rder som =
=C3=A4r n=C3=B6dv=C3=A4ndiga f=C3=B6r att hantera ett eventuellt oproportio=
nerligt tryck p=C3=A5 medlemsstaternas mottagningssystem och f=C3=B6r att f=
=C3=B6rb=C3=A4ttra dessa systems effektivitet. Vid till=C3=A4mpningen av de=
tta direktiv kan en situation med ett oproportionerligt tryck karakterisera=
s av en pl=C3=B6tslig och massiv tillstr=C3=B6mning av tredjelandsmedborgar=
e och statsl=C3=B6sa personer i&nbsp;den m=C3=A5n tillstr=C3=B6mningen medf=
=C3=B6r en extremt stor b=C3=B6rda =C3=A4ven f=C3=B6r ett v=C3=A4l f=C3=B6r=
berett mottagningssystem. F=C3=B6r att uppn=C3=A5 st=C3=B6rre beredskap f=
=C3=B6r en s=C3=A5dan situation b=C3=B6r den mall som utarbetats av asylbyr=
=C3=A5n inneh=C3=A5lla riktlinjer f=C3=B6r hur m=C3=B6jliga scenarier, effe=
kten av dessa scenarier, =C3=A5tg=C3=A4rder som ska vidtas och tillg=C3=A4n=
gliga resurser f=C3=B6r att svara p=C3=A5 dessa scenarier ska identifieras.=
</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_68">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(68)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Medlemsstaterna b=C3=B6r =
f=C3=A5 inf=C3=B6ra eller bibeh=C3=A5lla mer f=C3=B6rm=C3=A5nliga best=C3=
=A4mmelser f=C3=B6r tredjelandsmedborgare och statsl=C3=B6sa personer som s=
=C3=B6ker internationellt skydd i&nbsp;en medlemsstat.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_69">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(69)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Medlemsstaterna uppmanas =
att till=C3=A4mpa best=C3=A4mmelserna i&nbsp;detta direktiv i&nbsp;samband =
med f=C3=B6rfaranden f=C3=B6r att besluta om ans=C3=B6kningar om andra skyd=
dsformer =C3=A4n de som f=C3=B6reskrivs enligt Europaparlamentets och r=C3=
=A5dets f=C3=B6rordning (EU) 2024/1347&nbsp;<a id=3D"ntc12-L_202401346SV.00=
0101-E0012" href=3D"https://eur-lex.europa.eu/legal-content/SV/TXT/HTML/?ur=
i=3DOJ:L_202401346#ntr12-L_202401346SV.000101-E0012">(<span class=3D"oj-sup=
er oj-note-tag">12</span>)</a>.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_70">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(70)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Genomf=C3=B6randet av det=
ta direktiv b=C3=B6r utv=C3=A4rderas regelbundet. Medlemsstaterna b=C3=B6r =
f=C3=B6rse kommissionen med den information som kr=C3=A4vs f=C3=B6r att kom=
missionen ska kunna fullg=C3=B6ra sina rapporteringsskyldigheter enligt det=
ta direktiv.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_71">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(71)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Eftersom m=C3=A5let f=C3=
=B6r detta direktiv, n=C3=A4mligen att fastst=C3=A4lla harmoniserade normer=
 f=C3=B6r mottagningsvillkor f=C3=B6r s=C3=B6kande i&nbsp;medlemsstaterna, =
inte i&nbsp;tillr=C3=A4cklig utstr=C3=A4ckning kan uppn=C3=A5s av medlemsst=
aterna utan snarare, p=C3=A5 grund av =C3=A5tg=C3=A4rdens omfattning och ve=
rkningar kan uppn=C3=A5s b=C3=A4ttre p=C3=A5 unionsniv=C3=A5, kan unionen v=
idta =C3=A5tg=C3=A4rder i&nbsp;enlighet med subsidiaritetsprincipen i&nbsp;=
artikel&nbsp;5 i&nbsp;f=C3=B6rdraget om Europeiska unionen. I&nbsp;enlighet=
 med proportionalitetsprincipen i&nbsp;samma artikel g=C3=A5r detta direkti=
v inte ut=C3=B6ver vad som =C3=A4r n=C3=B6dv=C3=A4ndigt f=C3=B6r att uppn=
=C3=A5 detta m=C3=A5l.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_72">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(72)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">I enlighet med den gemens=
amma politiska f=C3=B6rklaringen av den 28&nbsp;september 2011 fr=C3=A5n me=
dlemsstaterna och kommissionen om f=C3=B6rklarande dokument&nbsp;<a id=3D"n=
tc13-L_202401346SV.000101-E0013" href=3D"https://eur-lex.europa.eu/legal-co=
ntent/SV/TXT/HTML/?uri=3DOJ:L_202401346#ntr13-L_202401346SV.000101-E0013">(=
<span class=3D"oj-super oj-note-tag">13</span>)</a>, har medlemsstaterna =
=C3=A5tagit sig att, n=C3=A4r det =C3=A4r motiverat, l=C3=A5ta anm=C3=A4lan=
 av inf=C3=B6rlivande=C3=A5tg=C3=A4rder =C3=A5tf=C3=B6ljas av ett eller fle=
ra dokument som f=C3=B6rklarar f=C3=B6rh=C3=A5llandet mellan de olika delar=
na i&nbsp;direktivet och motsvarande delar i&nbsp;de nationella instrumente=
n f=C3=B6r inf=C3=B6rlivande. Lagstiftaren anser att det =C3=A4r motiverat =
att s=C3=A5dana dokument =C3=B6vers=C3=A4nds avseende detta direktiv.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_73">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(73)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">I enlighet med artiklarna=
&nbsp;1 och 2 i&nbsp;protokoll nr&nbsp;21 om F=C3=B6renade kungarikets och =
Irlands st=C3=A4llning med avseende p=C3=A5 omr=C3=A5det med frihet, s=C3=
=A4kerhet och r=C3=A4ttvisa, fogat till EU-f=C3=B6rdraget och EUF-f=C3=B6rd=
raget, och utan att det p=C3=A5verkar till=C3=A4mpningen av artikel&nbsp;4 =
i&nbsp;det protokollet, deltar Irland inte i&nbsp;antagandet av detta direk=
tiv, som inte =C3=A4r bindande f=C3=B6r eller till=C3=A4mplig p=C3=A5 Irlan=
d.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_74">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(74)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">I enlighet med artiklarna=
&nbsp;1 och 2 i&nbsp;protokoll nr&nbsp;22 om Danmarks st=C3=A4llning, fogat=
 till EU-f=C3=B6rdraget och EUF-f=C3=B6rdraget, deltar Danmark inte i&nbsp;=
antagandet av detta direktiv, som inte =C3=A4r bindande f=C3=B6r eller till=
=C3=A4mpligt p=C3=A5 Danmark.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_75">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(75)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Detta direktiv st=C3=A5r =
i&nbsp;=C3=B6verensst=C3=A4mmelse med de grundl=C3=A4ggande r=C3=A4ttighete=
r och principer som erk=C3=A4nns s=C3=A4rskilt i&nbsp;stadgan. Direktivet s=
yftar s=C3=A4rskilt till att s=C3=A4kerst=C3=A4lla full respekt f=C3=B6r de=
n m=C3=A4nskliga v=C3=A4rdigheten samt till att fr=C3=A4mja till=C3=A4mpnin=
gen av artiklarna&nbsp;1, 4, 6, 7, 18, 21, 24 och 47 i&nbsp;stadgan, och m=
=C3=A5ste genomf=C3=B6ras i&nbsp;enlighet d=C3=A4rmed.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_76">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(76)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Skyldigheten att inf=C3=
=B6rliva detta direktiv med nationell r=C3=A4tt b=C3=B6r endast g=C3=A4lla =
de best=C3=A4mmelser som utg=C3=B6r en inneh=C3=A5llsm=C3=A4ssig =C3=A4ndri=
ng i&nbsp;f=C3=B6rh=C3=A5llande till det tidigare direktivet. Skyldigheten =
att inf=C3=B6rliva de of=C3=B6r=C3=A4ndrade best=C3=A4mmelserna f=C3=B6ljer=
 av det tidigare direktivet.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <div class=3D"eli-subdivision" id=3D"rct_77">
               <table width=3D"100%" border=3D"0" cellspacing=3D"0" cellpad=
ding=3D"0">
                  <colgroup><col width=3D"4%">
                  <col width=3D"96%">
                  </colgroup><tbody>
                     <tr>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">(77)</p>
                        </td>
                        <td valign=3D"top">
                           <p class=3D"oj-normal">Detta direktiv b=C3=B6r i=
nte p=C3=A5verka medlemsstaternas skyldigheter vad g=C3=A4ller den tidsfris=
t f=C3=B6r inf=C3=B6rlivande med nationell r=C3=A4tt av direktivet som ange=
s i&nbsp;bilaga&nbsp;I.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
            </div>
            <p class=3D"oj-normal">H=C3=84RIGENOM F=C3=96RESKRIVS F=C3=96LJ=
ANDE.</p>
         </div>
         <div class=3D"eli-subdivision" id=3D"enc_1">
            <div id=3D"cpt_I">
               <p id=3D"d1e713-1-1" class=3D"oj-ti-section-1">KAPITEL&nbsp;=
I</p>
               <div class=3D"eli-title" id=3D"cpt_I.tit_1">
                  <p id=3D"L_01346SV.01000101-d-001" class=3D"oj-ti-section=
-2">
                     <span class=3D"oj-bold">SYFTE, DEFINITIONER OCH TILL=
=C3=84MPNINGSOMR=C3=85DE</span>
                  </p>
               </div>
               <div class=3D"eli-subdivision" id=3D"art_1">
                  <p id=3D"d1e721-1-1" class=3D"oj-ti-art">Artikel&nbsp;1</=
p>
                  <div class=3D"eli-title" id=3D"art_1.tit_1">
                     <p class=3D"oj-sti-art">Inneh=C3=A5ll</p>
                  </div>
                  <p class=3D"oj-normal">I detta direktiv fastst=C3=A4lls n=
ormer f=C3=B6r mottagande av personer som ans=C3=B6ker om internationellt s=
kydd i&nbsp;medlemsstaterna.</p>
               </div>
               <div class=3D"eli-subdivision" id=3D"art_2">
                  <p id=3D"d1e729-1-1" class=3D"oj-ti-art">Artikel&nbsp;2</=
p>
                  <div class=3D"eli-title" id=3D"art_2.tit_1">
                     <p class=3D"oj-sti-art">Definitioner</p>
                  </div>
                  <p class=3D"oj-normal">I detta direktiv g=C3=A4ller f=C3=
=B6ljande definitioner:</p>
                  <table width=3D"100%" border=3D"0" cellspacing=3D"0" cell=
padding=3D"0">
                     <colgroup><col width=3D"4%">
                     <col width=3D"96%">
                     </colgroup><tbody>
                        <tr>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">1.</p>
                           </td>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">
                                 <span class=3D"oj-italic">ans=C3=B6kan om =
internationellt skydd eller ans=C3=B6kan</span>: en beg=C3=A4ran om en medl=
emsstats beskydd som g=C3=B6rs av en tredjelandsmedborgare eller en statsl=
=C3=B6s person som kan antas s=C3=B6ka flyktingstatus eller status som subs=
idi=C3=A4rt skyddsbeh=C3=B6vande.</p>
                           </td>
                        </tr>
                     </tbody>
                  </table>
                  <table width=3D"100%" border=3D"0" cellspacing=3D"0" cell=
padding=3D"0">
                     <colgroup><col width=3D"4%">
                     <col width=3D"96%">
                     </colgroup><tbody>
                        <tr>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">2.</p>
                           </td>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">
                                 <span class=3D"oj-italic">s=C3=B6kande</sp=
an>: en tredjelandsmedborgare eller en statsl=C3=B6s person som har gjort e=
n ans=C3=B6kan om internationellt skydd om vilken ett slutligt beslut =C3=
=A4nnu inte har fattats.</p>
                           </td>
                        </tr>
                     </tbody>
                  </table>
                  <table width=3D"100%" border=3D"0" cellspacing=3D"0" cell=
padding=3D"0">
                     <colgroup><col width=3D"4%">
                     <col width=3D"96%">
                     </colgroup><tbody>
                        <tr>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">3.</p>
                           </td>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">
                                 <span class=3D"oj-italic">familjemedlemmar=
</span>: f=C3=B6rutsatt att familjen hade bildats redan innan s=C3=B6kanden=
 anl=C3=A4nde till medlemsstaternas territorium, f=C3=B6ljande medlemmar av=
 s=C3=B6kandens familj vilka befinner sig p=C3=A5 samma medlemsstats territ=
orium under f=C3=B6rfarandet f=C3=B6r internationellt skydd:</p>
                              <table width=3D"100%" border=3D"0" cellspacin=
g=3D"0" cellpadding=3D"0">
                                 <colgroup><col width=3D"4%">
                                 <col width=3D"96%">
                                 </colgroup><tbody>
                                    <tr>
                                       <td valign=3D"top">
                                          <p class=3D"oj-normal">a)</p>
                                       </td>
                                       <td valign=3D"top">
                                          <p class=3D"oj-normal">S=C3=B6kan=
dens make/maka eller ogifta partner i&nbsp;en stadigvarande relation, om og=
ifta par enligt den ber=C3=B6rda medlemsstatens lag eller praxis behandlas =
p=C3=A5 samma s=C3=A4tt som gifta.</p>
                                       </td>
                                    </tr>
                                 </tbody>
                              </table>
                              <table width=3D"100%" border=3D"0" cellspacin=
g=3D"0" cellpadding=3D"0">
                                 <colgroup><col width=3D"4%">
                                 <col width=3D"96%">
                                 </colgroup><tbody>
                                    <tr>
                                       <td valign=3D"top">
                                          <p class=3D"oj-normal">b)</p>
                                       </td>
                                       <td valign=3D"top">
                                          <p class=3D"oj-normal">Under=C3=
=A5riga eller vuxna beroende barn till par enligt led a&nbsp;eller till s=
=C3=B6kanden, f=C3=B6rutsatt att de =C3=A4r ogifta och oavsett om de f=C3=
=B6tts inom eller utom =C3=A4ktenskapet eller adopterats enligt nationell r=
=C3=A4tt; en under=C3=A5rig betraktas som ogift om dennes =C3=A4ktenskap, p=
=C3=A5 grundval av en individuell bed=C3=B6mning, inte skulle vara i&nbsp;e=
nlighet med relevant nationell r=C3=A4tt om det hade ing=C3=A5tts i&nbsp;de=
n ber=C3=B6rda medlemsstaten, s=C3=A4rskilt med h=C3=A4nsyn till den lagsta=
dgade =C3=A5ldersgr=C3=A4nsen f=C3=B6r att ing=C3=A5 =C3=A4ktenskap.</p>
                                       </td>
                                    </tr>
                                 </tbody>
                              </table>
                              <table width=3D"100%" border=3D"0" cellspacin=
g=3D"0" cellpadding=3D"0">
                                 <colgroup><col width=3D"4%">
                                 <col width=3D"96%">
                                 </colgroup><tbody>
                                    <tr>
                                       <td valign=3D"top">
                                          <p class=3D"oj-normal">c)</p>
                                       </td>
                                       <td valign=3D"top">
                                          <p class=3D"oj-normal">Om s=C3=B6=
kanden =C3=A4r under=C3=A5rig och ogift: fadern, modern eller en annan vuxe=
n som enligt den ber=C3=B6rda medlemsstatens lag eller praxis ansvarar f=C3=
=B6r s=C3=B6kanden, inbegripet ett vuxet syskon; en under=C3=A5rig betrakta=
s som ogift om dennes =C3=A4ktenskap, p=C3=A5 grundval av en individuell be=
d=C3=B6mning, inte skulle vara f=C3=B6renligt med relevant nationell r=C3=
=A4tt om det hade ing=C3=A5tts i&nbsp;den ber=C3=B6rda medlemsstaten, s=C3=
=A4rskilt med h=C3=A4nsyn till den lagstadgade =C3=A5ldersgr=C3=A4nsen f=C3=
=B6r att ing=C3=A5 =C3=A4ktenskap.</p>
                                       </td>
                                    </tr>
                                 </tbody>
                              </table>
                           </td>
                        </tr>
                     </tbody>
                  </table>
                  <table width=3D"100%" border=3D"0" cellspacing=3D"0" cell=
padding=3D"0">
                     <colgroup><col width=3D"4%">
                     <col width=3D"96%">
                     </colgroup><tbody>
                        <tr>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">4.</p>
                           </td>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">
                                 <span class=3D"oj-italic">under=C3=A5rig</=
span>: en tredjelandsmedborgare eller statsl=C3=B6s person under 18 =C3=A5r=
.</p>
                           </td>
                        </tr>
                     </tbody>
                  </table>
                  <table width=3D"100%" border=3D"0" cellspacing=3D"0" cell=
padding=3D"0">
                     <colgroup><col width=3D"4%">
                     <col width=3D"96%">
                     </colgroup><tbody>
                        <tr>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">5.</p>
                           </td>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">
                                 <span class=3D"oj-italic">ensamkommande ba=
rn</span>: en under=C3=A5rig som anl=C3=A4nder till medlemsstaternas territ=
orium utan en medf=C3=B6ljande vuxen som enligt den ber=C3=B6rda medlemssta=
tens lag eller praxis ansvarar f=C3=B6r den under=C3=A5rige, s=C3=A5 l=C3=
=A4nge den under=C3=A5rige inte faktiskt tas om hand av en s=C3=A5dan vuxen=
, inbegripet en under=C3=A5rig som har l=C3=A4mnats ensam utan medf=C3=B6lj=
ande vuxen efter det att vederb=C3=B6rande anl=C3=A4nt till medlemsstaterna=
s territorium.</p>
                           </td>
                        </tr>
                     </tbody>
                  </table>
                  <table width=3D"100%" border=3D"0" cellspacing=3D"0" cell=
padding=3D"0">
                     <colgroup><col width=3D"4%">
                     <col width=3D"96%">
                     </colgroup><tbody>
                        <tr>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">6.</p>
                           </td>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">
                                 <span class=3D"oj-italic">mottagningsvillk=
or</span>: samtliga =C3=A5tg=C3=A4rder som medlemsstaterna vidtar till f=C3=
=B6rm=C3=A5n f=C3=B6r s=C3=B6kande i&nbsp;enlighet med detta direktiv.</p>
                           </td>
                        </tr>
                     </tbody>
                  </table>
                  <table width=3D"100%" border=3D"0" cellspacing=3D"0" cell=
padding=3D"0">
                     <colgroup><col width=3D"4%">
                     <col width=3D"96%">
                     </colgroup><tbody>
                        <tr>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">7.</p>
                           </td>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">
                                 <span class=3D"oj-italic">materiella motta=
gningsvillkor</span>: mottagningsvillkor som omfattar inkvartering, mat, kl=
=C3=A4der och hygienprodukter och som tillhandah=C3=A5lls in natura, i&nbsp=
;form av ekonomiskt bidrag, i&nbsp;form av kuponger eller som en kombinatio=
n av dessa, liksom dagers=C3=A4ttning.</p>
                           </td>
                        </tr>
                     </tbody>
                  </table>
                  <table width=3D"100%" border=3D"0" cellspacing=3D"0" cell=
padding=3D"0">
                     <colgroup><col width=3D"4%">
                     <col width=3D"96%">
                     </colgroup><tbody>
                        <tr>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">8.</p>
                           </td>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">
                                 <span class=3D"oj-italic">dagers=C3=A4ttni=
ng</span>: en ers=C3=A4ttning som regelbundet tillhandah=C3=A5lls s=C3=B6ka=
nde f=C3=B6r att de ska kunna =C3=A5tnjuta ett minimum av sj=C3=A4lvst=C3=
=A4ndighet i&nbsp;sina dagliga liv, i&nbsp;form av ett penningbelopp, i&nbs=
p;form av kuponger, in natura eller som en kombination av dessa, f=C3=B6rut=
satt att s=C3=A5dan ers=C3=A4ttning inbegriper ett penningbelopp.</p>
                           </td>
                        </tr>
                     </tbody>
                  </table>
                  <table width=3D"100%" border=3D"0" cellspacing=3D"0" cell=
padding=3D"0">
                     <colgroup><col width=3D"4%">
                     <col width=3D"96%">
                     </colgroup><tbody>
                        <tr>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">9.</p>
                           </td>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">
                                 <span class=3D"oj-italic">f=C3=B6rvar</spa=
n>: en medlemsstats kvarh=C3=A5llande av en s=C3=B6kande inom en s=C3=A4rsk=
ild anl=C3=A4ggning d=C3=A4r s=C3=B6kanden =C3=A4r fr=C3=A5ntagen sin r=C3=
=B6relsefrihet.</p>
                           </td>
                        </tr>
                     </tbody>
                  </table>
                  <table width=3D"100%" border=3D"0" cellspacing=3D"0" cell=
padding=3D"0">
                     <colgroup><col width=3D"4%">
                     <col width=3D"96%">
                     </colgroup><tbody>
                        <tr>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">10.</p>
                           </td>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">
                                 <span class=3D"oj-italic">f=C3=B6rl=C3=A4g=
gning</span>: varje anl=C3=A4ggning som anv=C3=A4nds f=C3=B6r kollektiv ink=
vartering av s=C3=B6kande.</p>
                           </td>
                        </tr>
                     </tbody>
                  </table>
                  <table width=3D"100%" border=3D"0" cellspacing=3D"0" cell=
padding=3D"0">
                     <colgroup><col width=3D"4%">
                     <col width=3D"96%">
                     </colgroup><tbody>
                        <tr>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">11.</p>
                           </td>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">
                                 <span class=3D"oj-italic">risk f=C3=B6r av=
vikande</span>: f=C3=B6rekomsten av specifika sk=C3=A4l och omst=C3=A4ndigh=
eter i&nbsp;ett enskilt fall, grundade p=C3=A5 objektiva kriterier fastst=
=C3=A4llda i&nbsp;nationell r=C3=A4tt, vilka ger anledning att anta att en =
s=C3=B6kande kan komma att avvika.</p>
                           </td>
                        </tr>
                     </tbody>
                  </table>
                  <table width=3D"100%" border=3D"0" cellspacing=3D"0" cell=
padding=3D"0">
                     <colgroup><col width=3D"4%">
                     <col width=3D"96%">
                     </colgroup><tbody>
                        <tr>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">12.</p>
                           </td>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">
                                 <span class=3D"oj-italic">avvikande</span>=
: en handling varigenom en s=C3=B6kande underl=C3=A5ter att f=C3=B6rbli til=
lg=C3=A4nglig f=C3=B6r de beh=C3=B6riga administrativa eller r=C3=A4ttsliga=
 myndigheterna, till exempel genom att l=C3=A4mna medlemsstatens territoriu=
m utan tillst=C3=A5nd fr=C3=A5n de beh=C3=B6riga myndigheterna, av sk=C3=A4=
l som inte ligger utom s=C3=B6kandens kontroll.</p>
                           </td>
                        </tr>
                     </tbody>
                  </table>
                  <table width=3D"100%" border=3D"0" cellspacing=3D"0" cell=
padding=3D"0">
                     <colgroup><col width=3D"4%">
                     <col width=3D"96%">
                     </colgroup><tbody>
                        <tr>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">13.</p>
                           </td>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">
                                 <span class=3D"oj-italic">f=C3=B6retr=C3=
=A4dare</span>: en fysisk person eller en organisation, inbegripet en offen=
tlig myndighet, utsedd av de beh=C3=B6riga myndigheterna, som har den n=C3=
=B6dv=C3=A4ndiga kompetensen och sakkunskapen, =C3=A4ven i&nbsp;fr=C3=A5ga =
om behandling av under=C3=A5riga och deras s=C3=A4rskilda behov, f=C3=B6r a=
tt vid behov f=C3=B6retr=C3=A4da, bist=C3=A5 och agera f=C3=B6r ett ensamko=
mmande barn i&nbsp;syfte att v=C3=A4rna det ensamkommande barnets b=C3=A4st=
a och allm=C3=A4nna v=C3=A4lbefinnande, s=C3=A5 att det ensamkommande barne=
t kan tillvarata r=C3=A4ttigheterna och fullg=C3=B6ra skyldigheterna enligt=
 detta direktiv.</p>
                           </td>
                        </tr>
                     </tbody>
                  </table>
                  <table width=3D"100%" border=3D"0" cellspacing=3D"0" cell=
padding=3D"0">
                     <colgroup><col width=3D"4%">
                     <col width=3D"96%">
                     </colgroup><tbody>
                        <tr>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">14.</p>
                           </td>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">
                                 <span class=3D"oj-italic">s=C3=B6kande med=
 s=C3=A4rskilda mottagandebehov</span>: en s=C3=B6kande som beh=C3=B6ver s=
=C3=A4rskilda villkor eller garantier f=C3=B6r att kunna tillvarata de r=C3=
=A4ttigheter och fullg=C3=B6ra de skyldigheter som anges i&nbsp;detta direk=
tiv.</p>
                           </td>
                        </tr>
                     </tbody>
                  </table>
               </div>
               <div class=3D"eli-subdivision" id=3D"art_3">
                  <p id=3D"d1e872-1-1" class=3D"oj-ti-art">Artikel&nbsp;3</=
p>
                  <div class=3D"eli-title" id=3D"art_3.tit_1">
                     <p class=3D"oj-sti-art">Till=C3=A4mpningsomr=C3=A5de</=
p>
                  </div>
                  <div id=3D"003.001">
                     <p class=3D"oj-normal">1.&nbsp;&nbsp;&nbsp;Detta direk=
tiv =C3=A4r till=C3=A4mpligt p=C3=A5 alla tredjelandsmedborgare och statsl=
=C3=B6sa personer som g=C3=B6r en ans=C3=B6kan om internationellt skydd p=
=C3=A5 medlemsstaternas territorium, inklusive vid den yttre gr=C3=A4nsen, =
i&nbsp;deras territorialvatten eller i&nbsp;ett transitomr=C3=A5de, f=C3=B6=
rutsatt att dessa tredjelandsmedborgare och statsl=C3=B6sa personer f=C3=A5=
r uppeh=C3=A5lla sig p=C3=A5 territoriet i&nbsp;egenskap av s=C3=B6kande. D=
etta direktiv =C3=A4r ocks=C3=A5 till=C3=A4mpligt p=C3=A5 familjemedlemmar =
till en s=C3=B6kande, f=C3=B6rutsatt att dessa familjemedlemmar omfattas av=
 en s=C3=A5dan ans=C3=B6kan om internationellt skydd i&nbsp;enlighet med na=
tionell r=C3=A4tt.</p>
                  </div>
                  <div id=3D"003.002">
                     <p class=3D"oj-normal">2.&nbsp;&nbsp;&nbsp;Detta direk=
tiv =C3=A4r inte till=C3=A4mpligt p=C3=A5 ans=C3=B6kningar om diplomatisk e=
ller territoriell asyl som l=C3=A4mnas in till medlemsstaternas beskickning=
ar.</p>
                  </div>
                  <div id=3D"003.003">
                     <p class=3D"oj-normal">3.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna f=C3=A5r besluta att till=C3=A4mpa detta direktiv vid behandling av an=
s=C3=B6kningar om andra skyddsformer =C3=A4n de som omfattas av f=C3=B6rord=
ning (EU) 2024/1347.</p>
                  </div>
               </div>
               <div class=3D"eli-subdivision" id=3D"art_4">
                  <p id=3D"d1e893-1-1" class=3D"oj-ti-art">Artikel&nbsp;4</=
p>
                  <div class=3D"eli-title" id=3D"art_4.tit_1">
                     <p class=3D"oj-sti-art">Mer f=C3=B6rm=C3=A5nliga best=
=C3=A4mmelser</p>
                  </div>
                  <p class=3D"oj-normal">Medlemsstaterna f=C3=A5r inf=C3=B6=
ra eller bibeh=C3=A5lla mer f=C3=B6rm=C3=A5nliga best=C3=A4mmelser om motta=
gningsvillkor f=C3=B6r s=C3=B6kande och f=C3=B6r familjemedlemmar och n=C3=
=A4ra sl=C3=A4ktingar till s=C3=B6kande som befinner sig i&nbsp;samma medle=
msstat, f=C3=B6rutsatt att s=C3=A5dana familjemedlemmar och n=C3=A4ra sl=C3=
=A4ktingar =C3=A4r beroende av s=C3=B6kandena, eller av humanit=C3=A4ra sk=
=C3=A4l, f=C3=B6rutsatt att best=C3=A4mmelserna =C3=A4r f=C3=B6renliga med =
detta direktiv.</p>
               </div>
            </div>
            <div id=3D"cpt_II">
               <p id=3D"d1e902-1-1" class=3D"oj-ti-section-1">KAPITEL&nbsp;=
II</p>
               <div class=3D"eli-title" id=3D"cpt_II.tit_1">
                  <p id=3D"L_01346SV.01000101-d-002" class=3D"oj-ti-section=
-2">
                     <span class=3D"oj-bold">ALLM=C3=84NNA BEST=C3=84MMELSE=
R OM MOTTAGNINGSVILLKOR</span>
                  </p>
               </div>
               <div class=3D"eli-subdivision" id=3D"art_5">
                  <p id=3D"d1e910-1-1" class=3D"oj-ti-art">Artikel&nbsp;5</=
p>
                  <div class=3D"eli-title" id=3D"art_5.tit_1">
                     <p class=3D"oj-sti-art">Information</p>
                  </div>
                  <div id=3D"005.001">
                     <p class=3D"oj-normal">1.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna ska s=C3=A5 snart som m=C3=B6jligt och i&nbsp;god tid tillhandah=C3=A5=
lla s=C3=B6kande information om de mottagningsvillkor som anges i&nbsp;dett=
a direktiv, inbegripet information som =C3=A4r specifik f=C3=B6r deras mott=
agningssystem, s=C3=A5 att s=C3=B6kandena i&nbsp;praktiken kan tillvarata r=
=C3=A4ttigheterna och fullg=C3=B6ra de skyldigheter som f=C3=B6reskrivs i&n=
bsp;detta direktiv.</p>
                     <p class=3D"oj-normal">Medlemsstaterna ska i&nbsp;synn=
erhet f=C3=B6rse s=C3=B6kande med standardinformation om de mottagningsvill=
kor som anges i&nbsp;detta direktiv, med hj=C3=A4lp av en f=C3=B6rlaga som =
ska utarbetas av Europeiska unionens asylbyr=C3=A5 (<span class=3D"oj-itali=
c">asylbyr=C3=A5n</span>). Den informationen ska tillhandah=C3=A5llas s=C3=
=A5 snart som m=C3=B6jligt, dock senast tre dagar efter det att ans=C3=B6ka=
n gjordes eller inom tidsfristen f=C3=B6r registreringen av den i&nbsp;enli=
ghet med f=C3=B6rordning (EU) 2024/1348.</p>
                     <p class=3D"oj-normal">Medlemsstaterna ska se till att=
 s=C3=B6kandena informeras om organisationer eller grupper av personer som =
tillhandah=C3=A5ller s=C3=A4rskilt r=C3=A4ttsligt bist=C3=A5nd och bitr=C3=
=A4de, inbegripet information om organisationer eller grupper av personer s=
om tillhandah=C3=A5ller r=C3=A4ttsligt bist=C3=A5nd och bitr=C3=A4de kostna=
dsfritt, och om organisationer som kan bist=C3=A5 eller informera dem om g=
=C3=A4llande mottagningsvillkor, inklusive h=C3=A4lso- och sjukv=C3=A5rd.</=
p>
                  </div>
                  <div id=3D"005.002">
                     <p class=3D"oj-normal">2.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna ska se till att den information som avses i&nbsp;punkt 1 ges skriftlig=
en i&nbsp;en koncis, tydlig, begriplig och l=C3=A4ttillg=C3=A4nglig form, m=
ed anv=C3=A4ndning av ett klart och tydligt spr=C3=A5k, och p=C3=A5 ett spr=
=C3=A5k som s=C3=B6kanden f=C3=B6rst=C3=A5r eller rimligen kan f=C3=B6rv=C3=
=A4ntas f=C3=B6rst=C3=A5. Om n=C3=B6dv=C3=A4ndigt ska den informationen =C3=
=A4ven l=C3=A4mnas muntligen eller, n=C3=A4r s=C3=A5 =C3=A4r l=C3=A4mpligt,=
 i&nbsp;visuell form s=C3=A5som videor eller piktogram, och anpassas till s=
=C3=B6kandens behov.</p>
                     <p class=3D"oj-normal">N=C3=A4r det g=C3=A4ller ensamk=
ommande barn ska medlemsstaterna tillhandah=C3=A5lla den information som av=
ses i&nbsp;punkt 1 p=C3=A5 ett =C3=A5ldersanpassat s=C3=A4tt och p=C3=A5 et=
t s=C3=A4tt som s=C3=A4kerst=C3=A4ller att det ensamkommande barnet f=C3=B6=
rst=C3=A5r den, med hj=C3=A4lp av informationsmaterial som =C3=A4r s=C3=A4r=
skilt anpassat till under=C3=A5riga n=C3=A4r s=C3=A5 =C3=A4r l=C3=A4mpligt.=
 Den informationen ska tillhandah=C3=A5llas i&nbsp;n=C3=A4rvaro av det ensa=
mkommande barnets f=C3=B6retr=C3=A4dare eller den person som =C3=A4r l=C3=
=A4mpad att tillf=C3=A4lligt agera som f=C3=B6retr=C3=A4dare till dess att =
f=C3=B6retr=C3=A4daren har utsetts.</p>
                     <p class=3D"oj-normal">I undantagsfall f=C3=A5r en med=
lemsstat tillhandah=C3=A5lla den information som avses i&nbsp;punkt 1 till =
s=C3=B6kanden genom en muntlig =C3=B6vers=C3=A4ttning eller, n=C3=A4r s=C3=
=A5 =C3=A4r l=C3=A4mpligt, i&nbsp;visuell form s=C3=A5som videor eller pikt=
ogram, om</p>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">a)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">den inte kan ge den=
 informationen skriftligen inom den tidsfrist som anges i&nbsp;den punkten,=
 eftersom det spr=C3=A5k som en s=C3=B6kande f=C3=B6rst=C3=A5r eller rimlig=
en kan f=C3=B6rv=C3=A4ntas f=C3=B6rst=C3=A5 =C3=A4r ett s=C3=A4llsynt spr=
=C3=A5k, och</p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">b)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">den s=C3=B6kanden d=
=C3=A4refter bekr=C3=A4ftar att han eller hon f=C3=B6rst=C3=A5r den informa=
tion som l=C3=A4mnats.</p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                     <p class=3D"oj-normal">I fall som avses i&nbsp;tredje =
stycket ska medlemsstaten s=C3=A5 snart som m=C3=B6jligt skaffa fram en skr=
iftlig =C3=B6vers=C3=A4ttning av den information som avses i&nbsp;punkt 1 o=
ch tillhandah=C3=A5lla s=C3=B6kanden den, utom om det =C3=A4r uppenbart att=
 detta inte l=C3=A4ngre beh=C3=B6vs.</p>
                  </div>
               </div>
               <div class=3D"eli-subdivision" id=3D"art_6">
                  <p id=3D"d1e953-1-1" class=3D"oj-ti-art">Artikel&nbsp;6</=
p>
                  <div class=3D"eli-title" id=3D"art_6.tit_1">
                     <p class=3D"oj-sti-art">Dokumentation</p>
                  </div>
                  <div id=3D"006.001">
                     <p class=3D"oj-normal">1.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna ska se till att s=C3=B6kanden tillhandah=C3=A5lls de handlingar som av=
ses i&nbsp;artikel&nbsp;29.1 i&nbsp;f=C3=B6rordning (EU) 2024/1348.</p>
                  </div>
                  <div id=3D"006.002">
                     <p class=3D"oj-normal">2.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna f=C3=A5r inte kr=C3=A4va att s=C3=B6kande, enbart av det sk=C3=A4let a=
tt de ans=C3=B6ker om internationellt skydd eller enbart p=C3=A5 grund av s=
in nationalitet, ska tillhandah=C3=A5lla on=C3=B6dig eller en oproportioner=
lig m=C3=A4ngd dokumentation eller st=C3=A4lla andra administrativa krav p=
=C3=A5 s=C3=B6kande innan de beviljas de r=C3=A4ttigheter som de har r=C3=
=A4tt till enligt detta direktiv.</p>
                  </div>
                  <div id=3D"006.003">
                     <p class=3D"oj-normal">3.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna f=C3=A5r f=C3=B6rse s=C3=B6kande med en resehandling endast om det upp=
kommer allvarliga humanit=C3=A4ra sk=C3=A4l eller andra tvingande sk=C3=A4l=
 som kr=C3=A4ver deras n=C3=A4rvaro i&nbsp;en annan stat. Resehandlingens g=
iltighet ska vara begr=C3=A4nsad till syftet och den varaktighet som kr=C3=
=A4vs med h=C3=A4nsyn till =C3=A4ndam=C3=A5let f=C3=B6r dess utf=C3=A4rdand=
e.</p>
                  </div>
               </div>
               <div class=3D"eli-subdivision" id=3D"art_7">
                  <p id=3D"d1e974-1-1" class=3D"oj-ti-art">Artikel&nbsp;7</=
p>
                  <div class=3D"eli-title" id=3D"art_7.tit_1">
                     <p class=3D"oj-sti-art">Organisering av mottagningssys=
tem</p>
                  </div>
                  <div id=3D"007.001">
                     <p class=3D"oj-normal">1.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna f=C3=A5r fritt organisera sina mottagningssystem i&nbsp;enlighet med d=
etta direktiv. S=C3=B6kande f=C3=A5r r=C3=B6ra sig fritt inom den ber=C3=B6=
rda medlemsstatens territorium.</p>
                  </div>
                  <div id=3D"007.002">
                     <p class=3D"oj-normal">2.&nbsp;&nbsp;&nbsp;Under f=C3=
=B6ruts=C3=A4ttning att alla s=C3=B6kande faktiskt tillf=C3=B6rs=C3=A4kras =
sina r=C3=A4ttigheter enligt detta direktiv f=C3=A5r medlemsstaterna anvisa=
 s=C3=B6kande till f=C3=B6rl=C3=A4ggningar inom sitt territorium i&nbsp;syf=
te att hantera sina asyl- och mottagningssystem.</p>
                  </div>
                  <div id=3D"007.003">
                     <p class=3D"oj-normal">3.&nbsp;&nbsp;&nbsp;Vid anvisni=
ng eller f=C3=B6rnyad anvisning av s=C3=B6kande till f=C3=B6rl=C3=A4ggninga=
r ska medlemsstaterna beakta objektiva faktorer, inbegripet familjesammanh=
=C3=A5llning som avses i&nbsp;artikel&nbsp;14 och s=C3=B6kandes s=C3=A4rski=
lda mottagandebehov.</p>
                  </div>
                  <div id=3D"007.004">
                     <p class=3D"oj-normal">4.&nbsp;&nbsp;&nbsp;Medlemsstat=
ernas tillhandah=C3=A5llande av materiella mottagningsvillkor f=C3=A5r vill=
koras med att s=C3=B6kandena faktiskt =C3=A4r bosatta p=C3=A5 de f=C3=B6rl=
=C3=A4ggningar som de anvisats till i&nbsp;enlighet med punkt&nbsp;2.</p>
                  </div>
                  <div id=3D"007.005">
                     <p class=3D"oj-normal">5.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna f=C3=A5r ocks=C3=A5 inf=C3=B6ra mekanismer f=C3=B6r att bed=C3=B6ma oc=
h tillgodose sina mottagningssystems behov, inbegripet mekanismer f=C3=B6r =
att verifiera att s=C3=B6kandena faktiskt =C3=A4r bosatta p=C3=A5 de f=C3=
=B6rl=C3=A4ggningar som de anvisats i&nbsp;enlighet med punkt 2.</p>
                  </div>
                  <div id=3D"007.006">
                     <p class=3D"oj-normal">6.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna ska kr=C3=A4va att s=C3=B6kande ger beh=C3=B6riga myndigheter sin aktu=
ella adress, ett telefonnummer p=C3=A5 vilket de kan n=C3=A5s och, om en s=
=C3=A5dan finns, en e-postadress. Medlemsstaterna ska ocks=C3=A5 kr=C3=A4va=
 att s=C3=B6kande s=C3=A5 snart som m=C3=B6jligt meddelar dessa beh=C3=B6ri=
ga myndigheter eventuell =C3=A4ndring av adress, telefonnummer eller e-post=
adress.</p>
                  </div>
                  <div id=3D"007.007">
                     <p class=3D"oj-normal">7.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna ska inte vara skyldiga att fatta administrativa beslut vid till=C3=A4m=
pningen av denna artikel.</p>
                  </div>
               </div>
               <div class=3D"eli-subdivision" id=3D"art_8">
                  <p id=3D"d1e1015-1-1" class=3D"oj-ti-art">Artikel&nbsp;8<=
/p>
                  <div class=3D"eli-title" id=3D"art_8.tit_1">
                     <p class=3D"oj-sti-art">Anvisning av s=C3=B6kande till=
 ett geografiskt omr=C3=A5de</p>
                  </div>
                  <div id=3D"008.001">
                     <p class=3D"oj-normal">1.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna f=C3=A5r anvisa s=C3=B6kande till ett geografiskt omr=C3=A5de inom sit=
t territorium d=C3=A4r de kan r=C3=B6ra sig fritt under hela f=C3=B6rfarand=
et f=C3=B6r internationellt skydd i&nbsp;enlighet med f=C3=B6rordning (EU) =
2024/1348.</p>
                  </div>
                  <div id=3D"008.002">
                     <p class=3D"oj-normal">2.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna f=C3=A5r anvisa s=C3=B6kande till ett geografiskt omr=C3=A5de inom sit=
t territorium enligt punkt 1 endast i&nbsp;syfte att s=C3=A4kerst=C3=A4lla =
en snabb, effektiv och =C3=A4ndam=C3=A5lsenlig behandling av deras ans=C3=
=B6kningar i&nbsp;enlighet med f=C3=B6rordning (EU) 2024/1348 eller f=C3=B6=
r den geografiska f=C3=B6rdelningen av dessa s=C3=B6kande med h=C3=A4nsyn t=
ill kapaciteten i&nbsp;de ber=C3=B6rda geografiska omr=C3=A5dena.</p>
                     <p class=3D"oj-normal">Medlemsstaterna ska i&nbsp;enli=
ghet med artikel&nbsp;5 informera s=C3=B6kande om deras anvisning till ett =
geografiskt omr=C3=A5de, inbegripet om omr=C3=A5dets geografiska gr=C3=A4ns=
er.</p>
                  </div>
                  <div id=3D"008.003">
                     <p class=3D"oj-normal">3.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna ska s=C3=A4kerst=C3=A4lla att s=C3=B6kande har faktisk tillg=C3=A5ng t=
ill sina r=C3=A4ttigheter enligt detta direktiv och till f=C3=B6rfarandegar=
antierna i&nbsp;f=C3=B6rfarandet f=C3=B6r internationellt skydd i&nbsp;det =
geografiska omr=C3=A5de till vilket dessa s=C3=B6kande anvisats. Det geogra=
fiska omr=C3=A5det ska vara tillr=C3=A4ckligt stort, medge tillg=C3=A5ng ti=
ll n=C3=B6dv=C3=A4ndig offentlig infrastruktur och inte p=C3=A5verka s=C3=
=B6kandenas omistliga privatlivssf=C3=A4r.</p>
                  </div>
                  <div id=3D"008.004">
                     <p class=3D"oj-normal">4.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna ska inte vara skyldiga att fatta administrativa beslut vid till=C3=A4m=
pningen av punkt 1.</p>
                  </div>
                  <div id=3D"008.005">
                     <p class=3D"oj-normal">5.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna ska p=C3=A5 beg=C3=A4ran av en s=C3=B6kande bevilja s=C3=B6kanden till=
st=C3=A5nd att tillf=C3=A4lligt l=C3=A4mna det geografiska omr=C3=A5det av =
vederb=C3=B6rligen motiverade br=C3=A5dskande och allvarliga familjesk=C3=
=A4l, eller f=C3=B6r n=C3=B6dv=C3=A4ndig medicinsk behandling som inte =C3=
=A4r tillg=C3=A4nglig inom det geografiska omr=C3=A5det.</p>
                     <p class=3D"oj-normal">Om en s=C3=B6kande l=C3=A4mnar =
det geografiska omr=C3=A5det utan tillst=C3=A5nd f=C3=A5r en medlemsstat in=
te p=C3=A5f=C3=B6ra andra sanktioner =C3=A4n de som f=C3=B6reskrivs enligt =
detta direktiv.</p>
                     <p class=3D"oj-normal">S=C3=B6kanden ska inte beh=C3=
=B6va beg=C3=A4ra tillst=C3=A5nd f=C3=B6r att infinna sig till m=C3=B6ten m=
ed myndigheter och domstolar, om s=C3=B6kandens n=C3=A4rvaro =C3=A4r n=C3=
=B6dv=C3=A4ndig. S=C3=B6kanden ska p=C3=A5 f=C3=B6rhand underr=C3=A4tta de =
beh=C3=B6riga myndigheterna om s=C3=A5dana avtalade m=C3=B6ten.</p>
                  </div>
                  <div id=3D"008.006">
                     <p class=3D"oj-normal">6.&nbsp;&nbsp;&nbsp;Om det, bla=
nd annat till f=C3=B6ljd av en s=C3=B6kandes =C3=B6verklagande eller beg=C3=
=A4ran om pr=C3=B6vning i&nbsp;enlighet med artikel&nbsp;29, har fastst=C3=
=A4llts att en s=C3=B6kande inte har beviljats faktisk tillg=C3=A5ng till s=
ina r=C3=A4ttigheter enligt detta direktiv eller till f=C3=B6rfarandegarant=
ierna i&nbsp;f=C3=B6rfarandet f=C3=B6r internationellt skydd inom det geogr=
afiska omr=C3=A5det, =C3=A4r anvisningen av s=C3=B6kanden till detta geogra=
fiska omr=C3=A5de inte l=C3=A4ngre till=C3=A4mplig.</p>
                  </div>
                  <div id=3D"008.007">
                     <p class=3D"oj-normal">7.&nbsp;&nbsp;&nbsp;Innan denna=
 artikel till=C3=A4mpas ska den ber=C3=B6rda medlemsstaten fastst=C3=A4lla =
villkoren f=C3=B6r till=C3=A4mpningen av denna artikel i&nbsp;nationell r=
=C3=A4tt och underr=C3=A4tta kommissionen och asylbyr=C3=A5n i&nbsp;enlighe=
t med kapitel&nbsp;5 i&nbsp;f=C3=B6rordning (EU) 2021/2303.</p>
                  </div>
               </div>
               <div class=3D"eli-subdivision" id=3D"art_9">
                  <p id=3D"d1e1062-1-1" class=3D"oj-ti-art">Artikel&nbsp;9<=
/p>
                  <div class=3D"eli-title" id=3D"art_9.tit_1">
                     <p class=3D"oj-sti-art">Begr=C3=A4nsningar av r=C3=B6r=
elsefriheten</p>
                  </div>
                  <div id=3D"009.001">
                     <p class=3D"oj-normal">1.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna f=C3=A5r vid behov besluta att en s=C3=B6kande f=C3=A5r bo endast p=C3=
=A5 en best=C3=A4md plats som =C3=A4r anpassad f=C3=B6r att inkvartera s=C3=
=B6kande, av h=C3=A4nsyn till allm=C3=A4n ordning eller f=C3=B6r att effekt=
ivt hindra s=C3=B6kanden fr=C3=A5n att avvika, n=C3=A4r det finns risk f=C3=
=B6r avvikande, s=C3=A4rskilt n=C3=A4r det g=C3=A4ller</p>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">a)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">s=C3=B6kande som =
=C3=A4r skyldiga att befinna sig i&nbsp;en annan medlemsstat i&nbsp;enlighe=
t med artikel&nbsp;17.4 i&nbsp;f=C3=B6rordning (EU) 2024/1351, eller</p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">b)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">s=C3=B6kande som ha=
r =C3=B6verf=C3=B6rts till den medlemsstat d=C3=A4r de =C3=A4r skyldiga att=
 befinna sig i&nbsp;enlighet med artikel&nbsp;17.4 i&nbsp;f=C3=B6rordning (=
EU) 2024/1351, efter att ha avvikit till en annan medlemsstat.</p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                     <p class=3D"oj-normal">N=C3=A4r en s=C3=B6kande har ti=
ll=C3=A5tits att bo endast p=C3=A5 en best=C3=A4md plats i&nbsp;enlighet me=
d denna punkt ska tillhandah=C3=A5llandet av materiella mottagningsvillkor =
vara villkorat av att s=C3=B6kanden faktiskt =C3=A4r bosatt p=C3=A5 den spe=
cifika platsen.</p>
                  </div>
                  <div id=3D"009.002">
                     <p class=3D"oj-normal">2.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna f=C3=A5r vid behov kr=C3=A4va att s=C3=B6kande anm=C3=A4ler sig till d=
e beh=C3=B6riga myndigheterna vid en viss angiven tidpunkt eller med rimlig=
a intervall, utan att det p=C3=A5 ett oproportionerligt s=C3=A4tt p=C3=A5ve=
rkar s=C3=B6kandenas r=C3=A4ttigheter enligt detta direktiv.</p>
                     <p class=3D"oj-normal">S=C3=A5dana anm=C3=A4lningskrav=
 f=C3=A5r inf=C3=B6ras f=C3=B6r att s=C3=A4kerst=C3=A4lla att de beslut som=
 avses i&nbsp;punkt 1 iakttas eller f=C3=B6r att effektivt f=C3=B6rhindra a=
tt s=C3=B6kande avviker.</p>
                  </div>
                  <div id=3D"009.003">
                     <p class=3D"oj-normal">3.&nbsp;&nbsp;&nbsp;P=C3=A5 beg=
=C3=A4ran av s=C3=B6kanden f=C3=A5r medlemsstaterna bevilja s=C3=B6kanden t=
illst=C3=A5nd att tillf=C3=A4lligt bo utanf=C3=B6r den best=C3=A4mda plats =
som anvisats i&nbsp;enlighet med punkt 1. Beslut om s=C3=A5dant tillst=C3=
=A5nd ska fattas p=C3=A5 objektiv och opartisk grund efter pr=C3=B6vning i&=
nbsp;det enskilda =C3=A4rendet och ska motiveras om s=C3=A5dant tillst=C3=
=A5nd inte beviljas.</p>
                     <p class=3D"oj-normal">S=C3=B6kanden ska inte beh=C3=
=B6va beg=C3=A4ra tillst=C3=A5nd f=C3=B6r att infinna sig till m=C3=B6ten m=
ed myndigheter eller domstolar, om s=C3=B6kandens n=C3=A4rvaro =C3=A4r n=C3=
=B6dv=C3=A4ndig. S=C3=B6kanden ska underr=C3=A4tta de beh=C3=B6riga myndigh=
eterna om s=C3=A5dana m=C3=B6ten.</p>
                  </div>
                  <div id=3D"009.004">
                     <p class=3D"oj-normal">4.&nbsp;&nbsp;&nbsp;De beslut s=
om fattats i&nbsp;enlighet med punkterna 1 och 2 ska vara proportionella oc=
h ta h=C3=A4nsyn till relevanta aspekter av s=C3=B6kandens individuella sit=
uation, inbegripet s=C3=B6kandens s=C3=A4rskilda mottagandebehov.</p>
                  </div>
                  <div id=3D"009.005">
                     <p class=3D"oj-normal">5.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna ska i&nbsp;varje beslut som fattas i&nbsp;enlighet med punkterna 1 och=
 2 i&nbsp;denna artikel i&nbsp;det beslutet ange de saksk=C3=A4l och i&nbsp=
;f=C3=B6rekommande fall r=C3=A4ttsliga sk=C3=A4l som legat till grund f=C3=
=B6r det beslutet. S=C3=B6kande ska underr=C3=A4ttas skriftligt om ett s=C3=
=A5dant beslut samt om f=C3=B6rfarandena f=C3=B6r att =C3=B6verklaga beslut=
et i&nbsp;enlighet med artikel&nbsp;29 och om f=C3=B6ljderna av att inte ef=
terleva de skyldigheter som beslutet inneb=C3=A4r. Medlemsstaterna ska ge s=
=C3=B6kandena denna information p=C3=A5 ett spr=C3=A5k som de f=C3=B6rst=C3=
=A5r eller rimligen kan f=C3=B6rv=C3=A4ntas f=C3=B6rst=C3=A5 och i&nbsp;en =
koncis, tydlig, begriplig och l=C3=A4ttillg=C3=A4nglig form med anv=C3=A4nd=
ning av ett klart och tydligt spr=C3=A5k. Medlemsstaterna ska s=C3=A4kerst=
=C3=A4lla att de beslut som fattas i&nbsp;enlighet med den h=C3=A4r artikel=
n pr=C3=B6vas av en r=C3=A4ttslig myndighet p=C3=A5 eget initiativ n=C3=A4r=
 besluten har till=C3=A4mpats i&nbsp;mer =C3=A4n tv=C3=A5 m=C3=A5nader, ell=
er att besluten kan =C3=B6verklagas p=C3=A5 beg=C3=A4ran av den ber=C3=B6rd=
a s=C3=B6kanden i&nbsp;enlighet med artikel&nbsp;29.</p>
                  </div>
               </div>
               <div class=3D"eli-subdivision" id=3D"art_10">
                  <p id=3D"d1e1113-1-1" class=3D"oj-ti-art">Artikel&nbsp;10=
</p>
                  <div class=3D"eli-title" id=3D"art_10.tit_1">
                     <p class=3D"oj-sti-art">F=C3=B6rvar</p>
                  </div>
                  <div id=3D"010.001">
                     <p class=3D"oj-normal">1.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna f=C3=A5r inte h=C3=A5lla en person i&nbsp;f=C3=B6rvar av enbart det sk=
=C3=A4let att personen =C3=A4r en s=C3=B6kande eller p=C3=A5 grund av den s=
=C3=B6kandens nationalitet. F=C3=B6rvar ska endast grundas p=C3=A5 en eller=
 flera av de grunder f=C3=B6r f=C3=B6rvar som anges i&nbsp;punkt 4. F=C3=B6=
rvar ska inte vara av straffr=C3=A4ttslig karakt=C3=A4r.</p>
                  </div>
                  <div id=3D"010.002">
                     <p class=3D"oj-normal">2.&nbsp;&nbsp;&nbsp;Om det p=C3=
=A5 grundval av en individuell bed=C3=B6mning av ett =C3=A4rende visar sig =
n=C3=B6dv=C3=A4ndigt f=C3=A5r en medlemsstat besluta att ta en s=C3=B6kande=
 i&nbsp;f=C3=B6rvar, om mindre ingripande =C3=A5tg=C3=A4rder inte kan till=
=C3=A4mpas verkningsfullt.</p>
                  </div>
                  <div id=3D"010.003">
                     <p class=3D"oj-normal">3.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna ska, n=C3=A4r de tar en s=C3=B6kande i&nbsp;f=C3=B6rvar, ta h=C3=A4nsy=
n till alla eventuella synliga tecken, utsagor eller beteenden som tyder p=
=C3=A5 att s=C3=B6kanden har s=C3=A4rskilda mottagandebehov. Om den bed=C3=
=B6mning som anges i&nbsp;artikel&nbsp;25 =C3=A4nnu inte har slutf=C3=B6rts=
, ska den slutf=C3=B6ras utan on=C3=B6digt dr=C3=B6jsm=C3=A5l, och resultat=
en av den ska beaktas n=C3=A4r beslut fattas om huruvida personen i&nbsp;fr=
=C3=A5ga fortsatt ska h=C3=A5llas i&nbsp;f=C3=B6rvar eller om f=C3=B6rh=C3=
=A5llandena f=C3=B6r f=C3=B6rvaret beh=C3=B6ver justeras.</p>
                  </div>
                  <div id=3D"010.004">
                     <p class=3D"oj-normal">4.&nbsp;&nbsp;&nbsp;En s=C3=B6k=
ande f=C3=A5r tas i&nbsp;f=C3=B6rvar endast p=C3=A5 grundval av ett eller f=
lera av f=C3=B6ljande sk=C3=A4l:</p>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">a)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">F=C3=B6r att best=
=C3=A4mma eller bekr=C3=A4fta s=C3=B6kandens identitet eller nationalitet.<=
/p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">b)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">F=C3=B6r att fastst=
=C3=A4lla de faktorer som ans=C3=B6kan om internationellt skydd grundas p=
=C3=A5, som inte skulle kunna klarg=C3=B6ras utan att ta s=C3=B6kanden i&nb=
sp;f=C3=B6rvar, s=C3=A4rskilt om det finns en risk f=C3=B6r avvikande.</p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">c)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">F=C3=B6r att s=C3=
=A4kerst=C3=A4lla efterlevnad av r=C3=A4ttsliga skyldigheter som har =C3=A5=
lagts s=C3=B6kanden genom ett individuellt beslut i&nbsp;enlighet med artik=
el&nbsp;9.1 i&nbsp;fall d=C3=A4r s=C3=B6kanden inte har efterlevt s=C3=A5da=
na skyldigheter och det fortfarande finns en risk f=C3=B6r avvikande.</p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">d)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">Som ett led i&nbsp;=
ett gr=C3=A4nsf=C3=B6rfarande i&nbsp;enlighet med artikel&nbsp;43 i&nbsp;f=
=C3=B6rordning (EU) 2024/1348 f=C3=B6r att avg=C3=B6ra om s=C3=B6kanden har=
 r=C3=A4tt att resa in p=C3=A5 territoriet.</p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">e)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">Om s=C3=B6kanden h=
=C3=A5lls i&nbsp;f=C3=B6rvar p=C3=A5 grund av ett f=C3=B6rfarande f=C3=B6r =
=C3=A5terv=C3=A4ndande enligt Europaparlamentets och r=C3=A5dets direktiv 2=
008/115/EG&nbsp;<a id=3D"ntc14-L_202401346SV.000101-E0014" href=3D"https://=
eur-lex.europa.eu/legal-content/SV/TXT/HTML/?uri=3DOJ:L_202401346#ntr14-L_2=
02401346SV.000101-E0014">(<span class=3D"oj-super oj-note-tag">14</span>)</=
a>, f=C3=B6r att f=C3=B6rbereda =C3=A5terv=C3=A4ndandet eller f=C3=B6r att =
genomf=C3=B6ra avl=C3=A4gsnandet och den ber=C3=B6rda medlemsstaten p=C3=A5=
 grundval av objektiva kriterier, inbegripet att s=C3=B6kanden redan haft m=
=C3=B6jlighet att f=C3=A5 tillg=C3=A5ng till f=C3=B6rfarandet f=C3=B6r inte=
rnationellt skydd, kan styrka att det finns rimliga sk=C3=A4l att anta att =
s=C3=B6kanden g=C3=B6r ans=C3=B6kan om internationellt skydd enbart f=C3=B6=
r att f=C3=B6rsena eller hindra verkst=C3=A4lligheten av beslutet om =C3=A5=
ters=C3=A4ndande.</p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">f)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">Om det =C3=A4r n=C3=
=B6dv=C3=A4ndigt f=C3=B6r att skydda nationell s=C3=A4kerhet eller allm=C3=
=A4n ordning.</p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">g)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">I enlighet med arti=
kel&nbsp;44 i&nbsp;f=C3=B6rordning (EU) 2024/1351.</p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                     <p class=3D"oj-normal">De grunder f=C3=B6r f=C3=B6rvar=
 som avses i&nbsp;f=C3=B6rsta stycket ska fastst=C3=A4llas i&nbsp;nationell=
 r=C3=A4tt.</p>
                  </div>
                  <div id=3D"010.005">
                     <p class=3D"oj-normal">5.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna ska s=C3=A4kerst=C3=A4lla att regler om alternativ till f=C3=B6rvar, t=
ill exempel regelbunden rapportering till myndigheterna, st=C3=A4llandet av=
 en finansiell s=C3=A4kerhet eller en skyldighet att stanna p=C3=A5 en best=
=C3=A4md plats, fastst=C3=A4lls i&nbsp;nationell r=C3=A4tt.</p>
                  </div>
               </div>
               <div class=3D"eli-subdivision" id=3D"art_11">
                  <p id=3D"d1e1200-1-1" class=3D"oj-ti-art">Artikel&nbsp;11=
</p>
                  <div class=3D"eli-title" id=3D"art_11.tit_1">
                     <p class=3D"oj-sti-art">Garantier f=C3=B6r s=C3=B6kand=
e som tas i&nbsp;f=C3=B6rvar</p>
                  </div>
                  <div id=3D"011.001">
                     <p class=3D"oj-normal">1.&nbsp;&nbsp;&nbsp;En s=C3=B6k=
ande ska endast h=C3=A5llas i&nbsp;f=C3=B6rvar s=C3=A5 kort tid som m=C3=B6=
jligt, och ska h=C3=A5llas i&nbsp;f=C3=B6rvar bara s=C3=A5 l=C3=A4nge grund=
erna i&nbsp;artikel&nbsp;10.4 =C3=A4r till=C3=A4mpliga.</p>
                     <p class=3D"oj-normal">De administrativa f=C3=B6rfaran=
dena avseende grunderna f=C3=B6r f=C3=B6rvar i&nbsp;artikel&nbsp;10.4 ska u=
tf=C3=B6ras med tillb=C3=B6rlig skyndsamhet och noggrannhet. F=C3=B6rsening=
ar i&nbsp;administrativa f=C3=B6rfaranden som inte kan tillskrivas s=C3=B6k=
anden ber=C3=A4ttigar inte fortsatt f=C3=B6rvar.</p>
                  </div>
                  <div id=3D"011.002">
                     <p class=3D"oj-normal">2.&nbsp;&nbsp;&nbsp;Beslut om f=
=C3=B6rvar av s=C3=B6kande ska fattas skriftligen av r=C3=A4ttsliga eller a=
dministrativa myndigheter. I&nbsp;beslutet om f=C3=B6rvar ska de faktiska o=
ch r=C3=A4ttsliga sk=C3=A4l beslutet grundar sig p=C3=A5 anges, liksom varf=
=C3=B6r mindre ingripande =C3=A5tg=C3=A4rder inte kan till=C3=A4mpas verkni=
ngsfullt.</p>
                  </div>
                  <div id=3D"011.003">
                     <p class=3D"oj-normal">3.&nbsp;&nbsp;&nbsp;Om beslut o=
m f=C3=B6rvar fattas av en administrativ myndighet ska medlemsstaterna ombe=
s=C3=B6rja att en snabb r=C3=A4ttslig pr=C3=B6vning av f=C3=B6rvarsbeslutet=
s laglighet utf=C3=B6rs p=C3=A5 eget initiativ eller p=C3=A5 beg=C3=A4ran a=
v s=C3=B6kanden eller b=C3=A5dadera. Om pr=C3=B6vningen sker p=C3=A5 eget i=
nitiativ ska den slutf=C3=B6ras s=C3=A5 snart som m=C3=B6jligt, med beaktan=
de av omst=C3=A4ndigheterna i&nbsp;varje enskilt fall, dock senast 15 dagar=
, eller i&nbsp;undantagsfall senast 21 dagar, efter det att s=C3=B6kanden t=
agits i&nbsp;f=C3=B6rvar. Om pr=C3=B6vningen sker p=C3=A5 beg=C3=A4ran av s=
=C3=B6kanden ska den slutf=C3=B6ras s=C3=A5 snart som m=C3=B6jligt, med bea=
ktande av omst=C3=A4ndigheterna i&nbsp;varje enskilt fall, dock senast 15 d=
agar, eller i&nbsp;undantagsfall senast 21 dagar, efter det att de aktuella=
 f=C3=B6rfarandena inletts.</p>
                     <p class=3D"oj-normal">Om den r=C3=A4ttsliga pr=C3=B6v=
ning som avses i&nbsp;f=C3=B6rsta stycket, n=C3=A4r den utf=C3=B6rs p=C3=A5=
 eget initiativ, inte har slutf=C3=B6rts inom 21 dagar efter det att s=C3=
=B6kanden tagits i&nbsp;f=C3=B6rvar eller, n=C3=A4r den utf=C3=B6rs p=C3=A5=
 beg=C3=A4ran av s=C3=B6kanden, inte har slutf=C3=B6rts inom 21 dagar fr=C3=
=A5n det att de aktuella f=C3=B6rfarandena inletts, ska s=C3=B6kanden i&nbs=
p;fr=C3=A5ga omedelbart friges.</p>
                  </div>
                  <div id=3D"011.004">
                     <p class=3D"oj-normal">4.&nbsp;&nbsp;&nbsp;S=C3=B6kand=
e som tagits i&nbsp;f=C3=B6rvar ska omedelbart, p=C3=A5 ett spr=C3=A5k de f=
=C3=B6rst=C3=A5r eller rimligen kan f=C3=B6rv=C3=A4ntas f=C3=B6rst=C3=A5, s=
kriftligen underr=C3=A4ttas om sk=C3=A4len f=C3=B6r f=C3=B6rvar och vilka f=
=C3=B6rfaranden f=C3=B6r =C3=B6verklagande av beslutet om f=C3=B6rvar som a=
nges i&nbsp;nationell r=C3=A4tt samt om m=C3=B6jligheten att beg=C3=A4ra ko=
stnadsfritt r=C3=A4ttsligt bist=C3=A5nd och bitr=C3=A4de.</p>
                  </div>
                  <div id=3D"011.005">
                     <p class=3D"oj-normal">5.&nbsp;&nbsp;&nbsp;F=C3=B6rvar=
et ska ompr=C3=B6vas av en r=C3=A4ttslig myndighet med l=C3=A4mpliga tidsin=
tervall, p=C3=A5 eget initiativ eller p=C3=A5 beg=C3=A4ran av den ber=C3=B6=
rda s=C3=B6kanden, i&nbsp;synnerhet om personen h=C3=A5lls i&nbsp;f=C3=B6rv=
ar en l=C3=A4ngre tid, om det uppst=C3=A5r relevanta omst=C3=A4ndigheter el=
ler kommer fram nya uppgifter som kan p=C3=A5verka f=C3=B6rvarets laglighet=
.</p>
                     <p class=3D"oj-normal">Utan att det p=C3=A5verkar till=
=C3=A4mpningen av f=C3=B6rsta stycket ska f=C3=B6rvar av ensamkommande barn=
 ompr=C3=B6vas p=C3=A5 eget initiativ med regelbundna intervall.</p>
                     <p class=3D"oj-normal">Om f=C3=B6rvaret, som en f=C3=
=B6ljd av den r=C3=A4ttsliga pr=C3=B6vningen, konstateras vara olagligt, sk=
a s=C3=B6kanden i&nbsp;fr=C3=A5ga omedelbart friges.</p>
                  </div>
                  <div id=3D"011.006">
                     <p class=3D"oj-normal">6.&nbsp;&nbsp;&nbsp;Vid r=C3=A4=
ttslig pr=C3=B6vning av beslutet om f=C3=B6rvar enligt punkterna 3 och 5 i&=
nbsp;denna artikel ska medlemsstaterna se till att s=C3=B6kandena har tillg=
=C3=A5ng till kostnadsfritt r=C3=A4ttsligt bist=C3=A5nd och bitr=C3=A4de en=
ligt de villkor som fastst=C3=A4lls i&nbsp;artikel&nbsp;29.</p>
                  </div>
               </div>
               <div class=3D"eli-subdivision" id=3D"art_12">
                  <p id=3D"d1e1244-1-1" class=3D"oj-ti-art">Artikel&nbsp;12=
</p>
                  <div class=3D"eli-title" id=3D"art_12.tit_1">
                     <p class=3D"oj-sti-art">F=C3=B6rh=C3=A5llanden f=C3=B6=
r f=C3=B6rvar</p>
                  </div>
                  <div id=3D"012.001">
                     <p class=3D"oj-normal">1.&nbsp;&nbsp;&nbsp;F=C3=B6rvar=
 av s=C3=B6kande ska, som regel, ske i&nbsp;s=C3=A4rskilda f=C3=B6rvarsanl=
=C3=A4ggningar. Om en medlemsstat inte kan tillhandah=C3=A5lla inkvartering=
 i&nbsp;en s=C3=A4rskild f=C3=B6rvarsanl=C3=A4ggning, utan m=C3=A5ste anv=
=C3=A4nda f=C3=A4ngelseanl=C3=A4ggningar, ska s=C3=B6kande som h=C3=A5lls i=
&nbsp;f=C3=B6rvar h=C3=A5llas avskilda fr=C3=A5n =C3=B6vriga interner och d=
e f=C3=B6rh=C3=A5llanden f=C3=B6r f=C3=B6rvar som f=C3=B6reskrivs i&nbsp;de=
tta direktiv ska till=C3=A4mpas.</p>
                     <p class=3D"oj-normal">S=C3=B6kande som h=C3=A5lls i&n=
bsp;f=C3=B6rvar ska i&nbsp;s=C3=A5 stor utstr=C3=A4ckning som m=C3=B6jligt =
h=C3=A5llas avskilda fr=C3=A5n andra tredjelandsmedborgare som inte l=C3=A4=
mnat in en ans=C3=B6kan om internationellt skydd.</p>
                     <p class=3D"oj-normal">Om s=C3=B6kande inte kan h=C3=
=A5llas i&nbsp;f=C3=B6rvar avskilda fr=C3=A5n andra tredjelandsmedborgare, =
ska den ber=C3=B6rda medlemsstaten s=C3=A4kerst=C3=A4lla att de f=C3=B6rh=
=C3=A5llanden f=C3=B6r f=C3=B6rvar som f=C3=B6reskrivs i&nbsp;detta direkti=
v till=C3=A4mpas.</p>
                  </div>
                  <div id=3D"012.002">
                     <p class=3D"oj-normal">2.&nbsp;&nbsp;&nbsp;S=C3=B6kand=
e som h=C3=A5lls i&nbsp;f=C3=B6rvar ska ha tillg=C3=A5ng till utomhusomr=C3=
=A5den.</p>
                  </div>
                  <div id=3D"012.003">
                     <p class=3D"oj-normal">3.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna ska se till att f=C3=B6retr=C3=A4dare f=C3=B6r F=C3=B6renta nationerna=
s flyktingkommissarie (UNHCR) har m=C3=B6jlighet att kommunicera med och be=
s=C3=B6ka s=C3=B6kande under f=C3=B6rh=C3=A5llanden som respekterar avskild=
het. Denna m=C3=B6jlighet ska =C3=A4ven g=C3=A4lla f=C3=B6r organisationer =
som p=C3=A5 UNHCR:s v=C3=A4gnar, efter =C3=B6verenskommelse med den ber=C3=
=B6rda medlemsstaten, =C3=A4r verksamma p=C3=A5 medlemsstatens territorium.=
</p>
                  </div>
                  <div id=3D"012.004">
                     <p class=3D"oj-normal">4.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna ska se till att familjemedlemmar, juridiska r=C3=A5dgivare och persone=
r som f=C3=B6retr=C3=A4der ber=C3=B6rda icke-statliga organisationer som er=
k=C3=A4nts av medlemsstaten i&nbsp;fr=C3=A5ga ges m=C3=B6jlighet att kommun=
icera med och bes=C3=B6ka s=C3=B6kandena under f=C3=B6rh=C3=A5llanden som r=
espekterar avskildhet. Begr=C3=A4nsningar i&nbsp;tilltr=C3=A4det till f=C3=
=B6rvarsanl=C3=A4ggningar f=C3=A5r endast inf=C3=B6ras om det enligt nation=
ell r=C3=A4tt objektivt =C3=A4r n=C3=B6dv=C3=A4ndigt av h=C3=A4nsyn till s=
=C3=A4kerhet, allm=C3=A4n ordning eller den administrativa driften av f=C3=
=B6rvarsanl=C3=A4ggningen, f=C3=B6rutsatt att tilltr=C3=A4det inte begr=C3=
=A4nsas mycket kraftigt eller om=C3=B6jligg=C3=B6rs helt.</p>
                  </div>
                  <div id=3D"012.005">
                     <p class=3D"oj-normal">5.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna ska se till att s=C3=B6kande som h=C3=A5lls i&nbsp;f=C3=B6rvar systema=
tiskt tillhandah=C3=A5lls information som f=C3=B6rklarar de regler som till=
=C3=A4mpas inom anl=C3=A4ggningen och som beskriver dessa s=C3=B6kandes r=
=C3=A4ttigheter och skyldigheter p=C3=A5 ett spr=C3=A5k som de f=C3=B6rst=
=C3=A5r eller rimligen kan f=C3=B6rv=C3=A4ntas f=C3=B6rst=C3=A5. Om en s=C3=
=B6kande h=C3=A5lls i&nbsp;f=C3=B6rvar vid en gr=C3=A4ns=C3=B6verg=C3=A5ng =
eller i&nbsp;ett transitomr=C3=A5de f=C3=A5r medlemsstaterna avvika fr=C3=
=A5n denna skyldighet i&nbsp;vederb=C3=B6rligen motiverade fall under en ri=
mlig tidsperiod som ska vara s=C3=A5 kort som m=C3=B6jligt. Denna avvikelse=
 ska inte g=C3=A4lla i&nbsp;de fall som avses i&nbsp;artikel&nbsp;43 i&nbsp=
;f=C3=B6rordning (EU) 2024/1348.</p>
                  </div>
               </div>
               <div class=3D"eli-subdivision" id=3D"art_13">
                  <p id=3D"d1e1279-1-1" class=3D"oj-ti-art">Artikel&nbsp;13=
</p>
                  <div class=3D"eli-title" id=3D"art_13.tit_1">
                     <p class=3D"oj-sti-art">F=C3=B6rvar av s=C3=B6kande me=
d s=C3=A4rskilda mottagandebehov</p>
                  </div>
                  <div id=3D"013.001">
                     <p class=3D"oj-normal">1.&nbsp;&nbsp;&nbsp;H=C3=A4lsan=
, inklusive den psykiska h=C3=A4lsan, hos s=C3=B6kande i&nbsp;f=C3=B6rvar s=
om har s=C3=A4rskilda mottagandebehov ska vara en fr=C3=A5ga av st=C3=B6rst=
a vikt f=C3=B6r de nationella myndigheterna.</p>
                     <p class=3D"oj-normal">Om f=C3=B6rvar av s=C3=B6kande =
med s=C3=A4rskilda mottagandebehov skulle utg=C3=B6ra en allvarlig risk f=
=C3=B6r deras fysiska och psykiska h=C3=A4lsa ska dessa s=C3=B6kande inte t=
as i&nbsp;f=C3=B6rvar.</p>
                     <p class=3D"oj-normal">Om s=C3=B6kande med s=C3=A4rski=
lda mottagandebehov tas i&nbsp;f=C3=B6rvar ska medlemsstaterna se till att =
de h=C3=A5lls under regelbunden uppsikt och i&nbsp;god tid ges l=C3=A4mplig=
t st=C3=B6d med h=C3=A4nsyn till deras speciella situation, inklusive deras=
 fysiska och psykiska h=C3=A4lsa.</p>
                  </div>
                  <div id=3D"013.002">
                     <p class=3D"oj-normal">2.&nbsp;&nbsp;&nbsp;Under=C3=A5=
riga f=C3=A5r som regel inte tas i&nbsp;f=C3=B6rvar. De ska placeras i&nbsp=
;l=C3=A4mplig inkvartering i&nbsp;enlighet med artiklarna&nbsp;26 och 27.</=
p>
                     <p class=3D"oj-normal">L=C3=A4mpliga alternativ till f=
=C3=B6rvar ska som regel anv=C3=A4ndas f=C3=B6r familjer med under=C3=A5rig=
a i&nbsp;enlighet med principen om familjesammanh=C3=A5llning. S=C3=A5dana =
familjer ska inkvarteras p=C3=A5 ett s=C3=A4tt som l=C3=A4mpar sig f=C3=B6r=
 dem.</p>
                     <p class=3D"oj-normal">I undantagsfall f=C3=A5r under=
=C3=A5riga, som en sista utv=C3=A4g, sedan det har konstaterats att andra, =
mindre ingripande alternativa =C3=A5tg=C3=A4rder inte kan till=C3=A4mpas ve=
rkningsfullt, och efter att f=C3=B6rvar bed=C3=B6mts vara f=C3=B6r deras eg=
et b=C3=A4sta i&nbsp;enlighet med artikel&nbsp;26, tas i&nbsp;f=C3=B6rvar</=
p>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">a)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">i fall med medf=C3=
=B6ljande barn, om barnets f=C3=B6r=C3=A4lder eller huvudsakliga omsorgsper=
son h=C3=A5lls i&nbsp;f=C3=B6rvar, eller</p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">b)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">i fall med ensamkom=
mande barn, om f=C3=B6rvaret skyddar barnet.</p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                     <p class=3D"oj-normal">Detta f=C3=B6rvar ska begr=C3=
=A4nsas till en s=C3=A5 kort tid som m=C3=B6jligt. Under=C3=A5riga ska aldr=
ig h=C3=A5llas i&nbsp;f=C3=B6rvar i&nbsp;f=C3=A4ngelse eller n=C3=A5gon ann=
an anl=C3=A4ggning som anv=C3=A4nds f=C3=B6r brottsbek=C3=A4mpande =C3=A4nd=
am=C3=A5l. Alla =C3=A5tg=C3=A4rder ska vidtas f=C3=B6r att frige under=C3=
=A5riga som h=C3=A5lls i&nbsp;f=C3=B6rvar och placera dem i&nbsp;inkvarteri=
ng som =C3=A4r l=C3=A4mplig f=C3=B6r under=C3=A5riga.</p>
                     <p class=3D"oj-normal">Medlemsstaterna ska i&nbsp;f=C3=
=B6rsta hand beakta vad som bed=C3=B6ms vara barnets b=C3=A4sta, i&nbsp;enl=
ighet med artikel&nbsp;26.</p>
                     <p class=3D"oj-normal">Under=C3=A5riga som h=C3=A5lls =
i&nbsp;f=C3=B6rvar ska ha r=C3=A4tt till utbildning i&nbsp;enlighet med art=
ikel&nbsp;16, s=C3=A5vida inte tillhandah=C3=A5llandet av utbildning =C3=A4=
r av begr=C3=A4nsat v=C3=A4rde f=C3=B6r dem p=C3=A5 grund av att de h=C3=A5=
lls i&nbsp;f=C3=B6rvar under mycket kort tid. S=C3=A5dana under=C3=A5riga s=
ka ocks=C3=A5 ha m=C3=B6jlighet att delta i&nbsp;fritidsverksamhet, inbegri=
pet lekar och fritidsaktiviteter som l=C3=A4mpar sig f=C3=B6r deras =C3=A5l=
der.</p>
                  </div>
                  <div id=3D"013.003">
                     <p class=3D"oj-normal">3.&nbsp;&nbsp;&nbsp;Om ensamkom=
mande barn h=C3=A5lls i&nbsp;f=C3=B6rvar ska de inkvarteras i&nbsp;lokaler =
som =C3=A4r anpassade till inkvartering av ensamkommande barn. S=C3=A5dana =
anl=C3=A4ggningar ska ha personal som =C3=A4r kvalificerad att skydda r=C3=
=A4ttigheterna f=C3=B6r ensamkommande barn och tillgodose deras behov.</p>
                     <p class=3D"oj-normal">Om ensamkommande barn h=C3=A5ll=
s i&nbsp;f=C3=B6rvar ska medlemsstaterna se till att de inkvarteras avskilt=
 fr=C3=A5n vuxna.</p>
                  </div>
                  <div id=3D"013.004">
                     <p class=3D"oj-normal">4.&nbsp;&nbsp;&nbsp;Familjer so=
m h=C3=A5lls i&nbsp;f=C3=B6rvar ska erbjudas avskild inkvartering som garan=
terar dem ett l=C3=A4mpligt skydd f=C3=B6r sitt privatliv.</p>
                     <p class=3D"oj-normal">Familjer med under=C3=A5riga so=
m h=C3=A5lls i&nbsp;f=C3=B6rvar ska inkvarteras i&nbsp;f=C3=B6rvarsanl=C3=
=A4ggningar som =C3=A4r anpassade till under=C3=A5rigas behov.</p>
                  </div>
                  <div id=3D"013.005">
                     <p class=3D"oj-normal">5.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna ska se till att manliga och kvinnliga s=C3=B6kande som h=C3=A5lls i&nb=
sp;f=C3=B6rvar inkvarteras separat, s=C3=A5vida dessa s=C3=B6kande som h=C3=
=A5lls i&nbsp;f=C3=B6rvar inte =C3=A4r familjemedlemmar och alla ber=C3=B6r=
da personer samtycker till att inkvarteras tillsammans.</p>
                     <p class=3D"oj-normal">Undantag fr=C3=A5n f=C3=B6rsta =
stycket f=C3=A5r =C3=A4ven medges f=C3=B6r anv=C3=A4ndning av gemensamma ut=
rymmen avsedda f=C3=B6r fritidsverksamhet eller sociala aktiviteter, inklus=
ive m=C3=A5ltider.</p>
                  </div>
                  <div id=3D"013.006">
                     <p class=3D"oj-normal">6.&nbsp;&nbsp;&nbsp;Om s=C3=B6k=
anden h=C3=A5lls i&nbsp;f=C3=B6rvar vid en gr=C3=A4ns=C3=B6verg=C3=A5ng ell=
er i&nbsp;ett transitomr=C3=A5de, med undantag f=C3=B6r de fall som avses i=
&nbsp;artikel&nbsp;43 i&nbsp;f=C3=B6rordning (EU) 2024/1348, f=C3=A5r medle=
msstaterna avvika fr=C3=A5n punkt 3 f=C3=B6rsta stycket, punkt 4 och punkt =
5 f=C3=B6rsta stycket i&nbsp;vederb=C3=B6rligen motiverade fall under en ri=
mlig tidsperiod, som ska vara s=C3=A5 kort som m=C3=B6jligt. Medlemsstatern=
a ska ha tillr=C3=A4ckliga anl=C3=A4ggningar och resurser f=C3=B6r att s=C3=
=A4kerst=C3=A4lla att de undantag som f=C3=B6reskrivs i&nbsp;den h=C3=A4r p=
unkten endast till=C3=A4mpas i&nbsp;undantagsfall. Vid till=C3=A4mpning av =
dessa undantag ska medlemsstaterna underr=C3=A4tta kommissionen och asylbyr=
=C3=A5n om detta.</p>
                  </div>
               </div>
               <div class=3D"eli-subdivision" id=3D"art_14">
                  <p id=3D"d1e1349-1-1" class=3D"oj-ti-art">Artikel&nbsp;14=
</p>
                  <div class=3D"eli-title" id=3D"art_14.tit_1">
                     <p class=3D"oj-sti-art">Familjer</p>
                  </div>
                  <p class=3D"oj-normal">Om en medlemsstat tillhandah=C3=A5=
ller en bostad till s=C3=B6kande, ska den vidta l=C3=A4mpliga =C3=A5tg=C3=
=A4rder till st=C3=B6d f=C3=B6r st=C3=B6rsta m=C3=B6jliga sammanh=C3=A5llni=
ng av de familjer som befinner sig p=C3=A5 dess territorium. S=C3=A5dana =
=C3=A5tg=C3=A4rder ska vidtas med s=C3=B6kandens medgivande.</p>
               </div>
               <div class=3D"eli-subdivision" id=3D"art_15">
                  <p id=3D"d1e1358-1-1" class=3D"oj-ti-art">Artikel&nbsp;15=
</p>
                  <div class=3D"eli-title" id=3D"art_15.tit_1">
                     <p class=3D"oj-sti-art">H=C3=A4lsounders=C3=B6kningar<=
/p>
                  </div>
                  <p class=3D"oj-normal">Medlemsstaterna f=C3=A5r beg=C3=A4=
ra att s=C3=B6kande ska genomg=C3=A5 h=C3=A4lsounders=C3=B6kning av folkh=
=C3=A4lsosk=C3=A4l.</p>
               </div>
               <div class=3D"eli-subdivision" id=3D"art_16">
                  <p id=3D"d1e1366-1-1" class=3D"oj-ti-art">Artikel&nbsp;16=
</p>
                  <div class=3D"eli-title" id=3D"art_16.tit_1">
                     <p class=3D"oj-sti-art">Under=C3=A5rigas skolg=C3=A5ng=
 och utbildning</p>
                  </div>
                  <div id=3D"016.001">
                     <p class=3D"oj-normal">1.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna ska bevilja under=C3=A5riga barn till s=C3=B6kande och under=C3=A5riga=
 s=C3=B6kande samma tilltr=C3=A4de till utbildning som de egna medborgarna =
och p=C3=A5 liknande villkor, s=C3=A5 l=C3=A4nge som en utvisnings=C3=A5tg=
=C3=A4rd mot s=C3=A5dana under=C3=A5riga eller deras f=C3=B6r=C3=A4ldrar in=
te faktiskt har verkst=C3=A4llts.</p>
                     <p class=3D"oj-normal">De s=C3=A4rskilda behoven f=C3=
=B6r under=C3=A5riga, i&nbsp;synnerhet med avseende p=C3=A5 respekten f=C3=
=B6r barnets r=C3=A4tt till utbildning och tillg=C3=A5ng till h=C3=A4lso- o=
ch sjukv=C3=A5rd, ska beaktas. Utbildningen av under=C3=A5riga ska som rege=
l vara integrerad med utbildningen f=C3=B6r medlemsstaternas egna medborgar=
e och vara av samma kvalitet. Medlemsstaterna ska g=C3=B6ra sitt yttersta f=
=C3=B6r att s=C3=A4kerst=C3=A4lla kontinuiteten i&nbsp;utbildningen av unde=
r=C3=A5riga s=C3=A5 l=C3=A4nge som en utvisnings=C3=A5tg=C3=A4rd mot dem el=
ler deras f=C3=B6r=C3=A4ldrar inte faktiskt har verkst=C3=A4llts.</p>
                     <p class=3D"oj-normal">Medlemsstaterna f=C3=A5r inte v=
=C3=A4gra n=C3=A5gon att forts=C3=A4tta sin gymnasieutbildning endast p=C3=
=A5 grund av att den under=C3=A5rige har uppn=C3=A5tt laglig myndighets=C3=
=A5lder.</p>
                  </div>
                  <div id=3D"016.002">
                     <p class=3D"oj-normal">2.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna ska bevilja under=C3=A5riga som avses i&nbsp;punkt 1 tilltr=C3=A4de ti=
ll ett utbildningssystem s=C3=A5 snart som m=C3=B6jligt, dock senast tv=C3=
=A5 m=C3=A5nader fr=C3=A5n den dag d=C3=A5 ans=C3=B6kan om internationellt =
skydd l=C3=A4mnades in, med h=C3=A4nsyn tagen till skollov. Medlemsstaterna=
 ska tillhandah=C3=A5lla utbildning inom det allm=C3=A4nna utbildningssyste=
met. Som en tillf=C3=A4llig =C3=A5tg=C3=A4rd f=C3=A5r medlemsstaterna dock =
under en period p=C3=A5 h=C3=B6gst en m=C3=A5nad tillhandah=C3=A5lla denna =
utbildning utanf=C3=B6r det allm=C3=A4nna utbildningssystemet.</p>
                     <p class=3D"oj-normal">F=C3=B6rberedande undervisning,=
 inklusive spr=C3=A5kundervisning, ska tillhandah=C3=A5llas f=C3=B6r under=
=C3=A5riga n=C3=A4r det =C3=A4r n=C3=B6dv=C3=A4ndigt f=C3=B6r att underl=C3=
=A4tta deras tilltr=C3=A4de till och deltagande i&nbsp;det allm=C3=A4nna ut=
bildningssystemet.</p>
                  </div>
                  <div id=3D"016.003">
                     <p class=3D"oj-normal">3.&nbsp;&nbsp;&nbsp;N=C3=A4r ti=
lltr=C3=A4de till det allm=C3=A4nna utbildningssystemet inte =C3=A4r m=C3=
=B6jligt p=C3=A5 grund av den under=C3=A5riges s=C3=A4rskilda situation ska=
 medlemsstaten i&nbsp;fr=C3=A5ga erbjuda annan form av undervisning i&nbsp;=
enlighet med nationell r=C3=A4tt och praxis.</p>
                  </div>
               </div>
               <div class=3D"eli-subdivision" id=3D"art_17">
                  <p id=3D"d1e1393-1-1" class=3D"oj-ti-art">Artikel&nbsp;17=
</p>
                  <div class=3D"eli-title" id=3D"art_17.tit_1">
                     <p class=3D"oj-sti-art">Syssels=C3=A4ttning</p>
                  </div>
                  <div id=3D"017.001">
                     <p class=3D"oj-normal">1.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna ska se till att s=C3=B6kande har tilltr=C3=A4de till arbetsmarknaden s=
enast sex m=C3=A5nader fr=C3=A5n den dag d=C3=A5 ans=C3=B6kan om internatio=
nellt skydd registrerades, under f=C3=B6ruts=C3=A4ttning att ett administra=
tivt beslut av den beh=C3=B6riga myndigheten inte har fattats och f=C3=B6rs=
eningen inte kan tillskrivas s=C3=B6kanden.</p>
                     <p class=3D"oj-normal">Om en medlemsstat har p=C3=A5sk=
yndat sakpr=C3=B6vningen av en ans=C3=B6kan om internationellt skydd i&nbsp=
;enlighet med artikel&nbsp;42.1 a=E2=80=93f i&nbsp;f=C3=B6rordning (EU) 202=
4/1348, ska tilltr=C3=A4de till arbetsmarknaden inte beviljas eller, om det=
 redan beviljats, upph=C3=A4vas.</p>
                  </div>
                  <div id=3D"017.002">
                     <p class=3D"oj-normal">2.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna ska s=C3=A4kerst=C3=A4lla att s=C3=B6kande som har tilltr=C3=A4de till=
 arbetsmarknaden i&nbsp;enlighet med punkt 1 f=C3=A5r faktiskt tilltr=C3=A4=
de till arbetsmarknaden, i&nbsp;enlighet med nationell r=C3=A4tt.</p>
                     <p class=3D"oj-normal">Medlemsstaterna f=C3=A5r av arb=
etsmarknadspolitiska sk=C3=A4l, =C3=A4ven med h=C3=A4nsyn till ungdomsarbet=
sl=C3=B6sheten, kontrollera huruvida en specifik ledig plats f=C3=B6r vilke=
n en arbetsgivare =C3=B6verv=C3=A4ger att anst=C3=A4lla en s=C3=B6kande som=
 har tilltr=C3=A4de till arbetsmarknaden i&nbsp;enlighet med punkt 1 skulle=
 kunna fyllas av medborgare i&nbsp;den ber=C3=B6rda medlemsstaten eller av =
andra unionsmedborgare eller av tredjelandsmedborgare och statsl=C3=B6sa pe=
rsoner som =C3=A4r lagligt bosatta i&nbsp;den medlemsstaten. Om medlemsstat=
en finner att den specifika lediga platsen kan tills=C3=A4ttas med s=C3=A5d=
ana personer, f=C3=A5r medlemsstaten eller arbetsgivaren neka s=C3=B6kanden=
 den platsen.</p>
                  </div>
                  <div id=3D"017.003">
                     <p class=3D"oj-normal">3.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna ska s=C3=A4kerst=C3=A4lla att s=C3=B6kande som har tilltr=C3=A4de till=
 arbetsmarknaden i&nbsp;enlighet med punkt 1 ges samma behandling som deras=
 egna medborgare n=C3=A4r det g=C3=A4ller</p>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">a)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">anst=C3=A4llningsvi=
llkor, minimi=C3=A5lder f=C3=B6r anst=C3=A4llning och arbetsvillkor, inbegr=
ipet l=C3=B6n och upps=C3=A4gning, arbetstider, ledighet och allm=C3=A4nna =
helgdagar, samt h=C3=A4lso- och s=C3=A4kerhetskrav p=C3=A5 arbetsplatsen,</=
p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">b)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">f=C3=B6reningsfrihe=
t och frihet att tillh=C3=B6ra en arbetstagar- eller arbetsgivarorganisatio=
n eller n=C3=A5gon annan organisation vars medlemmar ut=C3=B6var ett visst =
yrke, inbegripet de r=C3=A4ttigheter och f=C3=B6rm=C3=A5ner som s=C3=A5dana=
 organisationer tillhandah=C3=A5ller, utan att det p=C3=A5verkar till=C3=A4=
mpningen av nationella best=C3=A4mmelser om allm=C3=A4n ordning och allm=C3=
=A4n s=C3=A4kerhet,</p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">c)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">utbildning och yrke=
sutbildning, inbegripet fortbildningskurser f=C3=B6r f=C3=B6rb=C3=A4ttrade =
f=C3=A4rdigheter, arbetsplatspraktik och yrkesv=C3=A4gledning,</p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">d)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">erk=C3=A4nnande av =
examens-, utbildnings- och andra beh=C3=B6righetsbevis inom ramen f=C3=B6r =
befintliga f=C3=B6rfaranden f=C3=B6r erk=C3=A4nnande av utl=C3=A4ndska kval=
ifikationer, och</p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">e)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">tillg=C3=A5ng till =
l=C3=A4mpliga system f=C3=B6r bed=C3=B6mning, validering och erk=C3=A4nnand=
e av s=C3=B6kandes resultat av tidigare l=C3=A4rande och erfarenhet.</p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                  </div>
                  <div id=3D"017.004">
                     <p class=3D"oj-normal">4.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna f=C3=A5r, n=C3=A4r det g=C3=A4ller s=C3=B6kande som har tilltr=C3=A4de=
 till arbetsmarknaden i&nbsp;enlighet med punkt 1, begr=C3=A4nsa likabehand=
lingen av dem</p>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">a)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">enligt punkt 3 b, g=
enom att utesluta dem fr=C3=A5n att delta i&nbsp;ledningen av organisatione=
r som regleras av offentlig r=C3=A4tt och fr=C3=A5n att inneha en tj=C3=A4n=
st som regleras av offentlig r=C3=A4tt,</p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">b)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">enligt punkt 3 c, g=
enom att utesluta</p>
                                 <table width=3D"100%" border=3D"0" cellspa=
cing=3D"0" cellpadding=3D"0">
                                    <colgroup><col width=3D"4%">
                                    <col width=3D"96%">
                                    </colgroup><tbody>
                                       <tr>
                                          <td valign=3D"top">
                                             <p class=3D"oj-normal">i)</p>
                                          </td>
                                          <td valign=3D"top">
                                             <p class=3D"oj-normal">stipend=
ier och l=C3=A5n som avser utbildning och yrkesutbildning, samt betalning a=
v avgifter i&nbsp;enlighet med nationell r=C3=A4tt n=C3=A4r det g=C3=A4ller=
 tilltr=C3=A4de till universitetsutbildning eller eftergymnasial utbildning=
, och</p>
                                          </td>
                                       </tr>
                                    </tbody>
                                 </table>
                                 <table width=3D"100%" border=3D"0" cellspa=
cing=3D"0" cellpadding=3D"0">
                                    <colgroup><col width=3D"4%">
                                    <col width=3D"96%">
                                    </colgroup><tbody>
                                       <tr>
                                          <td valign=3D"top">
                                             <p class=3D"oj-normal">ii)</p>
                                          </td>
                                          <td valign=3D"top">
                                             <p class=3D"oj-normal">utbildn=
ing och yrkesutbildning som inte tillhandah=C3=A5lls inom ramen f=C3=B6r et=
t befintligt anst=C3=A4llningsavtal, inbegripet n=C3=A4r den tillhandah=C3=
=A5lls f=C3=B6r att =C3=B6ka anst=C3=A4llningsbarheten,</p>
                                          </td>
                                       </tr>
                                    </tbody>
                                 </table>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">c)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">enligt punkt 3 d el=
ler e, genom att inte bevilja likabehandling f=C3=B6rr=C3=A4n minst tre m=
=C3=A5nader fr=C3=A5n den dag d=C3=A5 ans=C3=B6kan om internationellt skydd=
 registrerades.</p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                  </div>
                  <div id=3D"017.005">
                     <p class=3D"oj-normal">5.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna ska s=C3=A4kerst=C3=A4lla att s=C3=B6kande som =C3=A4r anst=C3=A4llda =
eller p=C3=A5 grundval av tidigare anst=C3=A4llning har r=C3=A4tt till soci=
ala trygghetsf=C3=B6rm=C3=A5ner behandlas p=C3=A5 samma s=C3=A4tt som deras=
 egna medborgare i&nbsp;fr=C3=A5ga om de grenar av social trygghet som avse=
s i&nbsp;artikel&nbsp;3.1 och 3.2 i&nbsp;f=C3=B6rordning (EG) nr&nbsp;883/2=
004.</p>
                  </div>
                  <div id=3D"017.006">
                     <p class=3D"oj-normal">6.&nbsp;&nbsp;&nbsp;Utan att de=
t p=C3=A5verkar till=C3=A4mpningen av f=C3=B6rordning (EU) nr&nbsp;1231/201=
0 f=C3=A5r medlemsstaterna begr=C3=A4nsa likabehandlingen enligt punkt 5 i&=
nbsp;denna artikel genom att utesluta sociala trygghetsf=C3=B6rm=C3=A5ner s=
om inte =C3=A4r beroende av anst=C3=A4llningsperioder eller av avgifter.</p=
>
                  </div>
                  <div id=3D"017.007">
                     <p class=3D"oj-normal">7.&nbsp;&nbsp;&nbsp;R=C3=A4tten=
 till likabehandling enligt denna artikel ska inte ge upphov till en r=C3=
=A4tt till bos=C3=A4ttning i&nbsp;fall d=C3=A4r ett beslut som fattats i&nb=
sp;enlighet med f=C3=B6rordning (EU) 2024/1348 har medf=C3=B6rt att s=C3=B6=
kandens r=C3=A4tt att stanna kvar har upph=C3=B6rt.</p>
                  </div>
                  <div id=3D"017.008">
                     <p class=3D"oj-normal">8.&nbsp;&nbsp;&nbsp;Vid till=C3=
=A4mpningen av punkt 3 d i&nbsp;denna artikel, och utan att det p=C3=A5verk=
ar till=C3=A4mpningen av artiklarna&nbsp;2.2 och 3.3 i&nbsp;direktiv 2005/3=
6/EG, ska medlemsstaterna, s=C3=A5 l=C3=A5ngt det =C3=A4r m=C3=B6jligt, fr=
=C3=A4mja fullst=C3=A4ndigt tilltr=C3=A4de till befintliga f=C3=B6rfaranden=
 f=C3=B6r erk=C3=A4nnandet av utl=C3=A4ndska kvalifikationer f=C3=B6r s=C3=
=B6kande som inte kan tillhandah=C3=A5lla dokumentation som styrker deras k=
valifikationer.</p>
                  </div>
                  <div id=3D"017.009">
                     <p class=3D"oj-normal">9.&nbsp;&nbsp;&nbsp;Tilltr=C3=
=A4de till arbetsmarknaden f=C3=A5r inte upph=C3=A4vas under ett =C3=B6verk=
lagandef=C3=B6rfarande om s=C3=B6kanden har r=C3=A4tt att stanna kvar p=C3=
=A5 medlemsstatens territorium under det f=C3=B6rfarandet och fram till des=
s att ett avslag har meddelats i&nbsp;=C3=B6verklagande=C3=A4rendet.</p>
                  </div>
               </div>
               <div class=3D"eli-subdivision" id=3D"art_18">
                  <p id=3D"d1e1514-1-1" class=3D"oj-ti-art">Artikel&nbsp;18=
</p>
                  <div class=3D"eli-title" id=3D"art_18.tit_1">
                     <p class=3D"oj-sti-art">Spr=C3=A5kkurser och yrkesutbi=
ldning</p>
                  </div>
                  <p class=3D"oj-normal">Medlemsstaterna ska s=C3=A4kerst=
=C3=A4lla att s=C3=B6kande har tilltr=C3=A4de till spr=C3=A5kkurser, kurser=
 i&nbsp;samh=C3=A4llsutbildning eller yrkesutbildningskurser som medlemssta=
terna anser l=C3=A4mpliga f=C3=B6r att hj=C3=A4lpa s=C3=B6kande att agera s=
j=C3=A4lvst=C3=A4ndigt, samarbeta med beh=C3=B6riga myndigheter eller hitta=
 arbete eller ska, beroende p=C3=A5 det nationella systemet, underl=C3=A4tt=
a tilltr=C3=A4det till s=C3=A5dana kurser, oberoende av huruvida s=C3=B6kan=
de har tilltr=C3=A4de till arbetsmarknaden i&nbsp;enlighet med artikel&nbsp=
;17.</p>
                  <p class=3D"oj-normal">Om s=C3=B6kande har tillr=C3=A4ckl=
iga medel f=C3=A5r medlemsstaterna kr=C3=A4va att de betalar eller bidrar t=
ill kostnaderna f=C3=B6r kurser som avses i&nbsp;f=C3=B6rsta stycket.</p>
               </div>
               <div class=3D"eli-subdivision" id=3D"art_19">
                  <p id=3D"d1e1524-1-1" class=3D"oj-ti-art">Artikel&nbsp;19=
</p>
                  <div class=3D"eli-title" id=3D"art_19.tit_1">
                     <p class=3D"oj-sti-art">Allm=C3=A4nna regler om materi=
ella mottagningsvillkor och h=C3=A4lso- och sjukv=C3=A5rd</p>
                  </div>
                  <div id=3D"019.001">
                     <p class=3D"oj-normal">1.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna ska se till att materiella mottagningsvillkor =C3=A4r tillg=C3=A4nglig=
a f=C3=B6r s=C3=B6kande fr=C3=A5n och med den tidpunkt d=C3=A5 de g=C3=B6r =
sin ans=C3=B6kan om internationellt skydd i&nbsp;enlighet med artikel&nbsp;=
26 i&nbsp;f=C3=B6rordning (EU) 2024/1348.</p>
                  </div>
                  <div id=3D"019.002">
                     <p class=3D"oj-normal">2.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna ska se till att de materiella mottagningsvillkoren och h=C3=A4lso- och=
 sjukv=C3=A5rd som erh=C3=A5llits i&nbsp;enlighet artikel&nbsp;22 ger s=C3=
=B6kande en tillr=C3=A4cklig levnadsstandard som s=C3=A4kerst=C3=A4ller der=
as uppeh=C3=A4lle och skyddar deras fysiska och psykiska h=C3=A4lsa samt re=
spekterar deras r=C3=A4ttigheter enligt stadgan.</p>
                     <p class=3D"oj-normal">Medlemsstaterna ska se till att=
 den tillr=C3=A4ckliga levnadsstandard som avses i&nbsp;f=C3=B6rsta stycket=
 =C3=A4ven uppfylls f=C3=B6r s=C3=B6kande med s=C3=A4rskilda mottagandebeho=
v och f=C3=B6r personer som h=C3=A5lls i&nbsp;f=C3=B6rvar.</p>
                  </div>
                  <div id=3D"019.003">
                     <p class=3D"oj-normal">3.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna f=C3=A5r fastst=C3=A4lla som villkor f=C3=B6r att bevilja samtliga ell=
er n=C3=A5gra av de materiella mottagningsvillkoren att s=C3=B6kandena inte=
 har tillr=C3=A4ckliga medel f=C3=B6r att s=C3=A4kerst=C3=A4lla en tillr=C3=
=A4cklig levnadsstandard som avses i&nbsp;punkt 2.</p>
                  </div>
                  <div id=3D"019.004">
                     <p class=3D"oj-normal">4.&nbsp;&nbsp;&nbsp;Utan att de=
t p=C3=A5verkar till=C3=A4mpningen av punkt 2 f=C3=A5r medlemsstaterna kr=
=C3=A4va att s=C3=B6kande t=C3=A4cker eller bidrar till kostnaderna f=C3=B6=
r de materiella mottagningsvillkoren, om de har tillr=C3=A4ckliga medel f=
=C3=B6r det, till exempel om de har arbetat under en rimlig tidsperiod.</p>
                     <p class=3D"oj-normal">Utan att det p=C3=A5verkar till=
=C3=A4mpningen av punkt 2 f=C3=A5r medlemsstaterna ocks=C3=A5 kr=C3=A4va at=
t s=C3=B6kande t=C3=A4cker eller bidrar till kostnaderna f=C3=B6r erh=C3=A5=
llen h=C3=A4lso- och sjukv=C3=A5rd, om dessa s=C3=B6kande har tillr=C3=A4ck=
liga medel f=C3=B6r det, f=C3=B6rutom d=C3=A4r h=C3=A4lso- och sjukv=C3=A5r=
den erbjuds dessa medlemsstaters egna medborgare kostnadsfritt.</p>
                  </div>
                  <div id=3D"019.005">
                     <p class=3D"oj-normal">5.&nbsp;&nbsp;&nbsp;Om det fram=
kommer att en s=C3=B6kande hade tillr=C3=A4ckliga medel f=C3=B6r att t=C3=
=A4cka kostnaderna f=C3=B6r materiella mottagningsvillkor eller h=C3=A4lso-=
 och sjukv=C3=A5rd som erh=C3=A5llits enligt punkt 4 vid den tidpunkt d=C3=
=A5 s=C3=B6kanden gavs en tillr=C3=A4cklig levnadsstandard, f=C3=A5r medlem=
sstaterna kr=C3=A4va att s=C3=B6kanden ska =C3=A5terbetala kostnaderna f=C3=
=B6r de materiella mottagningsvillkoren eller h=C3=A4lso- och sjukv=C3=A5rd=
en.</p>
                  </div>
                  <div id=3D"019.006">
                     <p class=3D"oj-normal">6.&nbsp;&nbsp;&nbsp;Vid bed=C3=
=B6mningen av en s=C3=B6kandes tillg=C3=A5ngar i&nbsp;fall d=C3=A4r det kr=
=C3=A4vs att s=C3=B6kanden ska t=C3=A4cka eller bidra till kostnaderna f=C3=
=B6r de materiella mottagningsvillkoren och h=C3=A4lso- och sjukv=C3=A5rd s=
om erh=C3=A5llits eller d=C3=A4r s=C3=B6kanden avkr=C3=A4vs en =C3=A5terbet=
alning i&nbsp;enlighet med punkt 5, ska medlemsstaterna respektera proporti=
onalitetsprincipen. Medlemsstaterna ska ocks=C3=A5 ta h=C3=A4nsyn till s=C3=
=B6kandens individuella f=C3=B6rh=C3=A5llanden och behovet av att respekter=
a hans eller hennes v=C3=A4rdighet och personliga integritet, inbegripet s=
=C3=B6kandens s=C3=A4rskilda mottagandebehov.</p>
                  </div>
                  <div id=3D"019.007">
                     <p class=3D"oj-normal">7.&nbsp;&nbsp;&nbsp;Om en medle=
msstat erbjuder materiella mottagningsvillkor i&nbsp;form av ekonomiskt bid=
rag eller kuponger ska beloppen best=C3=A4mmas utifr=C3=A5n de niv=C3=A5er =
som medlemsstaten i&nbsp;fr=C3=A5ga fastst=C3=A4llt antingen genom lag elle=
r praxis i&nbsp;syfte att s=C3=A4kerst=C3=A4lla en tillr=C3=A4cklig levnads=
standard f=C3=B6r de egna medborgarna. Medlemsstaterna ska underr=C3=A4tta =
kommissionen och asylbyr=C3=A5n om dessa niv=C3=A5er. Medlemsstaterna f=C3=
=A5r behandla s=C3=B6kande mindre gynnsamt =C3=A4n de egna medborgarna i&nb=
sp;detta avseende, s=C3=A4rskilt om det materiella st=C3=B6det helt eller d=
elvis tillhandah=C3=A5lls in natura eller om syftet med dessa niv=C3=A5er, =
n=C3=A4r de till=C3=A4mpas f=C3=B6r de egna medborgarna, =C3=A4r att s=C3=
=A4kerst=C3=A4lla en levnadsstandard som =C3=A4r h=C3=B6gre =C3=A4n den som=
 kr=C3=A4vs f=C3=B6r s=C3=B6kande enligt detta direktiv.</p>
                  </div>
               </div>
               <div class=3D"eli-subdivision" id=3D"art_20">
                  <p id=3D"d1e1569-1-1" class=3D"oj-ti-art">Artikel&nbsp;20=
</p>
                  <div class=3D"eli-title" id=3D"art_20.tit_1">
                     <p class=3D"oj-sti-art">Arrangemang f=C3=B6r materiell=
a mottagningsvillkor</p>
                  </div>
                  <div id=3D"020.001">
                     <p class=3D"oj-normal">1.&nbsp;&nbsp;&nbsp;Om medlemss=
taterna tillhandah=C3=A5ller inkvartering in natura ska de s=C3=A4kerst=C3=
=A4lla att s=C3=A5dan inkvartering ger s=C3=B6kanden en tillr=C3=A4cklig le=
vnadsstandard i&nbsp;enlighet med artikel&nbsp;19.2 samt n=C3=B6dv=C3=A4ndi=
gt st=C3=B6d f=C3=B6r att ta h=C3=A4nsyn till s=C3=B6kandenas s=C3=A4rskild=
a mottagandebehov. Den inkvartering som tillhandah=C3=A5lls ska beviljas i&=
nbsp;en av, eller en kombination av, f=C3=B6ljande former:</p>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">a)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">Anl=C3=A4ggningar s=
om anv=C3=A4nds i&nbsp;syfte att hysa s=C3=B6kande under pr=C3=B6vningen av=
 en ans=C3=B6kan om internationellt skydd som gjorts vid gr=C3=A4nsen eller=
 i&nbsp;transitomr=C3=A5den.</p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">b)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">F=C3=B6rl=C3=A4ggni=
ngar.</p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">c)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">Privata hus, l=C3=
=A4genheter, hotell eller andra lokaler som anpassats f=C3=B6r s=C3=B6kande=
.</p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                  </div>
                  <div id=3D"020.002">
                     <p class=3D"oj-normal">2.&nbsp;&nbsp;&nbsp;Utan att de=
tta p=C3=A5verkar de s=C3=A4rskilda f=C3=B6rh=C3=A5llanden f=C3=B6r f=C3=B6=
rvar som f=C3=B6reskrivs i&nbsp;artiklarna&nbsp;12 och 13 ska medlemsstater=
na med avseende p=C3=A5 s=C3=A5dan inkvartering som avses i&nbsp;punkt 1 a,=
 b och c i&nbsp;den h=C3=A4r artikeln se till att</p>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">a)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">s=C3=B6kande garant=
eras skydd f=C3=B6r sitt familjeliv,</p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">b)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">s=C3=B6kande har m=
=C3=B6jlighet att kommunicera med sl=C3=A4ktingar, juridiska r=C3=A5dgivare=
 och f=C3=B6retr=C3=A4dare f=C3=B6r UNHCR och andra ber=C3=B6rda nationella=
, internationella och icke-statliga organisationer och organ,</p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">c)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">familjemedlemmar, j=
uridiska r=C3=A5dgivare och f=C3=B6retr=C3=A4dare f=C3=B6r UNHCR och ber=C3=
=B6rda icke-statliga organisationer som erk=C3=A4nts av medlemsstaten i&nbs=
p;fr=C3=A5ga ska ges tilltr=C3=A4de till den inkvartering som tillhandah=C3=
=A5lls f=C3=B6r att bitr=C3=A4da s=C3=B6kande; detta tilltr=C3=A4de f=C3=A5=
r endast begr=C3=A4nsas med h=C3=A4nsyn till s=C3=A4kerheten vid anl=C3=A4g=
gningarna och f=C3=B6r s=C3=B6kandena.</p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                  </div>
                  <div id=3D"020.003">
                     <p class=3D"oj-normal">3.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna ska ta h=C3=A4nsyn till s=C3=A4rskilda faktorer som avser =C3=A5lder o=
ch k=C3=B6n, och till situationen f=C3=B6r s=C3=B6kande med s=C3=A4rskilda =
mottagandebehov n=C3=A4r de tillhandah=C3=A5ller materiella mottagningsvill=
kor.</p>
                  </div>
                  <div id=3D"020.004">
                     <p class=3D"oj-normal">4.&nbsp;&nbsp;&nbsp;N=C3=A4r me=
dlemsstaterna tillhandah=C3=A5ller inkvartering enligt punkt 1 ska de vidta=
 l=C3=A4mpliga =C3=A5tg=C3=A4rder f=C3=B6r att s=C3=A5 l=C3=A5ngt det =C3=
=A4r m=C3=B6jligt s=C3=A4kerst=C3=A4lla att misshandel och v=C3=A5ld, inbeg=
ripet v=C3=A5ld med sexuella, k=C3=B6nsrelaterade, rasistiska eller religi=
=C3=B6sa motiv, f=C3=B6rhindras.</p>
                  </div>
                  <div id=3D"020.005">
                     <p class=3D"oj-normal">5.&nbsp;&nbsp;&nbsp;Om kvinnlig=
a s=C3=B6kande placeras p=C3=A5 f=C3=B6rl=C3=A4ggningar ska medlemsstaterna=
 tillhandah=C3=A5lla separata sanit=C3=A4ra inr=C3=A4ttningar och en s=C3=
=A4ker plats inom dessa f=C3=B6rl=C3=A4ggningar f=C3=B6r dem och deras unde=
r=C3=A5riga barn.</p>
                  </div>
                  <div id=3D"020.006">
                     <p class=3D"oj-normal">6.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna ska, s=C3=A5 l=C3=A5ngt det =C3=A4r m=C3=B6jligt, se till att vuxna s=
=C3=B6kande i&nbsp;beroendest=C3=A4llning, med s=C3=A4rskilda mottagandebeh=
ov, inkvarteras tillsammans med vuxna n=C3=A4ra sl=C3=A4ktingar som redan b=
efinner sig i&nbsp;samma medlemsstat, och som enligt den ber=C3=B6rda medle=
msstatens lag eller praxis ansvarar f=C3=B6r dem.</p>
                  </div>
                  <div id=3D"020.007">
                     <p class=3D"oj-normal">7.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna ska se till att flyttning av s=C3=B6kande fr=C3=A5n en anl=C3=A4ggning=
 till en annan sker endast om det =C3=A4r n=C3=B6dv=C3=A4ndigt. Medlemsstat=
erna ska ge s=C3=B6kande m=C3=B6jlighet att underr=C3=A4tta sina juridiska =
r=C3=A5dgivare om f=C3=B6rflyttningen och sin nya adress.</p>
                  </div>
                  <div id=3D"020.008">
                     <p class=3D"oj-normal">8.&nbsp;&nbsp;&nbsp;Personer so=
m tillhandah=C3=A5ller materiella mottagningsvillkor, inbegripet de som til=
lhandah=C3=A5ller h=C3=A4lso- och sjukv=C3=A5rd samt utbildning vid f=C3=B6=
rl=C3=A4ggningar, ska ha l=C3=A4mplig utbildning och vara bundna av reglern=
a om tystnadsplikt, enligt nationell r=C3=A4tt, betr=C3=A4ffande uppgifter =
som de f=C3=A5r k=C3=A4nnedom om genom sitt arbete.</p>
                  </div>
                  <div id=3D"020.009">
                     <p class=3D"oj-normal">9.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna f=C3=A5r l=C3=A5ta s=C3=B6kande delta i&nbsp;f=C3=B6rvaltningen av de =
materiella resurserna och de icke-materiella aspekterna av livet vid f=C3=
=B6rl=C3=A4ggningen genom ett r=C3=A5d eller en r=C3=A5dgivande kommitt=C3=
=A9 som f=C3=B6retr=C3=A4der dem som bor p=C3=A5 f=C3=B6rl=C3=A4ggningen. U=
tan att det p=C3=A5verkar till=C3=A4mpningen av artikel&nbsp;17 f=C3=A5r me=
dlemsstaterna ocks=C3=A5 till=C3=A5ta s=C3=B6kande att utf=C3=B6ra frivilli=
garbete utanf=C3=B6r f=C3=B6rl=C3=A4ggningen, med f=C3=B6rbeh=C3=A5ll f=C3=
=B6r villkor i&nbsp;nationell r=C3=A4tt.</p>
                  </div>
                  <div id=3D"020.010">
                     <p class=3D"oj-normal">10.&nbsp;&nbsp;&nbsp;I vederb=
=C3=B6rligen motiverade fall och under en rimlig tidsperiod som ska vara s=
=C3=A5 kort som m=C3=B6jligt f=C3=A5r medlemsstaterna undantagsvis tillhand=
ah=C3=A5lla materiella mottagningsvillkor som avviker fr=C3=A5n dem som f=
=C3=B6reskrivs i&nbsp;denna artikel, n=C3=A4r</p>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">a)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">det kr=C3=A4vs en b=
ed=C3=B6mning av s=C3=B6kandens s=C3=A4rskilda mottagandebehov, i&nbsp;enli=
ghet med artikel&nbsp;25,</p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">b)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">de normalt tillg=C3=
=A4ngliga inkvarteringsm=C3=B6jligheterna tillf=C3=A4lligtvis =C3=A4r utt=
=C3=B6mda, eller de normalt tillg=C3=A4ngliga inkvarteringsm=C3=B6jligheter=
na tillf=C3=A4lligtvis inte =C3=A4r tillg=C3=A4ngliga p=C3=A5 grund av ett =
oproportionerligt stort antal personer som ska inkvarteras eller p=C3=A5 gr=
und av en katastrof som orsakats av m=C3=A4nniskan eller en naturkatastrof.=
</p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                     <p class=3D"oj-normal">Avvikande materiella mottagning=
svillkor som avses i&nbsp;f=C3=B6rsta stycket i&nbsp;denna punkt ska under =
alla f=C3=B6rh=C3=A5llanden s=C3=A4kerst=C3=A4lla tillg=C3=A5ng till h=C3=
=A4lso- och sjukv=C3=A5rd i&nbsp;enlighet med artikel&nbsp;22 och en levnad=
sstandard f=C3=B6r alla s=C3=B6kande i&nbsp;enlighet med unionsr=C3=A4tten,=
 inbegripet stadgan, och internationella skyldigheter.</p>
                     <p class=3D"oj-normal">Om en medlemsstat tillhandah=C3=
=A5ller avvikande materiella mottagningsvillkor i&nbsp;enlighet med f=C3=B6=
rsta stycket i&nbsp;denna punkt ska den medlemsstaten utan dr=C3=B6jsm=C3=
=A5l underr=C3=A4tta kommissionen och asylbyr=C3=A5n i&nbsp;enlighet med ar=
tikel&nbsp;32.2 om aktiveringen av sin beredskapsplan. Den medlemsstaten sk=
a ocks=C3=A5 underr=C3=A4tta kommissionen och asylbyr=C3=A5n s=C3=A5 snart =
grunderna f=C3=B6r att tillhandah=C3=A5lla dessa avvikande materiella villk=
or inte l=C3=A4ngre f=C3=B6religger.</p>
                  </div>
               </div>
               <div class=3D"eli-subdivision" id=3D"art_21">
                  <p id=3D"d1e1684-1-1" class=3D"oj-ti-art">Artikel&nbsp;21=
</p>
                  <div class=3D"eli-title" id=3D"art_21.tit_1">
                     <p class=3D"oj-sti-art">Mottagningsvillkor i&nbsp;en a=
nnan medlemsstat =C3=A4n den d=C3=A4r s=C3=B6kanden =C3=A4r skyldig att bef=
inna sig</p>
                  </div>
                  <p class=3D"oj-normal">Fr=C3=A5n den tidpunkt d=C3=A5 s=
=C3=B6kande har underr=C3=A4ttats om ett beslut att =C3=B6verf=C3=B6ra dem =
till den ansvariga medlemsstaten i&nbsp;enlighet med f=C3=B6rordning (EU) 2=
024/1351 ska de inte vara ber=C3=A4ttigade till de mottagningsvillkor som f=
astst=C3=A4lls i&nbsp;artiklarna&nbsp;17=E2=80=9320 i&nbsp;detta direktiv i=
&nbsp;n=C3=A5gon annan medlemsstat =C3=A4n den d=C3=A4r de =C3=A4r skyldiga=
 att befinna sig i&nbsp;enlighet med f=C3=B6rordning (EU) 2024/1351. Detta =
ska inte p=C3=A5verka behovet av att s=C3=A4kerst=C3=A4lla en levnadsstanda=
rd i&nbsp;enlighet med unionsr=C3=A4tten, inbegripet stadgan, och internati=
onella f=C3=B6rpliktelser.</p>
                  <p class=3D"oj-normal">S=C3=A5vida inte ett separat beslu=
t utf=C3=A4rdas ska det i&nbsp;=C3=B6verf=C3=B6ringsbeslutet framg=C3=A5 at=
t de ber=C3=B6rda mottagningsvillkoren har dragits in i&nbsp;enlighet med d=
enna artikel. S=C3=B6kanden ska underr=C3=A4ttas om sina r=C3=A4ttigheter o=
ch skyldigheter i&nbsp;f=C3=B6rh=C3=A5llande till det beslutet.</p>
               </div>
               <div class=3D"eli-subdivision" id=3D"art_22">
                  <p id=3D"d1e1694-1-1" class=3D"oj-ti-art">Artikel&nbsp;22=
</p>
                  <div class=3D"eli-title" id=3D"art_22.tit_1">
                     <p class=3D"oj-sti-art">H=C3=A4lso- och sjukv=C3=A5rd<=
/p>
                  </div>
                  <div id=3D"022.001">
                     <p class=3D"oj-normal">1.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna ska se till att s=C3=B6kande, oavsett var de =C3=A4r skyldiga att befi=
nna sig i&nbsp;enlighet med f=C3=B6rordning (EU) 2024/1351, f=C3=A5r n=C3=
=B6dv=C3=A4ndig h=C3=A4lso- och sjukv=C3=A5rd, oavsett om den tillhandah=C3=
=A5lls av allm=C3=A4nl=C3=A4kare eller, vid behov, av specialistl=C3=A4kare=
. S=C3=A5dan n=C3=B6dv=C3=A4ndig h=C3=A4lso- och sjukv=C3=A5rd ska vara av =
tillfredsst=C3=A4llande kvalitet och innefatta =C3=A5tminstone akutsjukv=C3=
=A5rd och n=C3=B6dv=C3=A4ndig behandling av sjukdomar, inbegripet allvarlig=
a psykiatriska tillst=C3=A5nd, samt sexuell och reproduktiv h=C3=A4lso- och=
 sjukv=C3=A5rd som =C3=A4r n=C3=B6dv=C3=A4ndig f=C3=B6r att behandla ett al=
lvarligt fysiskt h=C3=A4lsotillst=C3=A5nd.</p>
                  </div>
                  <div id=3D"022.002">
                     <p class=3D"oj-normal">2.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna ska s=C3=A4kerst=C3=A4lla att s=C3=B6kandes under=C3=A5riga barn och s=
=C3=B6kande som =C3=A4r under=C3=A5riga f=C3=A5r samma typ av h=C3=A4lso- o=
ch sjukv=C3=A5rd som de egna medborgarna som =C3=A4r under=C3=A5riga. Medle=
msstaterna ska s=C3=A4kerst=C3=A4lla att s=C3=A4rskild behandling som tillh=
andah=C3=A5lls i&nbsp;enlighet med denna artikel, och som inleddes innan de=
n under=C3=A5rige uppn=C3=A5dde myndighets=C3=A5lder och som anses vara n=
=C3=B6dv=C3=A4ndig, f=C3=A5s utan avbrott eller dr=C3=B6jsm=C3=A5l efter de=
t att den under=C3=A5rige har uppn=C3=A5tt myndighets=C3=A5lder.</p>
                  </div>
                  <div id=3D"022.003">
                     <p class=3D"oj-normal">3.&nbsp;&nbsp;&nbsp;Om det kr=
=C3=A4vs av medicinska sk=C3=A4l ska medlemsstaterna s=C3=B6rja f=C3=B6r n=
=C3=B6dv=C3=A4ndig l=C3=A4karhj=C3=A4lp eller annan hj=C3=A4lp, s=C3=A5som =
n=C3=B6dv=C3=A4ndig rehabilitering och n=C3=B6dv=C3=A4ndiga medicintekniska=
 hj=C3=A4lpmedel, f=C3=B6r s=C3=B6kande med s=C3=A4rskilda mottagandebehov,=
 inklusive l=C3=A4mplig v=C3=A5rd f=C3=B6r psykiska besv=C3=A4r.</p>
                  </div>
               </div>
            </div>
            <div id=3D"cpt_III">
               <p id=3D"d1e1716-1-1" class=3D"oj-ti-section-1">KAPITEL&nbsp=
;III</p>
               <div class=3D"eli-title" id=3D"cpt_III.tit_1">
                  <p id=3D"L_01346SV.01000101-d-003" class=3D"oj-ti-section=
-2">
                     <span class=3D"oj-bold">INSKR=C3=84NKNING ELLER INDRAG=
NING AV MATERIELLA MOTTAGNINGSVILLKOR</span>
                  </p>
               </div>
               <div class=3D"eli-subdivision" id=3D"art_23">
                  <p id=3D"d1e1724-1-1" class=3D"oj-ti-art">Artikel&nbsp;23=
</p>
                  <div class=3D"eli-title" id=3D"art_23.tit_1">
                     <p class=3D"oj-sti-art">Inskr=C3=A4nkning eller indrag=
ning av materiella mottagningsvillkor</p>
                  </div>
                  <div id=3D"023.001">
                     <p class=3D"oj-normal">1.&nbsp;&nbsp;&nbsp;N=C3=A4r de=
t g=C3=A4ller s=C3=B6kande som =C3=A4r skyldiga att befinna sig p=C3=A5 med=
lemsstaternas territorium i&nbsp;enlighet med artikel&nbsp;17.4 i&nbsp;f=C3=
=B6rordning (EU) 2024/1351, f=C3=A5r medlemsstaterna inskr=C3=A4nka eller d=
ra in dagers=C3=A4ttningen.</p>
                     <p class=3D"oj-normal">Om det =C3=A4r vederb=C3=B6rlig=
en motiverat och proportionellt f=C3=A5r medlemsstaterna =C3=A4ven</p>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">a)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">inskr=C3=A4nka andr=
a materiella mottagningsvillkor, eller</p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">b)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">om punkt 2 e&nbsp;=
=C3=A4r till=C3=A4mplig, dra in andra materiella mottagningsvillkor.</p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                  </div>
                  <div id=3D"023.002">
                     <p class=3D"oj-normal">2.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna f=C3=A5r fatta beslut i&nbsp;enlighet med punkt 1 om en s=C3=B6kande</=
p>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">a)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">utan tillst=C3=A5nd=
 l=C3=A4mnar ett geografiskt omr=C3=A5de inom vilket s=C3=B6kanden f=C3=A5r=
 r=C3=B6ra sig fritt i&nbsp;enlighet med artikel&nbsp;8 eller den bostad p=
=C3=A5 en best=C3=A4md plats som anvisats av den beh=C3=B6riga myndigheten =
i&nbsp;enlighet med artikel&nbsp;9, eller avviker,</p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">b)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">underl=C3=A5ter att=
 samarbeta med de beh=C3=B6riga myndigheterna, eller inte uppfyller de f=C3=
=B6rfarandekrav som de fastst=C3=A4llt,</p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">c)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">har l=C3=A4mnat in =
en efterf=C3=B6ljande ans=C3=B6kan enligt definitionen i&nbsp;artikel&nbsp;=
3.19 i&nbsp;f=C3=B6rordning (EU) 2024/1348,</p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">d)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">har undanh=C3=A5lli=
t ekonomiska tillg=C3=A5ngar, och d=C3=A4rf=C3=B6r utan r=C3=A4tt f=C3=A5tt=
 del av materiella mottagningsvillkor,</p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">e)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">allvarligt eller vi=
d upprepade tillf=C3=A4llen har brutit mot f=C3=B6rl=C3=A4ggningens regler =
eller har upptr=C3=A4tt v=C3=A5ldsamt eller hotfullt i&nbsp;f=C3=B6rl=C3=A4=
ggningen, eller</p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">f)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">underl=C3=A5ter att=
 delta i&nbsp;obligatoriska integrations=C3=A5tg=C3=A4rder, om s=C3=A5dana =
tillhandah=C3=A5lls eller m=C3=B6jligg=C3=B6rs av medlemsstaten, s=C3=A5vid=
a det inte finns omst=C3=A4ndigheter som ligger utom s=C3=B6kandens kontrol=
l.</p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                  </div>
                  <div id=3D"023.003">
                     <p class=3D"oj-normal">3.&nbsp;&nbsp;&nbsp;Om en medle=
msstat har fattat ett beslut i&nbsp;en situation enligt punkt 2 a, b eller =
f, och de omst=C3=A4ndigheter som det beslutet grundar sig p=C3=A5 inte l=
=C3=A4ngre f=C3=B6religger, ska den =C3=B6verv=C3=A4ga om vissa eller alla =
de materiella mottagningsvillkor som dragits in eller inskr=C3=A4nkts kan =
=C3=A5terinf=C3=B6ras. Om inte alla materiella mottagningsvillkor =C3=A5ter=
inf=C3=B6rs ska medlemsstaten fatta ett vederb=C3=B6rligen motiverat beslut=
 och delge s=C3=B6kanden det.</p>
                  </div>
                  <div id=3D"023.004">
                     <p class=3D"oj-normal">4.&nbsp;&nbsp;&nbsp;Beslut i&nb=
sp;enlighet med punkt 1 i&nbsp;denna artikel ska fattas p=C3=A5 objektiv oc=
h opartisk grund efter pr=C3=B6vning i&nbsp;det enskilda =C3=A4rendet och a=
nge de sk=C3=A4l som ligger till grund f=C3=B6r beslutet. Beslut ska grunda=
s p=C3=A5 s=C3=B6kandens speciella situation, s=C3=A4rskilt n=C3=A4r det g=
=C3=A4ller s=C3=B6kande med s=C3=A4rskilda mottagandebehov, med beaktande a=
v proportionalitetsprincipen. Medlemsstaterna ska s=C3=A4kerst=C3=A4lla til=
ltr=C3=A4de till h=C3=A4lso- och sjukv=C3=A5rd i&nbsp;enlighet med artikel&=
nbsp;22 och s=C3=A4kerst=C3=A4lla en levnadsstandard f=C3=B6r alla s=C3=B6k=
ande i&nbsp;enlighet med unionsr=C3=A4tten, inbegripet stadgan, och interna=
tionella skyldigheter.</p>
                  </div>
                  <div id=3D"023.005">
                     <p class=3D"oj-normal">5.&nbsp;&nbsp;&nbsp;Medlemsstat=
erna ska se till att materiella mottagningsvillkor inte inskr=C3=A4nks elle=
r dras in f=C3=B6rr=C3=A4n ett beslut har fattats i&nbsp;en situation som a=
vses i&nbsp;punkt 2.</p>
                  </div>
               </div>
            </div>
            <div id=3D"cpt_IV">
               <p id=3D"d1e1810-1-1" class=3D"oj-ti-section-1">KAPITEL&nbsp=
;IV</p>
               <div class=3D"eli-title" id=3D"cpt_IV.tit_1">
                  <p id=3D"L_01346SV.01000101-d-004" class=3D"oj-ti-section=
-2">
                     <span class=3D"oj-bold">BEST=C3=84MMELSER AVSEENDE S=
=C3=96KANDE MED S=C3=84RSKILDA MOTTAGANDEBEHOV</span>
                  </p>
               </div>
               <div class=3D"eli-subdivision" id=3D"art_24">
                  <p id=3D"d1e1818-1-1" class=3D"oj-ti-art">Artikel&nbsp;24=
</p>
                  <div class=3D"eli-title" id=3D"art_24.tit_1">
                     <p class=3D"oj-sti-art">S=C3=B6kande med s=C3=A4rskild=
a mottagandebehov</p>
                  </div>
                  <p class=3D"oj-normal">Medlemsstaterna ska beakta den spe=
ciella situationen f=C3=B6r s=C3=B6kande med s=C3=A4rskilda mottagandebehov=
.</p>
                  <p class=3D"oj-normal">Medlemsstaterna ska ta h=C3=A4nsyn=
 till att vissa s=C3=B6kande, s=C3=A5som de som tillh=C3=B6r n=C3=A5gon av =
de f=C3=B6ljande kategorierna, mer sannolikt har s=C3=A4rskilda mottagandeb=
ehov:</p>
                  <table width=3D"100%" border=3D"0" cellspacing=3D"0" cell=
padding=3D"0">
                     <colgroup><col width=3D"4%">
                     <col width=3D"96%">
                     </colgroup><tbody>
                        <tr>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">a)</p>
                           </td>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">Under=C3=A5riga.</p>
                           </td>
                        </tr>
                     </tbody>
                  </table>
                  <table width=3D"100%" border=3D"0" cellspacing=3D"0" cell=
padding=3D"0">
                     <colgroup><col width=3D"4%">
                     <col width=3D"96%">
                     </colgroup><tbody>
                        <tr>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">b)</p>
                           </td>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">Ensamkommande barn.</p=
>
                           </td>
                        </tr>
                     </tbody>
                  </table>
                  <table width=3D"100%" border=3D"0" cellspacing=3D"0" cell=
padding=3D"0">
                     <colgroup><col width=3D"4%">
                     <col width=3D"96%">
                     </colgroup><tbody>
                        <tr>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">c)</p>
                           </td>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">Personer med funktions=
neds=C3=A4ttning.</p>
                           </td>
                        </tr>
                     </tbody>
                  </table>
                  <table width=3D"100%" border=3D"0" cellspacing=3D"0" cell=
padding=3D"0">
                     <colgroup><col width=3D"4%">
                     <col width=3D"96%">
                     </colgroup><tbody>
                        <tr>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">d)</p>
                           </td>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">=C3=84ldre.</p>
                           </td>
                        </tr>
                     </tbody>
                  </table>
                  <table width=3D"100%" border=3D"0" cellspacing=3D"0" cell=
padding=3D"0">
                     <colgroup><col width=3D"4%">
                     <col width=3D"96%">
                     </colgroup><tbody>
                        <tr>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">e)</p>
                           </td>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">Gravida.</p>
                           </td>
                        </tr>
                     </tbody>
                  </table>
                  <table width=3D"100%" border=3D"0" cellspacing=3D"0" cell=
padding=3D"0">
                     <colgroup><col width=3D"4%">
                     <col width=3D"96%">
                     </colgroup><tbody>
                        <tr>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">f)</p>
                           </td>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">Homosexuella, bisexuel=
la, transpersoner och intersexuella personer.</p>
                           </td>
                        </tr>
                     </tbody>
                  </table>
                  <table width=3D"100%" border=3D"0" cellspacing=3D"0" cell=
padding=3D"0">
                     <colgroup><col width=3D"4%">
                     <col width=3D"96%">
                     </colgroup><tbody>
                        <tr>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">g)</p>
                           </td>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">Ensamst=C3=A5ende f=C3=
=B6r=C3=A4ldrar med under=C3=A5riga barn.</p>
                           </td>
                        </tr>
                     </tbody>
                  </table>
                  <table width=3D"100%" border=3D"0" cellspacing=3D"0" cell=
padding=3D"0">
                     <colgroup><col width=3D"4%">
                     <col width=3D"96%">
                     </colgroup><tbody>
                        <tr>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">h)</p>
                           </td>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">Offer f=C3=B6r m=C3=A4=
nniskohandel.</p>
