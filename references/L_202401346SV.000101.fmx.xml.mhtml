                        <tr>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">i)</p>
                           </td>
                           <td valign=3D"top">
                              <p class=3D"oj-normal">Personer med allvarlig=
a sjukdomar.</p>
                           </td>
                        </tr>
                     </tbody>
                  </table>
                  <table width=3D"100%" border=3D"0" cellspacing=3D"0" cell=
