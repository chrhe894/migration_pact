ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">(f)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">En beg=C3=A4ran om =
information som avses i artikel&nbsp;51.1&nbsp;d i f=C3=B6rordning&nbsp;202=
4/1351 (typ 06).</p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">(g)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">En beg=C3=A4ran om =
information om barn, syskon eller f=C3=B6r=C3=A4lder till en s=C3=B6kande i=
 en beroendesituation (typ 07).</p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
ellpadding=3D"0">
                        <colgroup><col width=3D"4%">
                        <col width=3D"96%">
                        </colgroup><tbody>
                           <tr>
