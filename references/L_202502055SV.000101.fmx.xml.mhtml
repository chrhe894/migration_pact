                           <tr>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">(j)</p>
                              </td>
                              <td valign=3D"top">
                                 <p class=3D"oj-normal">=C3=96vers=C3=A4ndn=
ing av det gemensamma h=C3=A4lsointyget (typ 10).</p>
                              </td>
                           </tr>
                        </tbody>
                     </table>
                     <table width=3D"100%" border=3D"0" cellspacing=3D"0" c=
