' ============================================================================
' Diagram: Återtagandeförfarandet (take back) — detaljerat aktivitetsflöde
'
' Syfte: Visar hela flödet från Eurodac-träff till verkställd överföring
'        tillbaka till den redan ansvariga staten.
'
' Källa: AMMR artiklarna 36, 41, 42, 43, 46
'
' Status: Draft
' ============================================================================

@startuml take-back-procedure

title Återtagandeförfarandet (take back) — detaljerat aktivitetsflöde

skinparam shadowing false
skinparam HyperlinkColor Black
skinparam HyperlinkUnderline true
skinparam defaultFontName Arial
skinparam activity {
  BackgroundColor #F8F8F8
  BorderColor #333333
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #333333
}
skinparam note {
  BackgroundColor #FFF7D6
  BorderColor #7A6A2A
}

start

partition "Upptäckt" {
  :Person påträffas i en medlemsstat
  utan uppehållshandling, ELLER
  gör ny ansökan i annan stat;
  :Eurodac-sökning genomförs;
  :Träff — ansvarig stat redan
  registrerad i Eurodac;
  note right
    == Skillnad mot take charge ==
    Ansvaret är redan fastställt.
    Ingen ny ansvarsbedömning behövs.
    Det handlar om att **återföra**
    personen till rätt stat.
  end note
}

partition "Avisering om återtagande (art. 41)" {
  :Staten där personen befinner sig
  skickar avisering till ansvarig stat;
  note right
    == Tidsfrist ==
    Omedelbart, senast 2 veckor
    efter Eurodac-träff
    ---
    == Innehåll ==
    Standardformulär med
    bevis/indicier
    ---
    == OBS ==
    Underlåtenhet påverkar inte
    den ansvariga statens
    skyldighet att återta
  end note
}

partition "Ansvarig stat bekräftar (art. 41.3)" {
  if (Svar inom 2 veckor?) then (Bekräftar)
    :Bekräftar mottagande;
  elseif (Invänder)
    :Visar att den inte är ansvarig
    (art. 37 — ansvar upphört);
    note right
      == Möjliga skäl ==
      - Personen lämnat EU >9 mån
      - Avlägsnande verkställt
      - 15 mån efter gränsbeslut
      - Felaktig Eurodac-angivelse
    end note
    :Aviseringen avvisas;
    :Den aviserande staten
    genomför ny ansvarsbedömning;
    stop
  else (Inget svar)
    :Tyst bekräftelse —
    underlåtenhet = godtagande;
  endif
}

partition "Överföringsbeslut (art. 42)" {
  :Beslut fattas inom 2 veckor;
  :Personen underrättas;
}

partition "Rättsmedel (art. 43)" {
  if (Personen överklagar?) then (Ja)
    if (Suspensiv verkan?) then (Ja)
      :Frist fryser;
      :Domstol beslutar;
    else (Nej)
    endif
  else (Nej)
  endif
}

partition "Överföring (art. 46)" {
  :Överföring verkställs;
  note right
    == Tidsfrister ==
    Normalt: 6 månader
    Vid förvar: 4 veckor
    Vid avvikande: 18 månader
    ---
    == Konsekvens vid missad frist ==
    Ansvaret övergår till
    den stat som inte överförde
  end note

  if (Överföring i tid?) then (Ja)
    :Person återförs till
    ansvarig stat;
    :Ansvarig stat prövar/
    slutför prövningen;
  else (Nej)
    :Ansvaret övergår till
    den stat där personen är;
  endif
}

stop

@enduml
