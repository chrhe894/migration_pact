' ============================================================================
' Diagram: Sökandens status och handlingar
'
' Syfte: Visar vilka handlingar sökanden har rätt till vid varje punkt
'        och vilken status personen har i förhållande till systemet.
'
' Källa: APR artiklarna 27, 28, 29; Screeningförordningen art. 6
'
' Status: Draft
' ============================================================================

@startuml applicant-status-and-documents

title Sökandens status och handlingar

skinparam shadowing false
skinparam defaultFontName Arial
skinparam note {
  BackgroundColor #FFF7D6
  BorderColor #7A6A2A
}

start

partition "Före ansökan" {
  :Tredjelandsmedborgare utan status;
  note right
    **Handlingar:** Inga
    **Rättigheter:** Grundläggande
    mänskliga rättigheter,
    non-refoulement
  end note
}

partition "Under screening" {
  :Person som genomgår screening;
  note right
    **Handlingar:** Inga
    **Status:** Ingen inresa tillåts (art. 6)
    **Rättigheter:** Information,
    tolk, hälsokontroll,
    levnadsstandard (art. 8.8)
  end note
}

partition "Ansökan gjord (made)" {
  :Tredjelandsmedborgare som
  uttryckt önskan om skydd;
  note right
    **Handlingar:** Inga ännu
    **Status:** Skyddad mot avlägsnande
    **Rättigheter:** Non-refoulement,
    rätt till registrering inom 5 dagar
  end note
}

partition "Ansökan registrerad" {
  :Sökande (formell status);
  note right
    **Handlingar:**
    Registreringshandling (art. 29.1)
    — namn, registreringsdatum
    **Status:** Sökande
    **Rättigheter:** Rätt att stanna,
    mottagningsvillkor, information
  end note
}

partition "Ansökan inlämnad (lodged)" {
  :Sökande med fullständig status;
  note right
    **Handlingar:**
    Sökandehandling (art. 29.4)
    — foto, status, rörelsefrihet,
    giltig 12 månader
    **Status:** Sökande
    **Rättigheter:** Alla rättigheter
    enligt APR och mottagningsdirektivet,
    prövning inleds
  end note
}

partition "Beslut" {
  if (Utfall?) then (Beviljat)
    :Person med internationellt skydd;
    note right
      **Handlingar:** Uppehållstillstånd
      **Status:** Flykting eller subsidiärt
      skyddsbehövande
    end note
  else (Avslag)
    :Person utan rätt att stanna;
    note right
      **Handlingar:** Återvändandebeslut
      **Status:** Skyldighet att lämna
    end note
  endif
}

stop

@enduml
